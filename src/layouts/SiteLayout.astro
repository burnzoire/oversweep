---
import BrandMark from "../components/BrandMark.astro";
import { manualSubjects } from "../data/catalogue";
import { sectionHasContent, subjectEntries } from "../data/availability";
import { assetPath, sitePath } from "../lib/paths";
import { clip, defaultDescription, describeRoute, entryForRoute, routeOf, siteName } from "../lib/seo";
import "../styles/global.css";

interface Breadcrumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  activeSection: "manual" | "encyclopedia" | "training" | "home";
  activeSubject?: string;
  compactSubjectNav?: boolean;
  isSectionIndex?: boolean;
  isHomePage?: boolean;
  breadcrumbs?: Breadcrumb[];
  // A destination with nothing published: navigation never links to it.
  empty?: boolean;
  // Pages that render their own <h1>, such as the home page hero.
  customHeading?: boolean;
  description?: string;
  // A file under public/ to show when the page is shared, such as a record's
  // lead photo; the site's default share card otherwise.
  image?: string;
  imageAlt?: string;
}

const {
  title,
  activeSection,
  activeSubject,
  compactSubjectNav = false,
  isSectionIndex = false,
  isHomePage = false,
  breadcrumbs = [],
  empty = false,
  customHeading = false,
  description: givenDescription,
  image,
  imageAlt,
} = Astro.props;
const route = routeOf(Astro.url.pathname, import.meta.env.BASE_URL);
const isNotFound = Astro.url.pathname.replace(/\/+$/, "").endsWith("/404");
const description = clip(givenDescription ?? describeRoute(route) ?? defaultDescription);
// Absolute URLs need the site origin, which the Pages build passes with --site.
const site = Astro.site;
const absolute = (path: string) => (site ? new URL(path, site).href : undefined);
const canonical = isNotFound ? undefined : absolute(sitePath(route));
const shareImage = absolute(assetPath(image ?? "og-default.png"));
const shareImageAlt = image ? (imageAlt ?? title) : "Oversweep, the interactive flight reference";
const entry = entryForRoute(route);
const structuredData = site && !empty && !isNotFound
  ? [
      isHomePage && {
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: siteName,
        url: absolute(sitePath()),
        description,
      },
      breadcrumbs.length > 1 && {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        itemListElement: breadcrumbs.map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: crumb.label,
          ...(index === breadcrumbs.length - 1 ? { item: canonical } : crumb.href ? { item: absolute(crumb.href) } : {}),
        })),
      },
      entry && {
        "@context": "https://schema.org",
        "@type": "LearningResource",
        name: entry.title,
        description: entry.objective,
        url: canonical,
        learningResourceType: "Module",
        inLanguage: "en",
        isAccessibleForFree: true,
        isPartOf: { "@type": "WebSite", name: siteName, url: absolute(sitePath()) },
      },
    ].filter(Boolean)
  : [];
const sections = [
  { id: "manual", label: "Manual", path: "manual/", available: sectionHasContent.manual },
  { id: "encyclopedia", label: "Encyclopedia", path: "encyclopedia/", available: sectionHasContent.encyclopedia },
  { id: "training", label: "Training Library", path: "training/", available: sectionHasContent.training },
] as const;
const pageTitle = isHomePage ? `Oversweep · ${title}` : `${title} | Oversweep`;
const subjects = manualSubjects.map((subject) => ({ ...subject, count: subjectEntries(subject.slug).length }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111a24" />
    {empty && <meta name="robots" content="noindex" />}
    <link rel="icon" href={assetPath("favicon.svg")} type="image/svg+xml" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={isHomePage ? "website" : "article"} />
    <meta property="og:title" content={isHomePage ? `${siteName} · ${title}` : title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:alt" content={shareImageAlt} />}
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    {structuredData.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a
          class="brand"
          href={sitePath()}
          aria-label="Oversweep home"
          aria-current={isHomePage ? "page" : undefined}
        >
          <BrandMark />
          <span class="brand-text">
            <span class="brand-name">OVERSWEEP</span>
            <span class="brand-tagline">The Interactive Flight Reference</span>
          </span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          {sections.map((section) => {
            const current = activeSection === section.id;
            const ariaCurrent = current && isSectionIndex ? "page" : undefined;
            return section.available ? (
              <a
                href={sitePath(section.path)}
                class:list={["primary-link", { current }]}
                aria-current={ariaCurrent}
              >
                {section.label}
              </a>
            ) : (
              <a
                class:list={["primary-link", "unavailable", { current }]}
                aria-disabled="true"
                aria-current={ariaCurrent}
                title="Nothing published yet"
              >
                {section.label}<span class="visually-hidden"> (nothing published yet)</span>
              </a>
            );
          })}
        </nav>
      </div>
    </header>
    <main id="main-content" class="page-shell" data-empty={empty ? "" : undefined}>
      {breadcrumbs.length > 1 && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            {breadcrumbs.map((crumb, index) => (
              <li>
                {crumb.href && index < breadcrumbs.length - 1
                  ? <a href={crumb.href}>{crumb.label}</a>
                  : <span aria-current={index === breadcrumbs.length - 1 ? "page" : undefined}>{crumb.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      {!customHeading && (
        <header class="page-heading">
          <h1>{title}</h1>
        </header>
      )}
      <div class:list={["page-layout", { "with-subject-nav": activeSection === "manual" }]}>
        {activeSection === "manual" && (
          <aside class="subject-nav" aria-label="Manual subjects">
            <details open={!compactSubjectNav}>
              <summary>Manual subjects</summary>
              <nav aria-label="Manual subject navigation">
                <ul>
                  {subjects.map((subject) => {
                    const current = activeSubject === subject.slug;
                    return (
                      <li>
                        {subject.count > 0 ? (
                          <a
                            href={sitePath(`manual/${subject.slug}/`)}
                            class:list={{ current }}
                            aria-current={current ? "page" : undefined}
                          >
                            <span>{subject.title}</span>
                            <span class="count" aria-label={`${subject.count} ${subject.count === 1 ? "module" : "modules"}`}>{subject.count}</span>
                          </a>
                        ) : (
                          <a
                            class:list={["unavailable", { current }]}
                            aria-disabled="true"
                            aria-current={current ? "page" : undefined}
                          >
                            {subject.title}<span class="visually-hidden"> (nothing published yet)</span>
                          </a>
                        )}
                      </li>
                    );
                  })}
                </ul>
              </nav>
            </details>
          </aside>
        )}
        <article class="page-content">
          <slot />
        </article>
      </div>
    </main>
    <footer class="site-footer">
      <div class="footer-inner">
        <a class="footer-brand" href={sitePath()}><BrandMark />Oversweep</a>
        <p>Educational reference for simulator pilots. Every module shows its review status. Not approved operational guidance.</p>
      </div>
    </footer>
  </body>
</html>
