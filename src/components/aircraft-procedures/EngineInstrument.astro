---
import engineArt from "../../assets/aircraft-procedures/f16-engine.webp";
---
<figure class="engine-figure">
  <div class="engine-art">
    <img src={engineArt.src} width={engineArt.width} height={engineArt.height} alt="Oil pressure, nozzle position, RPM and FTIT gauges" />
    <svg viewBox="0 0 767 2050" aria-hidden="true">
      <g data-needle="oil" data-pivot="195 216" transform="translate(195 216) rotate(120)"><path d="M-9 18 L-11 -28 L-5 -82 L0 -112 L5 -82 L11 -28 L9 18 Z" fill="#242424"/><circle r="9" fill="#f5f5f5" stroke="#242424" stroke-width="3"/><circle r="3" fill="#242424"/></g>
      <g data-needle="noz" data-pivot="265 608" transform="translate(265 608) rotate(65)"><path d="M-9 18 L-11 -28 L-5 -134 L0 -164 L5 -134 L11 -28 L9 18 Z" fill="#242424"/><circle r="9" fill="#f5f5f5" stroke="#242424" stroke-width="3"/><circle r="3" fill="#242424"/></g>
      <g data-needle="rpm" data-pivot="301 1128" transform="translate(301 1128) rotate(0)"><path d="M-9 18 L-11 -28 L-5 -175 L0 -205 L5 -175 L11 -28 L9 18 Z" fill="#242424"/><circle r="9" fill="#f5f5f5" stroke="#242424" stroke-width="3"/><circle r="3" fill="#242424"/></g>
      <g data-needle="ftit" data-pivot="409 1708" transform="translate(409 1708) rotate(117)"><path d="M-9 18 L-11 -28 L-5 -192 L0 -222 L5 -192 L11 -28 L9 18 Z" fill="#242424"/><circle r="9" fill="#f5f5f5" stroke="#242424" stroke-width="3"/><circle r="3" fill="#242424"/></g>
    </svg>
  </div>
  <figcaption>
    <span class="engine-readouts">Procedure example: RPM <strong data-value="rpm">0</strong>%; FTIT <strong data-value="ftit">—</strong> °C. <span data-signal>ENGINE OFF</span></span>
  </figcaption>
</figure>
<style>
.engine-figure{margin:0;max-width:28rem}
.engine-figure svg{width:100%;height:auto;display:block}
.engine-figure figcaption{display:grid;gap:.35rem;font-size:.8rem;color:var(--color-muted);margin-top:.4rem}
.engine-figure .engine-readouts{color:var(--color-text)}
.engine-art{position:relative}
.engine-art img{width:100%;height:auto;display:block}
.engine-art svg{position:absolute;inset:0;pointer-events:none}
</style>