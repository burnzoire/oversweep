---
import engineArt from "../../assets/aircraft-procedures/f16-engine.webp";
---
<figure class="engine-figure">
  <div class="engine-art">
    <img src={engineArt.src} width={engineArt.width} height={engineArt.height} alt="Oil pressure, nozzle position, RPM and FTIT gauges" />
    <svg viewBox="0 0 724 2172" aria-hidden="true">
      <g data-needle="oil" data-pivot="272 240" transform="translate(272 240) rotate(-140)"><path d="M-11 16 L-14 -30 L-7 -93 L0 -125 L7 -93 L14 -30 L11 16 Z" fill="#242424"/><circle r="9" fill="#f5f5f5" stroke="#242424" stroke-width="3"/><circle r="3" fill="#242424"/></g>
      <g data-needle="noz" data-pivot="348 698" transform="translate(348 698) rotate(-140)"><path d="M-11 16 L-14 -30 L-7 -148 L0 -180 L7 -148 L14 -30 L11 16 Z" fill="#242424"/><circle r="9" fill="#f5f5f5" stroke="#242424" stroke-width="3"/><circle r="3" fill="#242424"/></g>
      <g data-needle="rpm" data-pivot="359 1269" transform="translate(359 1269) rotate(0)"><path d="M-11 16 L-14 -30 L-7 -193 L0 -225 L7 -193 L14 -30 L11 16 Z" fill="#242424"/><circle r="9" fill="#f5f5f5" stroke="#242424" stroke-width="3"/><circle r="3" fill="#242424"/></g>
      <g data-needle="ftit" data-pivot="356 1860" transform="translate(356 1860) rotate(-140)"><path d="M-11 16 L-14 -30 L-7 -186 L0 -218 L7 -186 L14 -30 L11 16 Z" fill="#242424"/><circle r="9" fill="#f5f5f5" stroke="#242424" stroke-width="3"/><circle r="3" fill="#242424"/></g>
    </svg>
  </div>
  <figcaption>
    <span class="engine-readouts">Procedure example: RPM <strong data-value="rpm">0</strong>%; FTIT <strong data-value="ftit">—</strong> °C. <span data-signal>ENGINE OFF</span></span>
    <span class="source-note">Illustrative instrument indications. Gauge markings and motion await in-simulator verification.</span>
  </figcaption>
</figure>
<style>
.engine-figure{margin:0;max-width:28rem}
.engine-figure svg{width:100%;height:auto;display:block}
.engine-figure figcaption{display:grid;gap:.35rem;font-size:.8rem;color:var(--color-muted);margin-top:.4rem}
.engine-figure .engine-readouts{color:var(--color-text)}
.engine-art{position:relative}
.engine-art img{width:100%;height:auto;display:block}
.engine-art svg{position:absolute;inset:0;pointer-events:none}
</style>