---
/**
 * Reference-informed engine instrument stack for DCS F-16C.
 * Four DIFFERENT gauge diameters and staggered centres follow the DCS cockpit
 * photo (Hoggit F-16C engine instruments), rather than a made-up straight stack.
 * Geometry is still a review draft, not a dimensionally certified technical plan.
 */
const dials = [
  { id:'oil', title:'OIL', unit:'PSI', cx:210, cy:151, radius:45, values:[0,20,40,60,80,100], angle:-68 },
  { id:'noz', title:'NOZ POS', unit:'% OPEN', cx:226, cy:313, radius:55, values:[0,20,40,60,80,100], angle:116 },
  { id:'rpm', title:'RPM', unit:'PERCENT', cx:245, cy:508, radius:69, values:[0,20,40,60,80,100], angle:-125 },
  { id:'ftit', title:'FTIT', unit:'×100 °C', cx:310, cy:723, radius:69, values:[2,4,6,8,10,12], angle:-125 },
];
const sweepStart = -125, sweep = 250;
const point = (g: typeof dials[number], n:number, r:number) => {
  const a=(sweepStart+n*sweep/10)*Math.PI/180;
  return {x:g.cx+Math.sin(a)*r, y:g.cy-Math.cos(a)*r};
};
---
<figure class="engine-figure">
  <svg viewBox="0 0 520 860" role="img" aria-label="F-16C engine instrument panel: smaller oil and nozzle gauges, followed by larger RPM and FTIT gauges offset toward the right">
    <title>F-16C · Engine Instruments</title>
    <path class="panel-outline" d="M131 58 Q131 40 146 40 L291 33 L331 73 L352 76 L377 325 L378 447 L432 551 L467 788 L451 825 L141 822 L121 795 L120 83 Z"/>
    <path class="seam" d="M153 70 L296 65 L342 102 L359 342 L364 452 L416 557 L445 786 L434 802 L154 802 L145 79Z"/>
    {dials.map((g,i)=><g class="gauge">
      <circle cx={g.cx} cy={g.cy} r={g.radius} class="bezel"/>
      <circle cx={g.cx} cy={g.cy} r={g.radius-5} class="bezel-inner"/>
      <circle cx={g.cx} cy={g.cy} r={g.radius-9} class="face"/>
      {Array.from({length:11},(_,n)=>{
        const a=point(g,n,g.radius-11);
        const b=point(g,n,g.radius-17);
        return <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} class="tick"/>;
      })}
      {g.values.map((n,k)=>{
        const a=point(g,k*2,g.radius-26);
        return <text x={a.x} y={a.y+3} class="tick-label" text-anchor="middle">{n}</text>;
      })}
      <text x={g.cx} y={g.cy+18} class="gauge-title">{g.title}</text>
      <text x={g.cx} y={g.cy+29} class="gauge-unit">{g.unit}</text>
      <line data-needle={g.id} x1={g.cx} y1={g.cy} x2={g.cx} y2={g.cy-(g.radius-23)}
        class="needle" transform={`rotate(${g.angle} ${g.cx} ${g.cy})`}/>
      <circle cx={g.cx} cy={g.cy} r="4.5" class="hub"/>
    </g>)}
    {[
      [142,81],[328,80],[166,267],[331,267],[171,416],
      [370,417],[181,623],[421,647],[161,800],[432,798]
    ].map(([x,y])=><g class="mount" transform={`translate(${x} ${y})`}>
      <circle r="6.5"/><path d="M-4.5 -4.5 L4.5 4.5"/>
    </g>)}
  </svg>
  <figcaption>
    <span class="engine-readouts">Procedure example: RPM <strong data-value="rpm">0</strong>%; FTIT <strong data-value="ftit">—</strong> °C. <span data-signal>ENGINE OFF</span></span>
    <span class="source-note">Four staggered instrument faces, independently drawn using the DCS engine-instruments photograph as a reference. Fastener and scale coordinates remain unverified; neither the values nor motion are simulator telemetry.</span>
  </figcaption>
</figure>
<style>
.engine-figure{margin:0;max-width:28rem}
.engine-figure svg{width:100%;height:auto;display:block}
.engine-figure .panel-outline{stroke:#171717;stroke-width:2;fill:#fff}
.engine-figure .seam{stroke:#999;stroke-width:.8;fill:none}
.engine-figure .bezel{fill:#fff;stroke:#222;stroke-width:3}
.engine-figure .bezel-inner{fill:none;stroke:#666;stroke-width:1.4}
.engine-figure .face{fill:white;stroke:#444;stroke-width:1.3}
.engine-figure .tick{stroke:#111;stroke-width:1.5}
.engine-figure .tick-label{font:8px ui-monospace,monospace;fill:#111}
.engine-figure .gauge-title{font:700 10px system-ui,sans-serif;text-anchor:middle;fill:#111}
.engine-figure .gauge-unit{font:8px system-ui,sans-serif;text-anchor:middle;fill:#444}
.engine-figure .needle{stroke:#151515;stroke-width:2.6;stroke-linecap:round}
.engine-figure .hub{fill:#171717}
.engine-figure .mount circle{fill:#f6f6f6;stroke:#333;stroke-width:1.5}
.engine-figure .mount path{stroke:#333;stroke-width:1.5}
.engine-figure figcaption{display:grid;gap:.35rem;font-size:.8rem;color:var(--color-muted);margin-top:.4rem}
.engine-figure .engine-readouts{color:var(--color-text)}
</style>