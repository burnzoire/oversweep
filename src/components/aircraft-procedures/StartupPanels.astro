---
import eyebrowArt from "../../assets/aircraft-procedures/f16-eyebrow.webp";
import cautionArt from "../../assets/aircraft-procedures/f16-caution.webp";
import jfsArt from "../../assets/aircraft-procedures/f16-jfs.webp";
import testArt from "../../assets/aircraft-procedures/f16-test.webp";
import CockpitPanel from "../cockpit-panels/CockpitPanel.astro";
import { f16cElec } from "../../data/cockpit-panels/f16c-elec";
import brakeArt from "../../assets/aircraft-procedures/f16-brake.webp";
import canopyArt from "../../assets/aircraft-procedures/f16-canopy.webp";
import fuelArt from "../../assets/aircraft-procedures/f16-fuel-feed.webp";
import airArt from "../../assets/aircraft-procedures/f16-air-source.webp";

type PanelInput = [id: string, label: string];
type PanelControl = {
  id: string;
  kind: 'toggle' | 'rotary' | 'button' | 'slider';
  label: string;
  anchor: [x: number, y: number, width: number];
  inputs: PanelInput[];
  position?: 'up' | 'centre' | 'down' | 'off';
  angles?: [initial: number, norm: number];
  face?: 'paddle' | 'square' | 'triple' | 'recessed';
  primary?: boolean;
};

const parkingBrake: PanelControl[] = [
  {id:'parking-brake', kind:'toggle', label:'Parking brake and anti-skid', anchor:[55.3,56.7,16], position:'centre', primary:true,
    inputs:[['parking-brake-up','Select PARKING BRAKE'],['parking-brake-down','Move parking brake switch down']]},
  {id:'emergency-stores', kind:'button', label:'Emergency stores jettison', anchor:[32.1,27.2,17],
    inputs:[['emergency-stores','EMER STORES JETTISON']]},
  {id:'hook', kind:'toggle', label:'Hook', anchor:[84.3,23.8,13], position:'up', face:'paddle',
    inputs:[['hook-up','Select HOOK UP'],['hook-down','Select HOOK DN']]},
  {id:'ground-jettison', kind:'toggle', label:'Ground jettison enable', anchor:[17.7,56.3,12], position:'down',
    inputs:[['ground-jettison-up','Select GND JETT ENABLE'],['ground-jettison-down','Select GND JETT OFF']]},
  {id:'brakes-channel', kind:'toggle', label:'Brakes channel', anchor:[35.6,56.3,12], position:'up',
    inputs:[['brakes-channel-up','Select BRAKES CHAN 1'],['brakes-channel-down','Select BRAKES CHAN 2']]},
  {id:'stores-config', kind:'toggle', label:'Stores configuration', anchor:[14.6,85.5,12], position:'up',
    inputs:[['stores-config-up','Select CAT I'],['stores-config-down','Select CAT III']]},
  {id:'horn-silencer', kind:'button', label:'Horn silencer', anchor:[32.5,85.9,9],
    inputs:[['horn-silencer','HORN SILENCER']]},
  {id:'landing-lights', kind:'toggle', label:'Landing and taxi lights', anchor:[55.1,84.8,13], position:'centre', face:'triple',
    inputs:[['landing-lights-up','Move LIGHTS switch up'],['landing-lights-down','Move LIGHTS switch down']]},
  {id:'landing-gear', kind:'slider', label:'Landing gear handle', anchor:[85.2,61.0,16], position:'down',
    inputs:[['landing-gear-up','Move landing gear handle to UP'],['landing-gear-down','Move landing gear handle to DN']]},
  {id:'down-lock-release', kind:'button', label:'Down lock release', anchor:[84.0,83.8,9], face:'recessed',
    inputs:[['down-lock-release','DN LOCK REL']]},
];

const canopyControls: PanelControl[] = [
  {id:'canopy', kind:'toggle', label:'Canopy switch', anchor:[70.1,40.9,20], position:'centre', primary:true,
    inputs:[['canopy-up','Raise canopy'],['canopy-down','Hold canopy switch down']]},
];

const fuelControls: PanelControl[] = [
  {id:'fuel-feed', kind:'rotary', label:'Engine feed', anchor:[55,55.6,12.7], angles:[-125,-58], position:'off', primary:true,
    inputs:[['fuel-feed-ccw','Turn ENG FEED anticlockwise'],['fuel-feed-cw','Turn ENG FEED clockwise']]},
  {id:'fuel-master', kind:'toggle', label:'Fuel master', anchor:[16.1,55.6,10], position:'up', face:'paddle',
    inputs:[['fuel-master-up','Move FUEL MASTER up'],['fuel-master-down','Move FUEL MASTER down']]},
  {id:'tank-inerting', kind:'toggle', label:'Tank inerting', anchor:[33.5,61.9,9], position:'down',
    inputs:[['tank-inerting-up','Select TANK INERTING'],['tank-inerting-down','Select TANK INERTING OFF']]},
  {id:'air-refuel', kind:'toggle', label:'Air refuel', anchor:[79.3,61.7,10], position:'down', face:'square',
    inputs:[['air-refuel-up','Select AIR REFUEL OPEN'],['air-refuel-down','Select AIR REFUEL CLOSE']]},
];

const airControls: PanelControl[] = [
  {id:'air-source', kind:'rotary', label:'Air source', anchor:[49.8,31.9,36], angles:[-135,-45], position:'off', primary:true,
    inputs:[['air-source-ccw','Turn AIR SOURCE anticlockwise'],['air-source-cw','Turn AIR SOURCE clockwise']]},
  {id:'air-temp', kind:'rotary', label:'Temperature', anchor:[49.8,73.3,36], angles:[0,0],
    inputs:[['air-temp-ccw','Turn TEMP toward COOL'],['air-temp-cw','Turn TEMP toward WARM']]},
];

const preStartPanels = [
  {id:'parking-brake', art:brakeArt, label:'F-16C landing gear panel', controls:parkingBrake},
  {id:'canopy', art:canopyArt, label:'F-16C canopy switch and handle mounting assembly', controls:canopyControls},
  {id:'fuel-feed', art:fuelArt, label:'F-16C FUEL panel', controls:fuelControls},
  {id:'air-source', art:airArt, label:'F-16C AIR COND panel', controls:airControls},
];
const cues = {toggle:['↑','↓'], slider:['↑','↓'], rotary:['↶','↷'], button:[]};
// Raster line artwork referenced to the Eagle Dynamics F-16C guide (pp. 46, 59, 63, 64, 72).
---
<div class="startup-panels" data-startup-panels>

  <div class="startup-panel" data-panel="elec">
<CockpitPanel spec={f16cElec} class="elec-art" />
  </div>
  <div class="startup-panel" data-panel="test" hidden>
    <div class="raster-panel raster-test" style={`--art-ratio:${testArt.width / testArt.height}`}>
      <img src={testArt.src} width={testArt.width} height={testArt.height} alt="FLCS TEST panel" />
      <span class="raster-lamp" data-flcs-channel="C" style="--x:68%;--y:38.6%;--w:9.5%;--h:6.7%" aria-hidden="true"></span>
      <span class="raster-lamp" data-flcs-channel="A" style="--x:78.2%;--y:38.6%;--w:9.5%;--h:6.7%" aria-hidden="true"></span>
      <span class="raster-lamp" data-flcs-channel="D" style="--x:68%;--y:45.6%;--w:9.5%;--h:7.2%" aria-hidden="true"></span>
      <span class="raster-lamp" data-flcs-channel="B" style="--x:78.2%;--y:45.6%;--w:9.5%;--h:7.2%" aria-hidden="true"></span>
      <div class="raster-switch flcs-toggle" data-flcs-lever data-position="norm" role="group" aria-label="FLCS PWR TEST">
        <svg viewBox="0 0 100 100" aria-hidden="true">
<circle cx="50" cy="50" r="25" fill="#fff" stroke="#171717" stroke-width="1.5"/>
<path class="shaft" d="M38 55C37 48 42 43 50 43C58 43 63 48 62 55L64 83Q64 91 50 91Q36 91 36 83Z" fill="#fff" stroke="#171717" stroke-width="2"/>
<g class="cap"><circle cx="50" cy="50" r="16" fill="#fff" stroke="#171717" stroke-width="2"/><circle cx="50" cy="50" r="12" fill="none" stroke="#171717"/></g>
</svg>
        <button type="button" data-control="flcs-test" aria-label="Select TEST"><span class="toggle-cue" aria-hidden="true">↑</span></button>
        <button type="button" data-control="flcs-norm" aria-label="Return to NORM"><span class="toggle-cue" aria-hidden="true">↓</span></button>
      </div>
      <button class="panel-hotspot" type="button" style="--x:23%;--y:20%" data-control="fire-test" aria-label="FIRE & OHEAT DETECT"></button>
      <div class="raster-switch fixed-toggle" role="group" aria-label="OBOGS TEST" style="--x:51.7%;--y:19.6%;--w:15%;--h:10%">
        <svg class="parked-toggle" viewBox="0 0 100 100" aria-hidden="true">
          <path d="M39 51Q39 42 50 42Q61 42 61 51L64 79H36Z" fill="white" stroke="#171717" stroke-width="3" />
          <circle cx="50" cy="79" r="14" fill="white" stroke="#171717" stroke-width="3" />
        </svg>
        <button type="button" data-control="obogs-test-up" aria-label="Select BIT"><span class="toggle-cue" aria-hidden="true">↑</span></button>
        <button type="button" data-control="obogs-test-down" aria-label="Select OFF"><span class="toggle-cue" aria-hidden="true">↓</span></button>
      </div>
      <button class="panel-hotspot" type="button" style="--x:80%;--y:20%" data-control="mal-test" aria-label="MAL & IND LTS"></button>
      <div class="raster-switch fixed-toggle" role="group" aria-label="PROBE HEAT" style="--x:21%;--y:48.3%;--w:15%;--h:10%">
        <button type="button" data-control="probe-heat-up" aria-label="Select PROBE HEAT"><span class="toggle-cue" aria-hidden="true">↑</span></button>
        <button type="button" data-control="probe-heat-down" aria-label="Select TEST"><span class="toggle-cue" aria-hidden="true">↓</span></button>
      </div>
      <div class="raster-switch fixed-toggle" role="group" aria-label="EPU GEN" style="--x:50.4%;--y:48%;--w:15%;--h:10%">
        <svg class="parked-toggle" viewBox="0 0 100 100" aria-hidden="true">
          <path d="M39 51Q39 42 50 42Q61 42 61 51L64 79H36Z" fill="white" stroke="#171717" stroke-width="3" />
          <circle cx="50" cy="79" r="14" fill="white" stroke="#171717" stroke-width="3" />
        </svg>
        <button type="button" data-control="epu-gen-up" aria-label="Select EPU/GEN"><span class="toggle-cue" aria-hidden="true">↑</span></button>
        <button type="button" data-control="epu-gen-down" aria-label="Select OFF"><span class="toggle-cue" aria-hidden="true">↓</span></button>
      </div>
    </div>
  </div>
  <div class="startup-panel" data-panel="jfs" hidden>
    <div class="raster-panel raster-jfs" style={`--art-ratio:${jfsArt.width / jfsArt.height}`}>
      <img src={jfsArt.src} width={jfsArt.width} height={jfsArt.height} alt="ENG and JET START panel" />
      <span class="raster-lamp" data-lamp="jfs-run" style="--x:26.1%;--y:12%;--w:10.2%;--h:4.7%" aria-hidden="true"></span>
      <div class="raster-switch flcs-toggle jfs-toggle" role="group" aria-label="JFS switch" style="--x:63.4%;--y:14.37%">
        <svg data-jfs-lever data-position="off" viewBox="0 0 100 100" aria-hidden="true">
<circle cx="50" cy="50" r="25" fill="#fff" stroke="#171717" stroke-width="1.5"/>
<path class="shaft" d="M38 55C37 48 42 43 50 43C58 43 63 48 62 55L64 83Q64 91 50 91Q36 91 36 83Z" fill="#fff" stroke="#171717" stroke-width="2"/>
<g class="cap"><circle cx="50" cy="50" r="16" fill="#fff" stroke="#171717" stroke-width="2"/><circle cx="50" cy="50" r="12" fill="none" stroke="#171717"/></g>
</svg>
        <button type="button" data-control="jfs-start1" aria-label="Select JFS START 1"><span class="toggle-cue" aria-hidden="true">↑</span></button>
        <button type="button" data-control="jfs-start2" aria-label="Select JFS START 2"><span class="toggle-cue" aria-hidden="true">↓</span></button>
      </div>
      <div class="raster-switch fixed-toggle" role="group" aria-label="ENG CONT" style="--x:49.5%;--y:38.85%;--w:25%;--h:15.5%">
        <button type="button" data-control="eng-cont-up" aria-label="Select PRI"><span class="toggle-cue" aria-hidden="true">↑</span></button>
        <button type="button" data-control="eng-cont-down" aria-label="Select SEC"><span class="toggle-cue" aria-hidden="true">↓</span></button>
      </div>
      <div class="raster-switch fixed-toggle" role="group" aria-label="AB RESET" style="--x:49.5%;--y:61.9%;--w:23%;--h:7.5%">
        <svg class="ab-reset-face" viewBox="0 0 176 124" aria-hidden="true">
          <rect width="176" height="124" fill="white" />
          <g transform="translate(78 62)" fill="white" stroke="#171717" stroke-width="4">
            <path d="M-23-53H23L53-23V23L23 53H-23L-53 23V-23Z" />
            <circle r="46" /><circle r="36" /><circle r="29" /><circle r="22" />
          </g>
        </svg>
        <button type="button" data-control="ab-reset-up" aria-label="Select AB RESET"><span class="toggle-cue" aria-hidden="true">↑</span></button>
        <button type="button" data-control="ab-reset-down" aria-label="Select ENG DATA"><span class="toggle-cue" aria-hidden="true">↓</span></button>
      </div>
      <div class="raster-switch fixed-toggle" role="group" aria-label="MAX POWER" style="--x:49.5%;--y:87%;--w:18%;--h:10%">
        <button type="button" data-control="max-power-up" aria-label="Select MAX POWER"><span class="toggle-cue" aria-hidden="true">↑</span></button>
        <button type="button" data-control="max-power-down" aria-label="Select OFF"><span class="toggle-cue" aria-hidden="true">↓</span></button>
      </div>
    </div>
  </div>

  {preStartPanels.map(({id, art, label, controls}) => (
    <div class="startup-panel prestart-panel" data-panel={id} hidden>
      <div class="raster-panel prestart-art" style={`--art-ratio:${art.width / art.height}`}>
        <img src={art.src} width={art.width} height={art.height} alt={label} />
        {controls.map(({id, kind, label, anchor:[x,y,width], position, angles, inputs, face, primary}) => (
          <div class:list={['prestart-control', `prestart-${kind}`, {'rotary-control':kind==='rotary', 'raster-switch':kind==='toggle'||kind==='slider', primary}]}
            data-prestart-position={id} data-position={position}
            style={`--x:${x}%;--y:${y}%;--control-width:${width}%;--initial-angle:${angles?.[0] ?? 0}deg;--norm-angle:${angles?.[1] ?? 0}deg`}
            role="group" aria-label={label}>
            {kind === 'rotary' && (
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <g class="selector-knob" stroke="#171717" stroke-width="2.4" stroke-linejoin="round">
                  <circle cx="50" cy="50" r="32" fill="white" />
                  <circle cx="50" cy="50" r="27" fill="none" stroke-width="1" stroke-dasharray="2 3" />
                  <path d="M33 27L38 20H62L67 27L69 68L62 76H38L31 68Z" fill="white" />
                  <path d="M50 22V37" fill="none" />
                </g>
              </svg>
            )}
            {kind === 'toggle' && (
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <path class="shaft" d="M39 51Q39 43 50 43Q61 43 61 51L64 78H36Z" fill="white" stroke="#171717" stroke-width="3" />
                <g class="cap" fill="white" stroke="#171717" stroke-width="2.5">
                  {face === 'paddle' && <path d="M33 33H67V55A17 17 0 0 1 33 55Z" />}
                  {face === 'square' && <path d="M34 35H66V65H34Z M38 39H62V61H38Z" />}
                  {face === 'triple' && <>
                    <rect x="17" y="37" width="66" height="26" rx="12" />
                    <circle cx="29" cy="50" r="7" /><circle cx="50" cy="50" r="7" /><circle cx="71" cy="50" r="7" />
                  </>}
                  {!face && <>
                    <circle cx="50" cy="50" r="15" />
                    <circle cx="50" cy="50" r="10" fill="none" stroke-width="1.2" />
                  </>}
                </g>
              </svg>
            )}
            {kind === 'slider' && (
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <g class="gear-grip" stroke="#171717" stroke-width="2.5">
                  <path d="M31 50H64V71H31Z" fill="#e6e6e6" />
                  <path d="M24 24H58Q71 24 71 38V56Q71 64 63 64H24Z" fill="white" />
                  <path d="M29 27V60M34 27V60M39 27V60M44 27V60M49 27V60" fill="none" stroke-width="1.4" />
                  <rect x="64" y="37" width="11" height="12" rx="3" fill="white" />
                </g>
              </svg>
            )}
            {kind === 'button' && (
              <svg viewBox="0 0 100 100" aria-hidden="true">
                <circle cx="50" cy="50" r="33" fill={face === 'recessed' ? '#202020' : 'white'} stroke="#171717" stroke-width="2.5" />
                <circle cx="50" cy="50" r="28" fill="none" stroke={face === 'recessed' ? '#8a8a8a' : '#171717'} stroke-width="1.5" />
              </svg>
            )}
            {inputs.map(([value, name], index) => (
              <button type="button" data-control={value} aria-label={name} disabled={id === 'fuel-master'}>
                {cues[kind][index] && <span class="toggle-cue" aria-hidden="true">{cues[kind][index]}</span>}
              </button>
            ))}
          </div>
        ))}
        {id === 'fuel-feed' && (
          <button type="button" class="fuel-master-guard" data-control="fuel-master-guard" aria-label="FUEL MASTER switch guard">
            <svg viewBox="0 0 70 90" aria-hidden="true">
              <path d="M7 7H22V25Q22 34 29 34H41Q48 34 48 25V7H63V81H7Z" fill="white" stroke="#171717" stroke-width="3" />
              <path d="M11 68H59M11 74H59" fill="none" stroke="#171717" stroke-width="1.5" />
            </svg>
          </button>
        )}
        {id === 'canopy' && (
          <button type="button" class="canopy-guard" data-control="canopy-lock" aria-label="Close canopy handle" aria-pressed="false">
            <svg viewBox="0 0 200 100" aria-hidden="true">
              <g fill="white" stroke="#171717" stroke-width="2.5" stroke-linejoin="round">
                <path d="M147 3H183V22H168L162 47L190 72V94H167L145 67L120 52L19 84L9 68L109 38L26 26L29 10L134 21Z" />
                <path d="M147 3H183V15H145Z M18 67L27 81L19 84L9 68Z M166 82H190V94H167Z" />
                <path d="M151 18L148 43L169 69M123 44L29 19" fill="none" stroke-width="1.2" />
                <circle cx="166" cy="8.5" r="3" />
              </g>
            </svg>
          </button>
        )}
      </div>
    </div>
  ))}

  <div class="startup-panel" data-panel="caution" hidden>
    <div class="raster-panel raster-caution" style={`--art-ratio:${cautionArt.width / cautionArt.height}`}>
      <img src={cautionArt.src} width={cautionArt.width} height={cautionArt.height} alt="Caution annunciators" />
      <span class="raster-lamp" data-lamp="warn-elec" style="--x:7.9%;--y:20.3%;--w:19.7%;--h:8%" aria-hidden="true"></span>
      <span class="raster-lamp" data-lamp="warn-sec" style="--x:30%;--y:20.3%;--w:19%;--h:8%" aria-hidden="true"></span>
      <span class="raster-lamp" data-lamp="warn-seat" style="--x:73%;--y:9.7%;--w:19%;--h:8%" aria-hidden="true"></span>
    </div>
  </div>
  <div class="startup-panel" data-panel="eyebrow" hidden>
    <button type="button" class="master-caution" data-control="master-caution" data-lamp="master-caution">MASTER CAUTION</button>
    <div class="raster-panel raster-eyebrow" style={`--art-ratio:${eyebrowArt.width / eyebrowArt.height}`}>
      <img src={eyebrowArt.src} width={eyebrowArt.width} height={eyebrowArt.height} alt="Right eyebrow warning annunciators" />
      <span class="raster-lamp" data-lamp="warn-canopy" style="--x:78%;--y:25%;--w:16%;--h:22%" aria-hidden="true"></span>
      <span class="raster-lamp" data-lamp="warn-engine" style="--x:6.5%;--y:54%;--w:16%;--h:22%" aria-hidden="true"></span>
      <span class="raster-lamp" data-lamp="warn-hyd" style="--x:24.6%;--y:25%;--w:16%;--h:22%" aria-hidden="true"></span>
      <span class="raster-lamp" data-lamp="warn-hyd-bottom" style="--x:24.6%;--y:54%;--w:16%;--h:22%" aria-hidden="true"></span>
    </div>
  </div>
  <div class="panel-feedback" data-panel-feedback aria-live="polite">Use the control named in the current step.</div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.elec-art .switch, .raster-switch:not([data-prestart-position=canopy]), .rotary-control').forEach(toggle => {
    toggle.addEventListener('keydown', event => {
      const rotary = toggle.classList.contains('rotary-control');
      const first = rotary ? 'ArrowLeft' : 'ArrowUp';
      const second = rotary ? 'ArrowRight' : 'ArrowDown';
      if (event.key !== first && event.key !== second) return;
      event.preventDefault();
      if (event.repeat) return;
      const buttons = toggle.querySelectorAll<HTMLButtonElement>('button');
      buttons[event.key === first ? 0 : 1]?.click();
    });
  });
</script>

<style>
.toggle-cue{position:absolute;inset-inline-start:100%;top:50%;transform:translateY(-50%);z-index:2;padding:0 .2em;background:#fff;color:#161616;border:1px solid currentColor;border-radius:.2em;font:600 .7rem/1.25 system-ui;white-space:nowrap;pointer-events:none}
.jfs-toggle .toggle-cue{inset-inline-start:auto;inset-inline-end:100%}
@media(hover:hover){
.toggle-cue{visibility:hidden}
button:hover > .toggle-cue,button:focus-visible > .toggle-cue{visibility:visible}
.switch:has(button:hover) button:not(:hover) > .toggle-cue,
.raster-switch:has(button:hover) button:not(:hover) > .toggle-cue{visibility:hidden}
}
.startup-panel[hidden]{display:none}
.startup-panels svg{display:block;width:100%;max-width:100%;max-height:58rem;height:auto;background:white}
.startup-panels .panel-feedback{font-size:.88rem;font-weight:600;padding:.5rem;border-left:3px solid var(--color-ink);background:var(--color-surface)}
/* SVG lever transforms are instantaneous. Transitioning the SVG line transform caused a visible detached-lever artefact in Chromium. */












:global(.elec-art){max-width:440px;margin:auto}

.raster-panel{position:relative;margin:auto;max-width:440px}
.raster-test,.raster-jfs{max-width:320px}
.raster-panel img{width:100%;height:auto;display:block}
.raster-lamp{position:absolute;left:var(--x);top:var(--y);width:var(--w);height:var(--h);pointer-events:none;border-radius:3px}
.raster-lamp.lit{background:#ffb82c77}
.raster-test .raster-lamp.lit,.raster-jfs .raster-lamp.lit{background:#45b87966}
.raster-switch{position:absolute;left:var(--x);top:var(--y);transform:translate(-50%,-50%);width:22%;aspect-ratio:1;border:0;border-radius:50%;background:transparent;padding:0;cursor:pointer}
.raster-switch svg{display:block;width:100%;height:100%;background:transparent;pointer-events:none}
.raster-switch svg g{transition:transform .16s ease}
@media(prefers-reduced-motion:reduce){.raster-switch svg g{transition:none}}

.flcs-toggle{--x:64.2%;--y:78.2%}
.raster-switch button{position:absolute;left:0;width:100%;height:50%;padding:0;border:0;background:transparent;cursor:pointer}
.raster-switch button:first-of-type{top:0}
.raster-switch button:last-of-type{bottom:0}
.flcs-toggle .shaft{transform-origin:50px 50px;transform:scaleY(0);transition:transform .18s ease-out}
.flcs-toggle .cap{transition:transform .18s ease-out}
.flcs-toggle[data-position="test"] .shaft{transform:scaleY(-1)}
.flcs-toggle[data-position="test"] .cap{transform:translateY(-34px)}
