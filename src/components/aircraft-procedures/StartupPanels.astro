---
import CockpitPanel from "../cockpit-panels/CockpitPanel.astro";
import { f16cElec } from "../../data/cockpit-panels/f16c-elec";
import { f16cTest } from "../../data/cockpit-panels/f16c-test";
import { f16cJfs } from "../../data/cockpit-panels/f16c-jfs";
import { f16cGear } from "../../data/cockpit-panels/f16c-gear";
import { f16cCanopy } from "../../data/cockpit-panels/f16c-canopy";
import { f16cFuel } from "../../data/cockpit-panels/f16c-fuel";
import { f16cAir } from "../../data/cockpit-panels/f16c-air";
import { f16cCaution } from "../../data/cockpit-panels/f16c-caution";
import { f16cEyebrow } from "../../data/cockpit-panels/f16c-eyebrow";

// Every panel is vector art drawn from a data spec traced from the
// Eagle Dynamics DCS F-16C guide (pp. 46, 55, 59, 63, 64, 67, 72, 73, 76).
const preStartPanels = [
  { id: 'parking-brake', spec: f16cGear },
  { id: 'canopy', spec: f16cCanopy },
  { id: 'fuel-feed', spec: f16cFuel },
  { id: 'air-source', spec: f16cAir },
];
---
<div class="startup-panels" data-startup-panels>
  <div class="startup-panel" data-panel="elec">
    <CockpitPanel spec={f16cElec} class="elec-art" />
  </div>
  <div class="startup-panel" data-panel="test" hidden>
    <CockpitPanel spec={f16cTest} class="raster-panel narrow-panel" />
  </div>
  <div class="startup-panel" data-panel="jfs" hidden>
    <CockpitPanel spec={f16cJfs} class="raster-panel narrow-panel" />
  </div>
  {preStartPanels.map(({ id, spec }) => (
    <div class="startup-panel prestart-panel" data-panel={id} hidden>
      <CockpitPanel spec={spec} class="raster-panel prestart-art" />
    </div>
  ))}
  <div class="startup-panel" data-panel="caution" hidden>
    <CockpitPanel spec={f16cCaution} class="raster-panel" />
  </div>
  <div class="startup-panel" data-panel="eyebrow" hidden>
    <button type="button" class="master-caution" data-control="master-caution" data-lamp="master-caution">MASTER CAUTION</button>
    <CockpitPanel spec={f16cEyebrow} class="raster-panel" />
  </div>
  <div class="panel-feedback" data-panel-feedback aria-live="polite">Use the control named in the current step.</div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.elec-art .switch, .raster-switch:not([data-prestart-position=canopy]), .rotary-control').forEach(toggle => {
    toggle.addEventListener('keydown', event => {
      const rotary = toggle.classList.contains('rotary-control');
      const first = rotary ? 'ArrowLeft' : 'ArrowUp';
      const second = rotary ? 'ArrowRight' : 'ArrowDown';
      if (event.key !== first && event.key !== second) return;
      event.preventDefault();
      if (event.repeat) return;
      const buttons = toggle.querySelectorAll<HTMLButtonElement>('button');
      buttons[event.key === first ? 0 : 1]?.click();
    });
  });
</script>

<style>
.startup-panel[hidden]{display:none}
.startup-panels .panel-feedback{font-size:.88rem;font-weight:600;padding:.5rem;border-left:3px solid var(--color-ink);background:var(--color-surface)}
.startup-panels :global(.cockpit-panel){margin:auto;max-width:440px}
.startup-panels :global(.narrow-panel){max-width:320px}
.master-caution{display:block;margin:.5rem auto;padding:.6rem;border:2px solid #343434;border-radius:4px;background:#fff;color:#171717;font-weight:700;cursor:pointer}
.master-caution.lit{background:#ffcf63}
.startup-panels :global([data-control="canopy-down"]){touch-action:none;user-select:none}
.startup-panels :global(.cockpit-panel button){-webkit-tap-highlight-color:transparent}
</style>
