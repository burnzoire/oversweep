---
// Renders text whose "[n]" markers refer to the record's numbered sources as
// links to them, so the output checks can resolve every citation.
interface Props { text?: string }
const parts = (Astro.props.text ?? '').split(/(\[\d+\])/);
---
{parts.map((part) => {
  const n = part.match(/^\[(\d+)\]$/)?.[1];
  return n ? <a href={`#source-${n}`}>[{n}]</a> : part;
})}
