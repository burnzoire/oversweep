---
import LinkedText from '../LinkedText.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Cited from './Cited.astro';
import PhotoFigure from './PhotoFigure.astro';
import RunwayFigure from './RunwayFigure.astro';
import { airfieldCatalogue, airfieldContent, recordRoute, type AirfieldData, type EncyclopediaRecord, type MapData, type Period, type TheatreData } from '../../data/encyclopedia';
import { airfieldRoles, basings, branches, coverageStatuses, currentUse, dateText, eras, hasEnded, nations, periodText, sims, useLabels } from '../../data/airfield-model.mjs';
import { categoryTitle } from '../../data/availability';
import { assetPath, sitePath } from '../../lib/paths';
import '../../styles/encyclopedia.css';

// The page for an airfield, theatre or sim map record. The Airfields &
// Carriers and Theatres routes both render it.
const { record } = Astro.props as { record: EncyclopediaRecord };
const { frontmatter, Content } = airfieldContent(record);
const category = categoryTitle(record.category);
const { airfields, theatres, maps } = airfieldCatalogue();
// Airfield, theatre and map pages share this route; `kind` picks the layout.
const airfield = frontmatter.kind === 'airfield' ? airfields.find((a) => a.record === record)! : undefined;
const theatre = frontmatter.kind === 'theatre' ? theatres.find((t) => t.record === record)! : undefined;
const map = frontmatter.kind === 'map' ? maps.find((m) => m.record === record)! : undefined;
const a = airfield?.data as AirfieldData | undefined;
const t = theatre?.data as TheatreData | undefined;
const m = map?.data as MapData | undefined;

const label = (r: EncyclopediaRecord) => airfieldContent(r).frontmatter.short ?? r.title;
const link = (r: EncyclopediaRecord) => sitePath(recordRoute(r));
// Citations belong to each record's own source list, so text from another record drops them.
const plain = (text: string) => text.replace(/\s*\[\d+\]/g, '');
const n = (value: number) => value.toLocaleString('en-GB');
const ft = (feet: number) => `${n(feet)} ft (${n(Math.round(feet * 0.3048))} m)`;
const nation = (key: keyof typeof nations) => nations[key].name + ('note' in nations[key] ? ` (${nations[key].note})` : '');
const when = (p: Period) => periodText(p) ?? 'date not given';
const coord = (value: number, pos: string, neg: string) => `${Math.abs(value).toFixed(4)}° ${value >= 0 ? pos : neg}`;

// The record nav: on an airfield page, its theatre's airfields, or every
// airfield when it has no theatre; on a theatre page, every theatre; on a map
// page, the other maps of its theatre.
const home = airfield?.theatres[0];
const homeTheatre = home && theatres.find((x) => x.record === home.record);
const mapTheatre = map?.theatres[0] && theatres.find((x) => x.record === map.theatres[0].record);
const nav = airfield ? (homeTheatre ? homeTheatre.airfields : airfields).map((x) => x.record)
  : theatre ? theatres.map((x) => x.record) : (mapTheatre ? mapTheatre.maps : maps).map((x) => x.record);
const navLabel = airfield ? (homeTheatre ? `Airfields in ${homeTheatre.record.title}` : 'Airfields') : theatre ? 'Theatres' : mapTheatre ? `Sim maps in ${mapTheatre.record.title}` : 'Sim maps';

const photos = frontmatter.photos ?? [];
const [leadPhoto, ...morePhotos] = photos;
const sources = frontmatter.sources;

// Airfield facts, with time-sensitive lists split into now and then.
const currentUnits = (a?.units ?? []).filter((u) => !hasEnded(u));
const pastUnits = (a?.units ?? []).filter(hasEnded);
const use = a && currentUse(a.operators);
const checkedMaps = airfield?.maps ?? [];
// Maps of the airfield's theatres that nobody has checked it against yet.
const uncheckedMaps = airfield ? maps.filter((x) => x.theatres.some((th) => airfield.theatres.some((at) => at.record === th.record)) && !checkedMaps.some((c) => c.record === x.record)) : [];
const ids = a?.identifiers;
const idText = ids && [ids.icao && `ICAO ${ids.icao}`, ids.iata && `IATA ${ids.iata}`, ids.faa && `FAA ${ids.faa}`, ...(ids.others ?? [])].filter(Boolean).join(' · ');
---
<SiteLayout title={record.title} activeSection="encyclopedia"
  description={`${record.title} (${record.designation}): ${record.summary}`}
  breadcrumbs={[{ label: 'Encyclopedia', href: sitePath('encyclopedia/') }, { label: category, href: sitePath(`encyclopedia/${record.category}/`) }, ...(map?.theatres[0] ? [{ label: map.theatres[0].record.title, href: link(map.theatres[0].record) }] : []), { label: record.title }]}>
  <div class="ency airfield">
    <nav class="record-nav" aria-label={navLabel}>
      <ol>{nav.map((r) => <li>{r === record ? <span aria-current="page">{label(r)}</span> : <a href={link(r)}>{label(r)}</a>}</li>)}</ol>
    </nav>
    {leadPhoto && <PhotoFigure photo={leadPhoto} lead />}
    <section class="status-panel" data-record-id={record.id} data-record-revision={record.revision}>
      <h2>{record.maturity}</h2>
      <p>Record revision {record.revision} · {record.summary}</p>
      {a && <p>A real-world airfield as described in public sources, and how sim maps represent it. Units, facilities and names change; each is dated where the sources allow, and the charts are not for navigation. Use current official publications for flight planning.</p>}
      {t && <p>A real-world region and its military history. Its airfields and the sim maps that represent it are listed from their own records.</p>}
      {m && <p>One simulator's map: what it covers, when it is set, and which airfields in this encyclopedia it represents. Sim maps change with updates; each claim is cited with the date it was read.</p>}
    </section>

    {a && airfield && (
      <>
        <section class="data-plate" aria-labelledby="where-title">
          <h2 id="where-title">Where it is and what it is called</h2>
          <dl>
            <div><dt>Location</dt><dd><Cited text={a.location} /></dd></div>
            <div><dt>Country or territory</dt><dd>{nation(a.country)}</dd></div>
            <div><dt>Coordinates</dt><dd>{coord(a.coordinates.lat, 'N', 'S')}, {coord(a.coordinates.lon, 'E', 'W')} <Cited text={a.coordinates.cite} /></dd></div>
            <div><dt>Elevation</dt><dd>{ft(a.elevationFt)} <Cited text={a.elevationCite} /></dd></div>
            <div><dt>Identifiers</dt><dd>{idText || 'None given in the sources cited'}</dd></div>
            <div><dt>Other names</dt><dd>{a.names?.length
              ? <ul>{a.names.map((x) => {
                const about = [x.former && 'former name', periodText(x)].filter(Boolean).join(', ');
                return <li>{x.name}{about && ` (${about})`} <Cited text={x.cite} /></li>;
              })}</ul>
              : 'None recorded'}</dd></div>
            <div><dt>Opened</dt><dd><Cited text={a.opened.text} /></dd></div>
            {a.closed && <div><dt>Closed</dt><dd><Cited text={a.closed.text} /></dd></div>}
            <div><dt>Theatre</dt><dd>{airfield.theatres.length
              ? airfield.theatres.map((x, i) => <>{i > 0 && ', '}<a href={link(x.record)}>{x.record.title}</a></>)
              : 'Not part of a theatre record yet'}</dd></div>
          </dl>
        </section>

        <section class="data-plate" aria-labelledby="role-title">
          <h2 id="role-title">Role and who uses it</h2>
          <dl>
            <div><dt>Status</dt><dd>{a.status === 'active' ? 'Active' : 'Closed'} · {useLabels[use!]}</dd></div>
            <div><dt>Roles today</dt><dd>{a.roles.map((r) => airfieldRoles[r]).join(' · ')}</dd></div>
            <div><dt>Operators</dt><dd><ul>{a.operators.map((o) => (
              <li><strong>{o.name}</strong>{o.detail && `, ${o.detail}`} · {nation(o.nation)}, {branches[o.branch].toLowerCase()} · {periodText(o) ?? 'current; start date not given'} <Cited text={o.cite} /></li>
            ))}</ul></dd></div>
          </dl>
        </section>

        {(a.units?.length ?? 0) > 0 && (
          <section class="units" aria-labelledby="units-title">
            <h2 id="units-title">Units</h2>
            <p class="note">Permanently based units belong to the airfield; rotational and temporarily deployed units are there for a period or an operation. Dates are when the sources place each unit there; "as of" is when a source described it as current.</p>
            {[['Current', currentUnits], ['Earlier', pastUnits]].filter(([, list]) => (list as typeof currentUnits).length).map(([heading, list]) => (
              <>
                <h3>{heading}</h3>
                <ul class="unit-list">
                  {(list as typeof currentUnits).map((u) => (
                    <li>
                      <p class="unit-name">{u.name} <Cited text={u.cite} /></p>
                      <dl class="unit-facts">
                        <div><dt>Service</dt><dd>{nation(u.nation)}, {branches[u.branch].toLowerCase()}</dd></div>
                        <div><dt>Basing</dt><dd>{u.basing ? basings[u.basing] : 'Not stated in the sources'}</dd></div>
                        {u.aircraft && <div><dt>Aircraft</dt><dd>{u.aircraft.join(', ')}</dd></div>}
                        <div><dt>When</dt><dd>{when(u)}</dd></div>
                      </dl>
                    </li>
                  ))}
                </ul>
              </>
            ))}
          </section>
        )}

        <section class="facilities" aria-labelledby="facilities-title">
          <h2 id="facilities-title">Runways and facilities</h2>
          <p class="note">{a.facilities.asOf ? `From data effective ${dateText(a.facilities.asOf)}.` : 'The sources do not date these figures.'} Facilities not listed here are not documented in the sources cited, which does not mean the airfield lacks them.</p>
          <div class="table-scroll" role="region" aria-label="Runways, scrolls sideways on narrow screens" tabindex="0">
            <table>
              <thead><tr><th scope="col">Runway</th><th scope="col">Length</th><th scope="col">Width</th><th scope="col">Surface</th></tr></thead>
              <tbody>
                {a.facilities.runways.map((r) => (
                  <tr>
                    <th scope="row">{r.field && <span class="entry-kicker">{r.field} </span>}{r.id} <Cited text={r.cite} />{r.note && <span class="runway-note">{r.note}</span>}</th>
                    <td>{r.lengthFt === null ? 'Not given' : ft(r.lengthFt)}</td>
                    <td>{r.widthFt ? ft(r.widthFt) : 'Not given'}</td>
                    <td>{r.surface ?? 'Not given'}{r.unpaved && ' (unpaved)'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <dl class="facility-list">
            <div><dt>Arresting gear</dt><dd>{a.facilities.arresting?.length ? <ul>{a.facilities.arresting.map((x) => <li><Cited text={x} /></li>)}</ul> : 'None documented in the sources cited'}</dd></div>
            <div><dt>Navaids</dt><dd>{a.facilities.navaids?.length ? <ul>{a.facilities.navaids.map((x) => <li><Cited text={x} /></li>)}</ul> : 'None documented in the sources cited'}</dd></div>
            {a.facilities.other?.length && <div><dt>Other</dt><dd><ul>{a.facilities.other.map((x) => <li><Cited text={x} /></li>)}</ul></dd></div>}
          </dl>
          {a.charts && (
            <div class="chart-grid">
              {a.charts.map((c, i) => (
                <figure class="chart">
                  <img src={assetPath(c.src)} alt={c.alt} loading="lazy" decoding="async" />
                  <figcaption>
                    <strong>Figure {i + 1}.</strong> {c.caption}
                    <span class="credit">{c.chart}. {c.publisher}; public domain, via <a href={c.sourceUrl}>aeronav.faa.gov</a> (accessed {c.accessed}). Not for navigation.</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          )}
          {a.runwayPlan && (
            <RunwayFigure title={`Figure 1 — Runways at ${a.name} (plan view, to scale)`} runways={a.runwayPlan.runways} name={a.name}>
              <p class="fig-caption">Runways drawn to scale between their published threshold coordinates, true north up. Taxiways, aprons and buildings are not drawn. <Cited text={a.runwayPlan.cite} /> Not for navigation.</p>
            </RunwayFigure>
          )}
        </section>

        <section class="sim-panel" aria-labelledby="sims-title">
          <h2 id="sims-title">In the sims</h2>
          {checkedMaps.map(({ record: mr, data: md, coverage: c }) => (
            <div class={`coverage coverage-${c.status}`}>
              <h3><a href={link(mr)}>{md.name}</a> <span class="entry-kicker">{sims[md.sim]} · {eras[md.setting.era]}</span></h3>
              <p><strong>{coverageStatuses[c.status]}</strong>{c.inSimName && <> as “{c.inSimName}”</>}{c.status !== 'unchecked' && <> · checked {c.checked}</>}{c.cite && c.status !== 'unchecked' && <> <Cited text={c.cite} /></>}</p>
              {c.note && <p><Cited text={c.note} /></p>}
              {c.facts && <ul>{c.facts.map((f) => <li><Cited text={f} /></li>)}</ul>}
              {c.differences && (
                <>
                  <h4>Differences from the real airfield</h4>
                  <ul>{c.differences.map((d) => <li><strong>{d.topic}:</strong> <Cited text={d.text} /></li>)}</ul>
                </>
              )}
            </div>
          ))}
          {checkedMaps.every((x) => x.coverage.status === 'unchecked')
            ? <p>No sim map has been checked against this airfield yet. That is not a claim that no map represents it.</p>
            : <p class="note">Only the maps marked represented or confirmed absent have been checked. Any other map may or may not represent this airfield.</p>}
          {uncheckedMaps.length > 0 && <p>Other maps in {homeTheatre?.record.title ?? 'its theatre'}, not yet checked for this airfield, which may lie outside them: {uncheckedMaps.map((x, i) => <>{i > 0 && ', '}<a href={link(x.record)}>{x.data.name}</a></>)}.</p>}
        </section>
      </>
    )}

    {t && theatre && (
      <>
        <section class="data-plate" aria-labelledby="plate-title">
          <h2 id="plate-title">{t.name}</h2>
          <dl>
            <div><dt>Region</dt><dd>{t.region}</dd></div>
            <div><dt>Countries and territories</dt><dd>{t.countries.map(nation).join(', ')}</dd></div>
            <div><dt>Airfields in this encyclopedia</dt><dd><ul>{theatre.airfields.map((x) => <li><a href={link(x.record)}>{x.record.title}</a> · {nation(x.data.country)}</li>)}</ul></dd></div>
          </dl>
        </section>
        <section class="sim-panel" aria-labelledby="sims-title">
          <h2 id="sims-title">Sim maps of this theatre</h2>
          {theatre.maps.length
            ? <ul>{theatre.maps.map((x) => <li><a href={link(x.record)}>{x.data.name}</a> ({sims[x.data.sim]}): {plain(x.data.setting.text)}</li>)}</ul>
            : <p>No sim map record covers this theatre yet.</p>}
        </section>
      </>
    )}

    {m && map && (
      <>
        <section class="data-plate" aria-labelledby="plate-title">
          <h2 id="plate-title">{m.name}</h2>
          <dl>
            <div><dt>Simulator</dt><dd>{sims[m.sim]}</dd></div>
            <div><dt>Made by</dt><dd>{m.publisher}</dd></div>
            <div><dt>Setting</dt><dd>{eras[m.setting.era]}{periodText(m.setting) && `, ${periodText(m.setting)}`}: <Cited text={m.setting.text} /></dd></div>
            <div><dt>Area</dt><dd><Cited text={m.area} /></dd></div>
            <div><dt>Real-world theatre</dt><dd>{map.theatres.length ? map.theatres.map((x, i) => <>{i > 0 && ', '}<a href={link(x.record)}>{x.record.title}</a></>) : 'No theatre record yet'}</dd></div>
          </dl>
        </section>
        <section class="sim-panel" aria-labelledby="sims-title">
          <h2 id="sims-title">Airfields checked against this map</h2>
          {map.airfields.length ? (
            <div class="table-scroll" role="region" aria-label="Airfields checked against this map, scrolls sideways on narrow screens" tabindex="0">
              <table>
                <thead><tr><th scope="col">Airfield</th><th scope="col">On this map</th><th scope="col">Name in the sim</th><th scope="col">Checked</th></tr></thead>
                <tbody>
                  {map.airfields.map(({ airfield: x, coverage: c }) => (
                    <tr>
                      <th scope="row"><a href={link(x.record)}>{x.record.title}</a></th>
                      <td>{coverageStatuses[c.status]}{(c.differences?.length ?? 0) > 0 && `; ${c.differences!.length} known difference${c.differences!.length > 1 ? 's' : ''}`}</td>
                      <td>{c.inSimName ?? '—'}</td>
                      <td>{c.checked}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : <p>No airfield in this encyclopedia has been checked against this map yet.</p>}
          <p class="note">Each airfield's page cites the sources for its entry. Airfields not listed have not been checked against this map.</p>
          {m.differences && (
            <>
              <h3>Other differences from reality</h3>
              <ul>{m.differences.map((d) => <li><strong>{d.topic}:</strong> <Cited text={d.text} /></li>)}</ul>
            </>
          )}
        </section>
      </>
    )}

    <div class="record-body"><LinkedText><Content /></LinkedText></div>
    {morePhotos.length > 0 && <div class="photo-grid">{morePhotos.map((photo) => <PhotoFigure photo={photo} />)}</div>}

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources</h2>
      <ol>
        {sources.map((s) => (
          <li id={`source-${s.n}`} value={s.n}><cite>{s.title}</cite>. {s.publisher}{s.date && `, ${s.date}`}. <a href={s.url}>{s.url}</a> (accessed {s.accessed}).{s.note && ` ${s.note}`}</li>
        ))}
      </ol>
      <p class="note">Wikipedia articles are secondary sources and can change; they are cited with the date they were read. {a ? 'FAA airport data and diagrams are official but are reissued every 28 or 56 days; each is cited with the edition read. pydcs mirrors the DCS terrain data at the commit linked.' : m ? 'Vendor pages describe the current release of each map.' : ''}</p>
    </section>
  </div>
</SiteLayout>
