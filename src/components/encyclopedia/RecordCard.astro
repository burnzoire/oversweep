---
import { recordRoute, type EncyclopediaRecord, type Photo } from '../../data/encyclopedia';
import { assetPath, sitePath } from '../../lib/paths';
// `photo` adds a thumbnail; it is decorative because the title follows it.
// `era` tags the card for the aircraft list filter; `filter` adds the data-*
// attributes another list's filter reads. Slotted content follows the summary.
interface Props { record: EncyclopediaRecord; headingLevel?: 2 | 3; photo?: Photo; era?: string; filter?: Record<string, string> }
const { record, headingLevel = 3, photo, era, filter = {} } = Astro.props;
const filterAttributes = Object.fromEntries(Object.entries(filter).map(([key, value]) => [`data-${key}`, value]));
const Heading = (headingLevel === 2 ? 'h2' : 'h3') as 'h2' | 'h3';
const local = record.publication !== 'published';
---
<section class="entry-card" data-era={era} {...filterAttributes} data-record-id={record.id} data-record-revision={record.revision}>
  {photo && <img class:list={['entry-thumb', { contain: photo.fit === 'contain' }]} src={assetPath(photo.src)} alt="" loading="lazy" decoding="async" />}
  <p class="entry-kicker">{record.designation}</p>
  <Heading class="entry-title"><a href={sitePath(recordRoute(record))}>{record.title}</a></Heading>
  <p class="entry-objective">{record.summary}</p>
  <slot />
  <p class="entry-meta"><span class="maturity">{record.maturity}</span> · Record revision {record.revision}{local && ' · Local review only'}</p>
</section>
