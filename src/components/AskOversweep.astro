---
import { assetPath, sitePath } from "../lib/paths";
const { id } = Astro.props;
---
  <section class="ask" data-ask data-index={assetPath("pagefind/pagefind.js")} data-base={sitePath()} data-endpoint={import.meta.env.PUBLIC_ASK_ENDPOINT}>
    {id !== "ask-dialog-question" && <button type="button" data-new-chat aria-label="New chat" title="New chat"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button>}
    <div data-thread role="log" aria-label="Conversation"></div>
    <form>
      
      <div class="ask-controls">
        <input id={id} name="question" type="text" aria-label="Your message" placeholder="Type a message…" maxlength="300" required />
        <button type="submit" aria-label="Send" title="Send"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4zM22 2 11 13" /></svg></button>
      </div>
    </form>
    <noscript><p>Enable JavaScript to find passages.</p></noscript>
  </section>


<script>
  import { findPassages } from "../scripts/ask-oversweep.mjs";

  for (const panel of document.querySelectorAll<HTMLElement>("[data-ask]")) {
    const form = panel.querySelector<HTMLFormElement>("form")!;
    const input = form.querySelector<HTMLInputElement>("input")!;
    const button = form.querySelector<HTMLButtonElement>("button")!;
    const thread = panel.querySelector<HTMLElement>("[data-thread]")!;
    const reset = panel.closest("dialog")?.querySelector<HTMLButtonElement>("[data-new-chat]")
      ?? panel.querySelector<HTMLButtonElement>("[data-new-chat]");
    let previous = "";
    let lastQuestion = "";
    let generation = 0;

    reset?.addEventListener("click", () => {
      generation++;
      previous = "";
      lastQuestion = "";
      thread.replaceChildren();
      form.reset();
      button.disabled = false;
      input.focus();
    });

    function appendMessage(sender: string, content: string) {
      const bubble = document.createElement("article");
      bubble.dataset.sender = sender;
      bubble.setAttribute("aria-label", sender === "you" ? "You" : "Oversweep");
      const copy = document.createElement("p");
      copy.textContent = content;
      bubble.append(copy);
      thread.append(bubble);
      bubble.scrollIntoView({ block: "nearest" });
      return { bubble, copy };
    }
    const text = document.createElement("textarea");

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const message = input.value.trim();
      const retry = /^(?:please )?(?:try again|retry)[.!?]*$/i.test(message);
      const question = retry ? lastQuestion : message;
      if (button.disabled || !message) return;
      if (!question) {
        appendMessage("oversweep", "Ask me a question first, then I can retry it.");
        return;
      }
      lastQuestion = question;
      button.disabled = true;
      const turn = generation;
      appendMessage("you", message);
      input.value = "";
      input.focus();
      const reply = appendMessage("oversweep", "…");
      try {
        const pagefind = await import(/* @vite-ignore */ panel.dataset.index!);
        const search = (query: string) => findPassages(pagefind, query, panel.dataset.base!, location.origin);
        const followUp = previous && (/\b(it|they|that|those|this|them|same)\b/i.test(question) || /^(and|what about|how about)\b/i.test(question));
        const contextual = followUp ? await search(question + " " + previous) : [];
        const passages = contextual.length ? contextual : await search(question);
        if (turn !== generation) return;
        let generated: { answer?: string; ids?: string[] } | undefined;
        let quota = false;
        if (panel.dataset.endpoint && passages.length) {
          try {
            const response = await fetch(panel.dataset.endpoint, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ question, previous: previous || undefined, ids: passages.map(passage => passage.url) }),
              signal: AbortSignal.timeout(12000),
            });
            const payload = await response.json();
            quota = response.status === 429 && payload.code === "daily_quota";
            if (response.ok) generated = payload;
          } catch {
            // Pagefind remains usable if inference is unavailable.
          }
        }
        if (turn !== generation) return;
        if (!followUp && passages.length) previous = question;
        const sources = document.createElement("ul");
        for (const passage of passages) {
          if (generated?.ids && !generated.ids.includes(passage.url)) continue;
          const result = document.createElement("li");
          const link = document.createElement("a");
          link.href = passage.url;
          link.textContent = passage.title;
          result.append(link);
          sources.append(result);
        }
        if (passages.length) {
          text.innerHTML = passages[0].excerpt;
          reply.copy.textContent = generated?.answer ?? (quota
            ? "Negative, Ghostrider. The pattern is full"
            : panel.dataset.endpoint ? "I couldn’t generate a reply. Here’s what I found on Oversweep." : "Here’s what I found on Oversweep.");
          if (!generated?.answer) {
            const excerpt = document.createElement("blockquote");
            excerpt.textContent = text.value;
            reply.bubble.append(excerpt);
          }
          const reading = document.createElement("details");
          const label = document.createElement("summary");
          label.textContent = "Read more on Oversweep";
          reading.append(label, sources);
          if (sources.childElementCount) reply.bubble.append(reading);
        } else {
          reply.copy.textContent = "I couldn’t find that on Oversweep. Could you tell me a bit more?";
        }
      } catch {
        reply.copy.textContent = "I couldn’t reach the Oversweep index. Try again in a moment.";
      } finally {
        if (turn === generation) button.disabled = false;
      }
    });
}
</script>

<style>
  .ask { max-width: 42rem; }
  .ask-controls { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .5rem; }
  input { flex: 1 1 16rem; min-width: 0; }
  input, button { font: inherit; padding: .65rem .8rem; }
  button { color: white; background: var(--color-ink); border: 1px solid var(--color-ink); cursor: pointer; }
  button[aria-label] { display: inline-grid; place-items: center; min-width: 2.75rem; min-height: 2.75rem; }
  button:disabled { opacity: .65; cursor: wait; }
  [data-thread] { display: grid; gap: .65rem; max-height: min(48dvh, 24rem); overflow-y: auto; margin-top: .5rem; }
  [data-thread]:empty { display: none; }
  [data-thread] :global(article) { width: fit-content; max-width: 92%; padding: .65rem .8rem; border-radius: .75rem; background: #eef1f4; overflow-wrap: anywhere; }
  [data-thread] :global([data-sender="you"]) { justify-self: end; background: var(--color-ink); color: white; }
  [data-thread] :global(p) { margin: 0; color: inherit; }
  [data-thread] :global(ul) { padding: 0; margin: .5rem 0 0; list-style: none; }
  [data-thread] :global(li) { padding: .5rem; margin-top: .4rem; border: 1px solid #c6cdd4; border-radius: .4rem; background: white; }
  [data-new-chat] { background: transparent; color: inherit; padding: .3rem .6rem; }
</style>

