---
/**
 * Cockpit area → panel navigation, in catalogue order. Built panels link to
 * their close-up; panels not yet built are listed dimmed and unlinked.
 */
import type { AircraftCockpit } from '../../data/cockpit/types';
import { panelRoute } from '../../data/cockpit/f16c/index.ts';
import { sitePath } from '../../lib/paths';

interface Props { cockpit: AircraftCockpit; current?: string }
const { cockpit, current } = Astro.props;
---
<nav class="cockpit-nav" aria-label={`${cockpit.title} cockpit areas and panels`}>
  {cockpit.areas.map(area => {
    const open = !current || area.panels.some(p => p.id === current) || area.panels.some(p => p.spec);
    return (
      <details open={open}>
        <summary>{area.title} <span class="cn-count">{area.panels.filter(p => p.spec).length}/{area.panels.length}</span></summary>
        <ul>
          {area.panels.map(p => (
            <li>{p.spec
              ? <a href={sitePath(panelRoute(cockpit, p.id))} aria-current={p.id === current ? 'page' : undefined}>{p.title}</a>
              : <span class="cn-unbuilt">{p.title}</span>}</li>
          ))}
        </ul>
      </details>
    );
  })}
</nav>
<style>
.cockpit-nav{font-size:.92rem}
.cockpit-nav details{border-top:1px solid var(--color-divider);padding:.35rem 0}
.cockpit-nav summary{cursor:pointer;font-weight:600;min-height:2.2rem;display:flex;align-items:center;gap:.4rem}
.cn-count{font-weight:400;color:var(--color-muted);font-size:.85em}
.cockpit-nav ul{list-style:none;margin:0 0 .3rem;padding:0 0 0 .9rem}
.cockpit-nav li{margin:.1rem 0}
.cockpit-nav a{display:inline-flex;align-items:center;min-height:2rem}
.cockpit-nav a[aria-current="page"]{font-weight:700;color:var(--color-text);text-decoration:none;border-left:.22rem solid var(--color-accent);padding-left:.4rem;margin-left:-.62rem}
.cn-unbuilt{color:var(--color-unavailable);display:inline-flex;min-height:1.7rem;align-items:center}
</style>
