---
/**
 * Interactive close-up of one assembled panel. Everything comes from the
 * panel spec: the artwork, the hit zones and the movement rules. The script
 * below is the same for every panel; it knows positions, holds, guards and
 * protections, never a panel by name.
 *
 * Control positions are kept per aircraft in sessionStorage, so they survive
 * moving between panels. The jet is cold and dark: no systems logic runs and
 * no lamp lights; selecting a lamp shows what it means.
 *
 * Procedures host several panels on one page: `scope` keeps their positions
 * apart from Cockpit Familiarization. The engine reports every move as a
 * `cockpit:change` event on window (detail: panel, control, position, phase
 * `press` or `release`) and takes `cockpit:indicate` events (detail: `lit`, the
 * `<panel>.<indicator>` ids that are on; `readings`, values by the same ids),
 * so the procedure, not the panel, decides what lights. `cockpit:set`
 * (detail: `positions` by `<panel>.<control>`) moves controls without a
 * change event.
 */
import type { AircraftCockpit, PanelSpec } from '../../data/cockpit/types';
import { hitZones, readings, renderPanel } from '../../data/cockpit/render.ts';

interface Props { cockpit: AircraftCockpit; spec: PanelSpec; scope?: string }
const { cockpit, spec, scope } = Astro.props;
const [W, H] = spec.canvas;
const pct = (v: number, of: number) => `${+((v / of) * 100).toFixed(3)}%`;
const def = { aircraft: scope ? `${cockpit.id}:${scope}` : cockpit.id, panel: spec.id, controls: spec.controls, indicators: spec.indicators, readings: readings(spec) };
const control = (id: string) => spec.controls.find(c => c.id === id)!;
const dirLabels = (id: string) => {
  const c = control(id);
  if (c.type === 'rotary') return [`Turn ${c.name} anticlockwise`, `Turn ${c.name} clockwise`];
  if (c.travel === 'horizontal') return [`Move ${c.name} left`, `Move ${c.name} right`];
  return [`Move ${c.name} up`, `Move ${c.name} down`];
};
---
<div class="cockpit-panel" data-cockpit-panel style={`--ratio:${W / H}` + (W / H < 0.6 ? ';--cp-height:52rem' : '')}>
  <div class="cp-stage">
    <Fragment set:html={renderPanel(spec, { label: `${cockpit.title} ${spec.title}` })} />
    {hitZones(spec).map(z => {
      const style = `left:${pct(z.box[0], W)};top:${pct(z.box[1], H)};width:${pct(z.box[2], W)};height:${pct(z.box[3], H)}` + (z.rotate ? `;transform:rotate(${z.rotate}deg)` : '');
      if (z.kind === 'indicator') {
        const ind = spec.indicators.find(i => i.id === z.id)!;
        return <button type="button" class:list={['cp-hit', 'cp-lamp', z.round && 'cp-round']} style={style} data-select={z.id} aria-label={`${ind.name}: what it shows`}></button>;
      }
      const c = control(z.id);
      if (c.type === 'toggle' || c.type === 'rotary') {
        const [a, b] = dirLabels(c.id);
        const axis = c.type === 'rotary' || c.travel === 'horizontal' ? 'cp-x' : 'cp-y';
        return (
          <div class:list={['cp-hit', axis, z.round && 'cp-round']} style={style} role="group" aria-label={c.name} data-hit-of={z.pos ? c.id : undefined} data-hit-pos={z.pos} hidden={z.pos ? z.pos !== c.initial : undefined}>
            <button type="button" data-control={c.id} data-dir="-1" aria-label={a}></button>
            <button type="button" data-control={c.id} data-dir="1" aria-label={b}></button>
          </div>
        );
      }
      const verb = c.type === 'guard' ? `Open or close the ${c.name}` : `Press ${c.name}`;
      return <button type="button" class:list={['cp-hit', z.round && 'cp-round']} style={style} data-control={c.id} data-dir="flip" aria-label={verb}></button>;
    })}
  </div>
  <p class="cp-status" role="status" aria-live="polite" data-cp-status></p>
  <script type="application/json" data-cockpit-def set:html={JSON.stringify(def)} />
</div>

<style>
.cockpit-panel{--panel-ink:#161616;max-width:min(100%,calc(var(--cp-height,34rem) * var(--ratio)))}
.cp-stage{position:relative;aspect-ratio:var(--ratio);background:#fff;user-select:none;-webkit-user-select:none;touch-action:manipulation}
.cp-stage :global(svg){display:block;width:100%;height:100%}
.cp-stage :global(.lens){fill:transparent}
.cp-stage :global([data-indicator].lit[data-colour="amber"] .lens){fill:#f5b400}
.cp-stage :global([data-indicator].lit[data-colour="green"] .lens){fill:#5fd35f}
.cp-stage :global([data-indicator].lit[data-colour="red"] .lens){fill:#ff5a4f}
.cp-stage :global([data-indicator].selected .lens){fill:rgba(0,95,204,.14);stroke:#005fcc;stroke-width:.5}
.cp-stage :global([data-indicator].selected > [data-needle] > path:first-child){stroke:#005fcc;stroke-width:.6}
.cp-hit{position:absolute;margin:0;padding:0;border:0;background:transparent;cursor:pointer;border-radius:8%;overflow:hidden}
.cp-round{border-radius:50%}
.cp-hit > button{position:absolute;margin:0;padding:0;border:0;background:transparent;cursor:pointer}
.cp-y > button{left:0;width:100%;height:50%}
.cp-y > button:first-child{top:0}
.cp-y > button:last-child{bottom:0}
.cp-x > button{top:0;height:100%;width:50%}
.cp-x > button:first-child{left:0}
.cp-x > button:last-child{right:0}
.cp-hit:focus-visible,.cp-hit > button:focus-visible{outline:2px solid var(--color-focus,#005fcc);outline-offset:1px}
@media(hover:hover){.cp-hit:hover,.cp-hit > button:hover{background:rgba(0,95,204,.08)}}
.cp-status{min-height:1.6em;margin:.4rem 0 0;font-size:.95rem;color:var(--color-muted,#595959)}
</style>

<script>
import type { ControlDef, IndicatorDef } from '../../data/cockpit/types';
import type { Reading } from '../../data/cockpit/render.ts';
import { drumPositions, scaleAngle } from '../../data/cockpit/dial.ts';

interface Def { aircraft: string; panel: string; controls: ControlDef[]; indicators: IndicatorDef[]; readings: Record<string, Reading> }
const storeKey = (aircraft: string) => `oversweep:cockpit:${aircraft}`;
const load = (aircraft: string): Record<string, string> => {
  try { return JSON.parse(sessionStorage.getItem(storeKey(aircraft)) ?? '{}') ?? {}; } catch { return {}; }
};
const save = (aircraft: string, s: Record<string, string>) => {
  try { sessionStorage.setItem(storeKey(aircraft), JSON.stringify(s)); } catch { /* storage unavailable: state lasts for this page only */ }
};

for (const root of document.querySelectorAll<HTMLElement>('[data-cockpit-panel]')) {
  const def: Def = JSON.parse(root.querySelector('[data-cockpit-def]')!.textContent!);
  const svg = root.querySelector('svg')!;
  const status = root.querySelector<HTMLElement>('[data-cp-status]')!;
  const info = document.querySelector<HTMLElement>(`[data-cockpit-info="${def.panel}"]`);
  const byId = new Map(def.controls.map(c => [c.id, c]));
  const key = (id: string) => `${def.panel}.${id}`;
  let store = load(def.aircraft);
  /**
   * Position as a fractional index into c.positions: whole numbers are positions,
   * fractions lie between two (a throttle left part-way along its travel is stored as `~2.4`).
   */
  const at = (c: ControlDef) => {
    const s = store[key(c.id)] ?? c.initial;
    if (s.startsWith('~')) return Math.min(c.positions.length - 1, Math.max(0, Number(s.slice(1)) || 0));
    return Math.max(0, c.positions.findIndex(p => p.id === s));
  };
  /** Nearest position id (what protections and steps work from). */
  const pos = (c: ControlDef) => c.positions[Math.round(at(c))].id;
  const label = (c: ControlDef, p?: string) => {
    if (p) return c.positions.find(x => x.id === p)?.label ?? p;
    const v = at(c), i = Math.floor(v), j = Math.ceil(v);
    if (i === j) return c.positions[i].label;
    // Between two stops: name the stops either side, not the pass-through poses.
    let a = i, b = j;
    while (a > 0 && c.positions[a].pass) a--;
    while (b < c.positions.length - 1 && c.positions[b].pass) b++;
    return `between ${c.positions[a].label} and ${c.positions[b].label}`;
  };
  /** The simulator value (e.g. DCS argument) at the current position, interpolated between positions. */
  const simValue = (c: ControlDef) => {
    const v = at(c), i = Math.floor(v), j = Math.ceil(v), a = c.positions[i].value, b = c.positions[j].value;
    return a === undefined || b === undefined ? undefined : a + (b - a) * (v - i);
  };

  // Tweened controls: every position is drawn with the same path structure, so a
  // fractional position is drawn by interpolating the numbers of its two neighbours.
  const NUM = /-?\d*\.?\d+/g;
  interface Tween { groups: SVGGElement[]; live: SVGGElement; livePaths: SVGPathElement[]; tpl: string[][]; nums: number[][][]; refs: number[]; axis: string; from: number }
  const tweens = new Map<string, Tween>();
  for (const el of svg.querySelectorAll<SVGGElement>('[data-move][data-tween]')) {
    const c = byId.get(el.dataset.move!);
    if (!c) continue;
    const groups = c.positions.map(p => el.querySelector<SVGGElement>(`:scope > [data-pos="${p.id}"]`)!);
    if (groups.some(g => !g)) continue;
    const ds = groups.map(g => [...g.querySelectorAll('path')].map(p => p.getAttribute('d') ?? ''));
    const nums = ds.map(list => list.map(d => (d.match(NUM) ?? []).map(Number)));
    const same = nums.every(list => list.length === nums[0].length && list.every((ns, k) => ns.length === nums[0][k].length));
    if (!same) continue;
    const axis = el.dataset.tween ?? '';
    // Reference point of each pose for dragging: mean of the outline numbers along the axis.
    const refs = nums.map(list => {
      const flat = (list.length > 1 ? list.slice(1) : list).flat();
      const pick = flat.filter((_, k) => k % 2 === (axis === 'y' ? 1 : 0));
      return pick.reduce((s, v) => s + v, 0) / Math.max(1, pick.length);
    });
    const live = groups[0].cloneNode(true) as SVGGElement;
    live.dataset.pos = '~live';
    live.setAttribute('display', 'none');
    el.appendChild(live);
    const from = el.dataset.dragFrom ? Math.max(0, c.positions.findIndex(p => p.id === el.dataset.dragFrom)) : 0;
    tweens.set(c.id, { groups, live, livePaths: [...live.querySelectorAll('path')], tpl: ds[0].map(d => d.split(NUM)), nums, refs, axis, from });
  }

  const drawAt = (c: ControlDef, v: number) => {
    const tw = tweens.get(c.id);
    const i = Math.floor(v), j = Math.ceil(v), f = v - i;
    const frac = tw && i !== j;
    for (const g of svg.querySelectorAll<SVGGElement>(`[data-move="${c.id}"] > [data-pos]`)) {
      const show = frac ? g.dataset.pos === '~live' : g.dataset.pos === c.positions[Math.round(v)].id;
      if (show) g.removeAttribute('display'); else g.setAttribute('display', 'none');
    }
    if (frac) {
      tw.livePaths.forEach((p, k) => {
        const a = tw.nums[i][k], b = tw.nums[j][k], parts = tw.tpl[k];
        let d = parts[0];
        for (let m = 0; m < a.length; m++) d += +(a[m] + (b[m] - a[m]) * f).toFixed(3) + parts[m + 1];
        p.setAttribute('d', d);
      });
    }
    svg.querySelector(`[data-move="${c.id}"]`)?.setAttribute('data-value', String(simValue(c) ?? ''));
    // Hit areas that move with the part: show the one for the nearest position.
    const near = c.positions[Math.round(v)].id;
    for (const z of root.querySelectorAll<HTMLElement>(`[data-hit-of="${c.id}"]`)) z.hidden = z.dataset.hitPos !== near;
  };
  const draw = (c: ControlDef) => {
    drawAt(c, at(c));
    for (const el of document.querySelectorAll<HTMLElement>(`[data-position-of="${key(c.id)}"]`)) el.textContent = label(c);
  };
  const setAt = (c: ControlDef, v: number, phase: 'press' | 'release' = 'press') => {
    store = load(def.aircraft);
    store[key(c.id)] = Number.isInteger(v) ? c.positions[v].id : `~${+v.toFixed(4)}`;
    save(def.aircraft, store);
    draw(c);
    if (Number.isInteger(v)) dispatchEvent(new CustomEvent('cockpit:change', { detail: { aircraft: def.aircraft, panel: def.panel, control: c.id, position: c.positions[v].id, phase } }));
  };
  const set = (c: ControlDef, p: string) => setAt(c, Math.max(0, c.positions.findIndex(x => x.id === p)));
  const say = (t: string) => { status.textContent = t; };

  /** Move to a position, animated through the poses in between when the control is tweened. */
  const running = new Map<string, number>();
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const moveTo = (c: ControlDef, to: number, done?: () => void, phase: 'press' | 'release' = 'press') => {
    cancelAnimationFrame(running.get(c.id) ?? 0);
    const from = at(c);
    if (!tweens.has(c.id) || reduced || from === to) { setAt(c, to, phase); done?.(); return; }
    const ms = Math.min(700, 160 + 140 * Math.abs(to - from)), t0 = performance.now();
    const step = (now: number) => {
      const k = Math.min(1, (now - t0) / ms), e = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
      if (k < 1) { drawAt(c, from + (to - from) * e); running.set(c.id, requestAnimationFrame(step)); }
      else { running.delete(c.id); setAt(c, to, phase); done?.(); }
    };
    running.set(c.id, requestAnimationFrame(step));
  };

  const select = (id: string) => {
    svg.querySelectorAll('.selected').forEach(e => e.classList.remove('selected'));
    svg.querySelectorAll(`[data-move="${id}"], [data-indicator="${id}"]`).forEach(e => e.classList.add('selected'));
    if (!info) return;
    for (const card of info.querySelectorAll<HTMLElement>('[data-item]')) card.hidden = card.dataset.item !== id;
    info.querySelector<HTMLElement>('[data-item-empty]')?.toggleAttribute('hidden', true);
  };

  /** Why `c` cannot go from its position to `to`, or '' if it can. */
  const blocked = (c: ControlDef, to: string) => {
    for (const p of c.protections ?? []) {
      if (p.kind !== 'guard' || !p.guard) continue;
      const g = byId.get(p.guard);
      if (!g || pos(g) !== p.blockedWhen) continue;
      if (p.from && !p.from.includes(pos(c))) continue;
      if (p.to && !p.to.includes(to)) continue;
      return p.note;
    }
    return '';
  };

  /** Press: move one detent (or flip). Returns true when a momentary position was entered. */
  const press = (c: ControlDef, dir: string) => {
    select(c.id);
    const v = at(c), n = c.positions.length, step = dir === 'flip' ? 1 : Number(dir);
    // From between two stops, a step goes to the stop on that side.
    let j = Number.isInteger(v) ? v + step : (step > 0 ? Math.ceil(v) : Math.floor(v));
    if (dir === 'flip') j = (v + 1) % n;
    if (c.cyclic) j = (j + n) % n;
    while (j > 0 && j < n - 1 && c.positions[j].pass) j += step;
    if (j < 0 || j >= n) { say(`${c.name} is already at ${label(c)}.`); return; }
    const to = c.positions[j];
    const why = blocked(c, to.id);
    if (why) { say(why); return; }
    moveTo(c, j);
    if (c.guards && to.id === (c.guards.when ?? 'closed')) {
      const guarded = byId.get(c.guards.control);
      if (guarded && pos(guarded) !== c.guards.closesTo) set(guarded, c.guards.closesTo);
    }
    say(`${c.name}: ${to.label}.`);
  };
  /** Release: momentary positions spring back. */
  const release = (c: ControlDef) => {
    const p = c.positions.find(x => x.id === pos(c));
    if (p?.hold === 'momentary' && p.spring) {
      moveTo(c, Math.max(0, c.positions.findIndex(x => x.id === p.spring)), undefined, 'release');
      say(`${c.name}: ${label(c)} (springs back).`);
    }
  };

  /** Pointer position along a tweened control's drag axis, as a fractional position (from its drag start on). */
  const along = (tw: Tween, e: PointerEvent) => {
    const m = svg.getScreenCTM();
    if (!m) return null;
    const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
    const u = tw.axis === 'y' ? p.y : p.x, r = tw.refs;
    let best = tw.from;
    for (let k = tw.from; k < r.length - 1; k++) {
      const lo = Math.min(r[k], r[k + 1]), hi = Math.max(r[k], r[k + 1]);
      if (u >= lo && u <= hi) return k + (u - r[k]) / (r[k + 1] - r[k] || 1);
      if (Math.abs(u - r[k + 1]) < Math.abs(u - r[best])) best = k + 1;
    }
    return Math.abs(u - r[tw.from]) <= Math.abs(u - r[best]) ? tw.from : best;
  };

  for (const b of root.querySelectorAll<HTMLButtonElement>('[data-control]')) {
    const c = byId.get(b.dataset.control!)!;
    const tw = tweens.get(c.id);
    let held = false;
    const down = () => { if (held) return; held = true; press(c, b.dataset.dir!); };
    const up = () => { if (!held) return; held = false; release(c); };
    // Dragging (tweened controls with a drag axis): a press that moves becomes a drag; one that doesn't is a click.
    let drag: { x: number; y: number; moving: boolean } | null = null;
    b.addEventListener('pointerdown', e => {
      if (e.button !== 0) return;
      b.setPointerCapture(e.pointerId);
      if (tw?.axis && at(c) >= tw.from) { drag = { x: e.clientX, y: e.clientY, moving: false }; select(c.id); return; }
      down();
    });
    b.addEventListener('pointermove', e => {
      if (!drag || !tw) return;
      if (!drag.moving && Math.hypot(e.clientX - drag.x, e.clientY - drag.y) < 5) return;
      drag.moving = true;
      cancelAnimationFrame(running.get(c.id) ?? 0);
      const v = along(tw, e);
      if (v !== null) { store[key(c.id)] = `~${v}`; drawAt(c, v); say(`${c.name}: ${label(c)}.`); }
    });
    const endDrag = () => {
      if (!drag) return false;
      const d = drag; drag = null;
      if (!d.moving) { down(); up(); return true; }
      // Settle into a stop when released close to one; otherwise stay where it was left.
      const v = at(c), k = Math.round(v);
      if (Math.abs(v - k) < 0.2 && !c.positions[k].pass) moveTo(c, k); else setAt(c, v);
      say(`${c.name}: ${label(c)}.`);
      return true;
    };
    b.addEventListener('pointerup', () => { if (!endDrag()) up(); });
    b.addEventListener('pointercancel', () => { if (!endDrag()) up(); });
    b.addEventListener('lostpointercapture', () => { if (!endDrag()) up(); });
    b.addEventListener('keydown', e => { if ((e.key === 'Enter' || e.key === ' ') && !e.repeat) { e.preventDefault(); down(); } });
    b.addEventListener('keyup', e => { if (e.key === 'Enter' || e.key === ' ') up(); });
    b.addEventListener('blur', up);
    b.addEventListener('click', e => e.preventDefault());
  }
  for (const b of root.querySelectorAll<HTMLButtonElement>('[data-select]')) {
    b.addEventListener('click', () => {
      select(b.dataset.select!);
      const ind = def.indicators.find(i => i.id === b.dataset.select);
      if (ind) say(ind.type === 'lamp' ? `${ind.name}: off (cold jet).` : `${ind.name}: ${ind.restNote ?? `needle at its stop, ${ind.rest} ${ind.unit ?? ''}`} (cold jet).`);
    });
  }
  for (const b of document.querySelectorAll<HTMLButtonElement>(`[data-cockpit-pick="${def.panel}"]`)) {
    b.addEventListener('click', () => select(b.dataset.id!));
  }
  document.querySelector(`[data-cockpit-reset="${def.aircraft}"]`)?.addEventListener('click', () => {
    try { sessionStorage.removeItem(storeKey(def.aircraft)); } catch { /* nothing stored */ }
    store = {};
    def.controls.forEach(draw);
    say('Every control is back in its cold-and-dark position.');
  });
  def.controls.forEach(draw);

  /** Try a reading: move a needle or roll a counter (not saved; the jet stays cold and dark). */
  const show = (id: string, v: number) => {
    const r = def.readings[id];
    if (!r) return;
    if (r.kind === 'needle') svg.querySelector(`[data-needle="${id}"]`)?.setAttribute('transform', `rotate(${+scaleAngle(r.scale, v).toFixed(3)})`);
    else drumPositions(v, r.drums, r.fixed, r.unit, r.still).forEach((p, k) =>
      svg.querySelector(`[data-drum="${id}"][data-place="${k}"]`)?.setAttribute('transform', `translate(0 ${+(-p * r.roll).toFixed(3)})`));
  };
  // Lamps and readings the host page sets (procedures); lamp colour from the indicator definition.
  for (const ind of def.indicators) svg.querySelectorAll<SVGGElement>(`[data-indicator="${ind.id}"]`).forEach(g => { if (ind.colour) g.dataset.colour = ind.colour; });
  // Positions the host page sets (procedures: start state, stepping back, undoing a wrong move).
  addEventListener('cockpit:set', e => {
    const { positions = {} } = (e as CustomEvent<{ positions?: Record<string, string> }>).detail;
    for (const c of def.controls) {
      const p = positions[key(c.id)];
      if (p !== undefined && p !== store[key(c.id)] && c.positions.some(x => x.id === p)) {
        store = load(def.aircraft); store[key(c.id)] = p; save(def.aircraft, store); draw(c);
      }
    }
  });
  addEventListener('cockpit:indicate', e => {
    const { lit = [], readings: values = {} } = (e as CustomEvent<{ lit?: string[]; readings?: Record<string, number> }>).detail;
    const on = new Set(lit);
    for (const ind of def.indicators) {
      if (ind.type === 'lamp') svg.querySelectorAll(`[data-indicator="${ind.id}"]`).forEach(g => g.classList.toggle('lit', on.has(key(ind.id))));
      else if (key(ind.id) in values) show(ind.id, values[key(ind.id)]);
    }
  });
  for (const input of document.querySelectorAll<HTMLInputElement>(`[data-reading^="${def.panel}."]`)) {
    const id = input.dataset.reading!.slice(def.panel.length + 1), ind = def.indicators.find(i => i.id === id);
    const out = document.querySelector(`[data-readout="${input.dataset.reading}"]`);
    input.addEventListener('input', () => {
      const v = Number(input.value);
      show(id, v);
      if (out) out.textContent = `${v.toLocaleString('en-US')} ${ind?.unit ?? ''}`;
      select(id);
    });
    // Reset puts every reading back where the page started.
    document.querySelector(`[data-cockpit-reset="${def.aircraft}"]`)?.addEventListener('click', () => {
      input.value = input.defaultValue;
      input.dispatchEvent(new Event('input'));
    });
  }
}
</script>
