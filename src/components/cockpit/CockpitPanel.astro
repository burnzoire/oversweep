    });
  }
  document.querySelector(`[data-cockpit-reset="${def.aircraft}"]`)?.addEventListener('click', () => {
    try { sessionStorage.removeItem(storeKey(def.aircraft)); } catch { /* nothing stored */ }
    store = {};
    def.controls.forEach(draw);
    say('Every control is back in its cold-and-dark position.');
  });
  def.controls.forEach(draw);

  /** Try a reading: move a needle or roll a counter (not saved; the jet stays cold and dark). */
  const show = (id: string, v: number) => {
    const r = def.readings[id];
    if (!r) return;
    if (r.kind === 'page') return;
    const all = (sel: string, f: (el: Element) => void) => svg.querySelectorAll(sel).forEach(f);
    const move = (axis: 'x' | 'y' | undefined, d: number) => all(`[data-shift="${id}"]`, el => { const e = d * Number((el as HTMLElement).dataset.k ?? 1); el.setAttribute('transform', axis === 'y' ? `translate(0 ${+e.toFixed(3)})` : `translate(${+e.toFixed(3)} 0)`); });
    const print = (s: string) => all(`[data-number="${id}"] text`, el => { el.textContent = s; });
    const roll = (c: { drums: number; fixed: number; unit: number; roll: number; still?: boolean }) => drumPositions(v, c.drums, c.fixed, c.unit, c.still).forEach((p, k) =>
      svg.querySelector(`[data-drum="${id}"][data-place="${k}"]`)?.setAttribute('transform', `translate(0 ${+(-p * c.roll).toFixed(3)})`));
    if (r.kind === 'needle') {
      all(`[data-needle="${id}"]`, el => el.setAttribute('transform', `rotate(${+scaleAngle(r.scale, v, r.turn).toFixed(3)})`));
      if (r.counter) roll(r.counter);
    }
    else if (r.kind === 'shift') move(r.axis, v * r.per);
    else if (r.kind === 'tape') { move(r.axis, v * r.per); print(formatReadout(v, r.format)); }
    else if (r.kind === 'number') print(formatReadout(v, r.format));
    else if (r.kind === 'digits') {
      const d = digitsOf(v, r.digits, !!r.tenths), texts = svg.querySelectorAll(`[data-digits="${id}"] text`);
      if (texts[0]) texts[0].textContent = d.whole;
      if (texts[1]) texts[1].textContent = d.tenth;
    }
    else roll(r);
  };
  /** Show one page of a display (DED page, HSI mode legend, screen on or off). */
  const showPage = (id: string, page: string) => {
    for (const g of svg.querySelectorAll<SVGGElement>(`[data-page-of="${id}"]`)) {
      if (g.dataset.page === page) g.removeAttribute('display'); else g.setAttribute('display', 'none');
    }
  };
  // Lamps and readings the host page sets (procedures); lamp colour from the indicator definition.
  for (const ind of def.indicators) svg.querySelectorAll<SVGGElement>(`[data-indicator="${ind.id}"]`).forEach(g => { if (ind.colour) g.dataset.colour = ind.colour; });
  // Positions the host page sets (procedures: start state, stepping back, undoing a wrong move).
  addEventListener('cockpit:set', e => {
    const { positions = {} } = (e as CustomEvent<{ positions?: Record<string, string> }>).detail;
    for (const c of def.controls) {
      const p = positions[key(c.id)];
      if (p !== undefined && p !== store[key(c.id)] && c.positions.some(x => x.id === p)) {
        store = load(def.aircraft); store[key(c.id)] = p; save(def.aircraft, store); draw(c);
      }
    }
  });
  addEventListener('cockpit:indicate', e => {
    const { lit = [], flash = [], readings: values = {}, pages = {}, cursors = {} } = (e as CustomEvent<{ lit?: string[]; flash?: string[]; readings?: Record<string, number>; pages?: Record<string, string>; cursors?: Record<string, [number, number]> }>).detail;
    const on = new Set(lit), flashing = new Set(flash);
    for (const ind of def.indicators) {
      if (ind.type === 'lamp') svg.querySelectorAll(`[data-indicator="${ind.id}"]`).forEach(g => { g.classList.toggle('lit', on.has(key(ind.id))); g.classList.toggle('flash', flashing.has(key(ind.id))); });
      else if (key(ind.id) in pages) showPage(ind.id, pages[key(ind.id)]);
      // A display's own cursor (a page's `cursor`), moved by the procedure in the page's units.
      if (key(ind.id) in cursors) {
        svg.querySelectorAll(`[data-cursor="${ind.id}"]`).forEach(g => g.setAttribute('transform', `translate(${cursors[key(ind.id)].map(v => +v.toFixed(3)).join(' ')})`));
        // A slewed sensor picture moves the other way: the seeker looks where the cursor goes.
        svg.querySelectorAll(`[data-pan="${ind.id}"]`).forEach(g => g.setAttribute('transform', `translate(${cursors[key(ind.id)].map(v => +(-v).toFixed(3)).join(' ')})`));
      }
      else if (key(ind.id) in values) show(ind.id, values[key(ind.id)]);
    }
  });
  for (const sel of document.querySelectorAll<HTMLSelectElement>(`select[data-page-reading^="${def.panel}."]`)) {
    const id = sel.dataset.pageReading!.slice(def.panel.length + 1);
    sel.addEventListener('change', () => { showPage(id, sel.value); select(id); });
    document.querySelector(`[data-cockpit-reset="${def.aircraft}"]`)?.addEventListener('click', () => {
      sel.selectedIndex = [...sel.options].findIndex(o => o.defaultSelected);
      showPage(id, sel.value);
    });
  }
  for (const input of document.querySelectorAll<HTMLInputElement>(`input[data-reading^="${def.panel}."]`)) {
    const id = input.dataset.reading!.slice(def.panel.length + 1), ind = def.indicators.find(i => i.id === id);
    const out = document.querySelector(`[data-readout="${input.dataset.reading}"]`);
    input.addEventListener('input', () => {
      const v = Number(input.value);
      show(id, v);
      if (out) out.textContent = `${v.toLocaleString('en-US')} ${ind?.unit ?? ''}`;
      select(id);
    });
    // Reset puts every reading back where the page started.
    document.querySelector(`[data-cockpit-reset="${def.aircraft}"]`)?.addEventListener('click', () => {
      input.value = input.defaultValue;
      input.dispatchEvent(new Event('input'));
    });
  }
}
</script>
