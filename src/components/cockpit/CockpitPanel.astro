---
/**
 * Interactive close-up of one assembled panel. Everything comes from the
 * panel spec: the artwork, the hit zones and the movement rules. The script
 * below is the same for every panel; it knows positions, holds, guards and
 * protections, never a panel by name.
 *
 * Control positions are kept per aircraft in sessionStorage, so they survive
 * moving between panels. The jet is cold and dark: no systems logic runs and
 * no lamp lights; selecting a lamp shows what it means.
 *
 * Procedures host several panels on one page: `scope` keeps their positions
 * apart from Cockpit Familiarization. The engine reports every move as a
 * `cockpit:change` event on window (detail: panel, control, position, phase
 * `press` or `release`) and takes `cockpit:indicate` events (detail: `lit`, the
 * `<panel>.<indicator>` ids that are on; `flash`, lit lamps that flash, about 4 a second; `readings`, values by the same ids),
 * so the procedure, not the panel, decides what lights; `pages`, page ids by
 * the same ids, switches displays such as the DED). `cockpit:set`
 * (detail: `positions` by `<panel>.<control>`) moves controls without a
 * change event.
 */
import { padControls, type AircraftCockpit, type ControlDef, type PanelSpec } from '../../data/cockpit/types';
import { hitZones, readings, renderPanel } from '../../data/cockpit/render.ts';

interface Props { cockpit: AircraftCockpit; spec: PanelSpec; scope?: string; only?: string[] }
/** `only`: show just these pads (switch cards) without the whole drawing, as a procedure step can ask for. */
const { cockpit, spec, scope, only } = Astro.props;
const [W, H] = spec.canvas;
const pct = (v: number, of: number) => `${+((v / of) * 100).toFixed(3)}%`;
const def = { aircraft: scope ? `${cockpit.id}:${scope}` : cockpit.id, panel: spec.id, controls: spec.controls, indicators: spec.indicators, readings: readings(spec) };
const control = (id: string) => spec.controls.find(c => c.id === id)!;
// Pop-out pads: a control a pad names opens the pad from the drawing instead of moving there.
const pads = spec.pads ?? [];
const padOf = new Map(pads.flatMap(p => padControls(p).map(c => [c, p] as const)));
const zones = hitZones(spec);
const art = renderPanel(spec, { label: `${cockpit.title} ${spec.title}` });
type Box = [x: number, y: number, w: number, h: number];
/** Each pad's close-up: the drawing cropped to its controls' click areas, with a margin. */
const padView = (p: (typeof pads)[number]) => {
  if (p.face) {
    const [fw, fh] = p.face.canvas;
    const hit = p.face.hit ?? [fw / 2 - 17, fh / 2 - 17, 34, 34];
    return { svg: renderPanel({ ...spec, canvas: p.face.canvas, plate: [], engraving: [], placements: p.face.placements }, {}).replace(/role="img" aria-label="[^"]*"/, 'aria-hidden="true"'), ratio: fw / fh, frame: [0, 0, fw, fh] as Box, hit };
  }
  const bs = zones.filter(z => z.kind === 'control' && padControls(p).includes(z.id)).map(z => z.box);
  const x0 = Math.min(...bs.map(b => b[0])), y0 = Math.min(...bs.map(b => b[1]));
  const x1 = Math.max(...bs.map(b => b[0] + b[2])), y1 = Math.max(...bs.map(b => b[1] + b[3]));
  const m = Math.max(10, 0.5 * Math.max(x1 - x0, y1 - y0)), w = x1 - x0 + 2 * m, h = y1 - y0 + 2 * m;
  return { frame: [x0 - m, y0 - m, w, h] as Box, hit: [x0, y0, x1 - x0, y1 - y0] as Box, svg: art.replace(/viewBox="[^"]*"/, `viewBox="${+(x0 - m).toFixed(2)} ${+(y0 - m).toFixed(2)} ${+w.toFixed(2)} ${+h.toFixed(2)}"`).replace(/role="img" aria-label="[^"]*"/, 'aria-hidden="true"'), ratio: w / h };
};
/**
 * A pad's click zones on the drawn switch, like a panel's: a four-way switch is pushed by its edge (four triangles),
 * a toggle or knob by the half it moves toward (or turns toward), a button by its cap; a centre press sits in the middle.
 */
type Zone = { box: Box; control: string; pos?: string; step?: string; shape?: 'up' | 'down' | 'left' | 'right' | 'round'; label: string };
const padZones = (p: (typeof pads)[number], hb: Box): Zone[] => {
  const [x, y, w, h] = hb, z: Zone[] = [];
  if (p.cross) for (const dir of ['up', 'down', 'left', 'right'] as const) {
    const arm = p.cross[dir];
    if (arm) z.push({ box: hb, control: arm[0], pos: arm[1], shape: dir, label: `${control(arm[0]).name}: ${posLabel(control(arm[0]), arm[1])}` });
  }
  const main = p.cross ? undefined : p.controls?.[0];
  if (main) {
    const c = control(main);
    if (c.type === 'pushbutton') z.push({ box: hb, control: c.id, pos: pressedPos(c), label: `Press ${c.name}` });
    else {
      const [a, b] = dirLabels(c.id), across = c.travel === 'horizontal' || (c.type === 'rotary' && c.travel !== 'vertical');
      z.push(across ? { box: [x, y, w / 2, h], control: c.id, step: '-1', label: a } : { box: [x, y, w, h / 2], control: c.id, step: '-1', label: a });
      z.push(across ? { box: [x + w / 2, y, w / 2, h], control: c.id, step: '1', label: b } : { box: [x, y + h / 2, w, h / 2], control: c.id, step: '1', label: b });
    }
  }
  const r = Math.min(w, h) * 0.24;
  for (const id of [...(p.centre ? [p.centre] : []), ...(p.controls ?? []).filter(id => id !== main)]) {
    z.push({ box: [x + w / 2 - r, y + h / 2 - r, 2 * r, 2 * r], control: id, pos: pressedPos(control(id)), shape: 'round', label: `Press ${control(id).name}` });
  }
  return z;
};
const shownPads = only ? pads.filter(p => only.includes(p.id)) : pads;
/**
 * A switch card shown alone (procedure step) carries the whole device beside it, with the card's switch painted
 * yellow, so the reader sees where on the grip it sits. The device is a picture only: the card is what you work.
 */
const DVS = spec.device ?? [[0, 0, W, H]];
const deviceSvg = art.replace(/role="img" aria-label="[^"]*"/, 'aria-hidden="true" focusable="false"');
/**
 * A callout points out the card's switch on the device, as a flight-manual figure does: a dot on the drawn switch
 * (the outline of its rest position, at each place it shows) and a leader line out to the right edge, toward the card.
 * A switch drawn with no outline falls back to its click areas.
 */
const drawnBox = (c: string): Box[] => {
  const out: Box[] = [];
  for (const m of art.matchAll(new RegExp(`data-move="${c}">`, 'g'))) {
    const rest = art.slice(m.index!, m.index! + 400).match(new RegExp(`<g data-pos="${control(c).initial}"[^>]*>`));
    const from = rest ? m.index! + art.slice(m.index!).indexOf(rest[0]) : m.index!;
    const d = art.slice(from, from + 200000).match(/<path d="([^"]+)" fill="var\(--panel-paper/)?.[1];
    if (!d) continue;
    const n = d.match(/-?\d+(?:\.\d+)?/g)!.map(Number), xs = n.filter((_, i) => i % 2 === 0), ys = n.filter((_, i) => i % 2 === 1);
    const x0 = Math.min(...xs), y0 = Math.min(...ys);
    out.push([x0, y0, Math.max(...xs) - x0, Math.max(...ys) - y0]);
  }
  return out;
};
/** The view the card's switch shows on (the first, if it shows on more than one), cropped, with a thick ring round it. */
const deviceView = (p: (typeof pads)[number]) => {
  const boxes = padControls(p).flatMap(c => { const d = drawnBox(c); return d.length ? d : zones.filter(z => z.kind === 'control' && z.id === c).map(z => z.box); });
  const inView = (v: Box, [x, y, w, h]: Box) => x + w / 2 >= v[0] && x + w / 2 <= v[0] + v[2] && y + h / 2 >= v[1] && y + h / 2 <= v[1] + v[3];
  const view = DVS.find(v => boxes.some(b => inView(v, b))) ?? DVS[0];
  const mine = boxes.filter(b => inView(view, b));
  const x0 = Math.min(...mine.map(b => b[0])), y0 = Math.min(...mine.map(b => b[1]));
  const x1 = Math.max(...mine.map(b => b[0] + b[2])), y1 = Math.max(...mine.map(b => b[1] + b[3]));
  // A first guess from the outlines' points; the page script re-centres it on the switch's true drawn extent.
  const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2, r = Math.max(x1 - x0, y1 - y0) / 2 + 4.5;
  const ring = mine.length ? `<g data-device-ring="${padControls(p).join(' ')}" data-view="${view.join(' ')}" fill="none" stroke="#1f6fd6" stroke-linecap="round"><circle cx="${+cx.toFixed(2)}" cy="${+cy.toFixed(2)}" r="${+r.toFixed(2)}" stroke-width="2.8"/></g>` : '';
  return { ratio: view[2] / view[3], // The view sits in a nested svg whose viewport is the view itself, so the neighbouring view is clipped off and
  // never shows in the letterbox when the half is wider than the view.
  svg: `<svg viewBox="${view.join(' ')}" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">` + deviceSvg.replace(/<svg ([^>]*?)viewBox="[^"]*"([^>]*)>/, `<svg $1x="${view[0]}" y="${view[1]}" width="${view[2]}" height="${view[3]}" viewBox="${view.join(' ')}"$2>`).replace(/<\/svg>\s*$/, ring + '</svg></svg>') };
};
// Controls whose cards stand alone (rudder pedals) are not part of the device, so they are left off it.
const offDevice = pads.filter(p => p.device === false).flatMap(padControls);
const deviceCss = (p: (typeof pads)[number]) => offDevice.length ? offDevice.map(c => `.cp-device-${spec.id}-${p.id} [data-move="${c}"]`).join(',') + '{display:none}' : '';
if (only && shownPads.length !== only.length) throw new Error(`${spec.id}: no pad ${only.filter(o => !pads.some(p => p.id === o)).join(', ')}`);
const posLabel = (c: ControlDef, p: string) => c.positions.find(x => x.id === p)?.label ?? p;
/** The position a pushbutton is pressed to (its first non-initial position). */
const pressedPos = (c: ControlDef) => c.positions.find(p => p.id !== c.initial)?.id ?? c.positions[0].id;
const dirLabels = (id: string) => {
  const c = control(id);
  if (c.type === 'rotary' && c.travel === 'vertical') return [`Roll ${c.name} up`, `Roll ${c.name} down`];
  if (c.type === 'rotary') return [`Turn ${c.name} anticlockwise`, `Turn ${c.name} clockwise`];
  if (c.travel === 'horizontal') return [`Move ${c.name} left`, `Move ${c.name} right`];
  return [`Move ${c.name} up`, `Move ${c.name} down`];
};
---
<div class:list={['cockpit-panel', only && 'cp-cards']} data-cockpit-panel data-cards={only ? '' : undefined} style={`--ratio:${W / H}` + (W / H < 0.6 ? ';--cp-height:52rem' : '')}>
  <div class="cp-stage" hidden={!!only}>
    <Fragment set:html={art} />
    {zones.map(z => {
      const style = `left:${pct(z.box[0], W)};top:${pct(z.box[1], H)};width:${pct(z.box[2], W)};height:${pct(z.box[3], H)}` + (z.rotate ? `;transform:rotate(${z.rotate}deg)` : '');
      if (z.kind === 'indicator') {
        const ind = spec.indicators.find(i => i.id === z.id)!;
        return <button type="button" class:list={['cp-hit', 'cp-lamp', z.round && 'cp-round']} style={style} data-select={z.id} aria-label={`${ind.name}: what it shows`}></button>;
      }
      const c = control(z.id);
      const pad = padOf.get(c.id);
      if (pad) return <button type="button" class:list={['cp-hit', z.round && 'cp-round']} style={style} data-open-pad={pad.id} data-pad-hit={c.id} aria-label={`${c.name}: open the ${pad.name} controls`} aria-expanded="false"></button>;
      if (c.type === 'toggle' || c.type === 'rotary') {
        const [a, b] = dirLabels(c.id);
        const axis = c.travel === 'horizontal' || (c.type === 'rotary' && c.travel !== 'vertical') ? 'cp-x' : 'cp-y';
        return (
          <div class:list={['cp-hit', axis, z.round && 'cp-round']} style={style} role="group" aria-label={c.name} data-hit-of={z.pos ? c.id : undefined} data-hit-pos={z.pos} hidden={z.pos ? z.pos !== c.initial : undefined}>
            <button type="button" data-control={c.id} data-dir="-1" aria-label={a}></button>
            <button type="button" data-control={c.id} data-dir="1" aria-label={b}></button>
          </div>
        );
      }
      const verb = c.type === 'guard' ? `Open or close the ${c.name}` : `Press ${c.name}`;
      return <button type="button" class:list={['cp-hit', z.round && 'cp-round']} style={style} data-control={c.id} data-dir="flip" aria-label={verb}></button>;
    })}
  </div>
  {shownPads.length > 0 && (
    <div class="cp-pads">
      {shownPads.map(p => { const v = padView(p); return (
        <section class="cp-pad" data-pad={p.id} hidden={!only} aria-label={p.name}>
          <header class="cp-pad-head"><strong>{p.name}</strong>{!only && <button type="button" class="cp-pad-close" data-pad-close aria-label={`Close the ${p.name} controls`}>Close</button>}</header>
          <div class:list={[only && p.device !== false && 'cp-split']}>
          {only && p.device !== false && <figure class:list={['cp-device', `cp-device-${spec.id}-${p.id}`]}><Fragment set:html={`<style>${deviceCss(p)}</style>${deviceView(p).svg}`} /></figure>}
          <div class="cp-zoom" style={`aspect-ratio:${v.ratio}`}><Fragment set:html={v.svg} />
            {padZones(p, v.hit).map(z => {
              const [fx, fy, fw, fh] = v.frame;
              const style = `left:${pct(z.box[0] - fx, fw)};top:${pct(z.box[1] - fy, fh)};width:${pct(z.box[2], fw)};height:${pct(z.box[3], fh)}`;
              return <button type="button" class:list={['cp-zone', z.shape && `cp-zone-${z.shape}`]} style={style} data-pad-control={z.control} data-pad-pos={z.pos} data-pad-step={z.step} aria-label={z.label}></button>;
            })}
            {p.analog && p.cross && (() => {
              // An analog hat works like an on-screen joystick: press and drag to deflect it, a short click presses it.
              const [fx, fy, fw, fh] = v.frame, b = v.hit;
              const style = `left:${pct(b[0] - fx, fw)};top:${pct(b[1] - fy, fh)};width:${pct(b[2], fw)};height:${pct(b[3], fh)}`;
              return <div class="cp-joystick" style={style} data-joystick={JSON.stringify({ pad: p.id, cross: p.cross, centre: p.centre })} aria-hidden="true"><span class="cp-joy-knob" hidden></span></div>;
            })()}
          </div>
          </div>
          {(p.controls ?? []).filter(id => control(id).type === 'rotary').map(id => <p class="cp-readout"><output data-position-of={`${spec.id}.${id}`}></output></p>)}
        </section>
      ); })}
    </div>
  )}
  <p class="cp-status" role="status" aria-live="polite" data-cp-status></p>
  <script type="application/json" data-cockpit-def set:html={JSON.stringify(def)} />
</div>

<style>
.cockpit-panel{max-width:min(100%,calc(var(--cp-height,34rem) * var(--ratio)))}
.cp-stage{position:relative;aspect-ratio:var(--ratio);background:var(--panel-paper);user-select:none;-webkit-user-select:none;touch-action:manipulation}
.cp-stage :global(svg){display:block;width:100%;height:100%}
.cp-stage :global(.lens){fill:transparent}
.cp-stage :global([data-indicator].lit[data-colour="amber"] .lens){fill:var(--panel-lit-amber)}
.cp-stage :global([data-indicator].lit[data-colour="green"] .lens){fill:var(--panel-lit-green)}
.cp-stage :global([data-indicator].lit[data-colour="red"] .lens){fill:var(--panel-lit-red)}
.cp-stage :global([data-indicator].lit[data-colour="blue"] .lens){fill:var(--panel-lit-blue)}
.cp-stage :global([data-indicator].lit.flash .lens){animation:cp-flash .25s steps(1,end) infinite}
@keyframes cp-flash{50%{fill:transparent}}
@media (prefers-reduced-motion:reduce){.cp-stage :global([data-indicator].lit.flash .lens){animation-duration:1s}}
.cp-stage :global([data-indicator].selected:not(.lit) .lens){fill:color-mix(in srgb,var(--color-focus) 14%,transparent)}
.cp-stage :global([data-indicator].selected .lens){stroke:var(--color-focus);stroke-width:.5}
.cp-stage :global([data-indicator].selected > [data-needle] > path:first-child){stroke:var(--color-focus);stroke-width:.6}
.cp-hit{position:absolute;margin:0;padding:0;border:0;background:transparent;cursor:pointer;border-radius:8%;overflow:hidden}
.cp-round{border-radius:50%}
.cp-hit > button{position:absolute;margin:0;padding:0;border:0;background:transparent;cursor:pointer}
.cp-y > button{left:0;width:100%;height:50%}
.cp-y > button:first-child{top:0}
.cp-y > button:last-child{bottom:0}
.cp-x > button{top:0;height:100%;width:50%}
.cp-x > button:first-child{left:0}
.cp-x > button:last-child{right:0}
.cp-hit:focus-visible,.cp-hit > button:focus-visible{outline:2px solid var(--color-focus,#005fcc);outline-offset:1px}
@media(hover:hover){.cp-hit:hover,.cp-hit > button:hover{background:color-mix(in srgb,var(--color-focus) 8%,transparent)}}
.cp-pad{margin-top:.6rem;border:1px solid var(--panel-ink);border-top-width:3px;padding:.6rem .7rem .8rem;background:var(--panel-paper)}
.cp-pad[hidden],.cp-stage[hidden]{display:none}
.cp-cards{max-width:100%}
.cp-cards .cp-pads{display:flex;flex-wrap:wrap;gap:.75rem}
.cp-cards .cp-pad{flex:1 1 20rem;margin-top:0}
.cp-zoom{max-height:14rem;margin:0 auto .5rem;max-width:100%}
.cp-zoom :global(svg){display:block;width:100%;height:100%}
.cp-pad-head{display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.5rem}
.cp-pad-close{font:inherit;font-size:.9rem;border:1px solid var(--color-border,#999);background:var(--panel-paper);padding:.2rem .6rem;cursor:pointer}
.cp-zoom{position:relative}
.cp-split{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:.6rem;align-items:center}
.cp-split .cp-zoom{margin:0;width:100%}
.cp-device{margin:0;height:14rem;max-height:55vw;border-right:1px solid var(--color-border,#ccc)}
.cp-device > :global(svg){display:block;width:100%;height:100%}
.cp-device :global(text){display:none}
.cp-split :global(.cp-leader){position:absolute;background:#1f6fd6;border-radius:0 2px 2px 0;transform:translateY(-50%);pointer-events:none}
.cp-zone{position:absolute;padding:0;margin:0;border:0;background:transparent;cursor:pointer;touch-action:manipulation;user-select:none;-webkit-user-select:none}
.cp-zone-up{clip-path:polygon(0 0,100% 0,50% 50%)}.cp-zone-down{clip-path:polygon(0 100%,100% 100%,50% 50%)}
.cp-zone-left{clip-path:polygon(0 0,0 100%,50% 50%)}.cp-zone-right{clip-path:polygon(100% 0,100% 100%,50% 50%)}
.cp-zone-round{border-radius:50%}
.cp-zone:hover,.cp-zone:focus-visible{background:color-mix(in srgb,var(--color-focus) 14%,transparent)}
.cp-zone:focus-visible{outline:2px solid var(--color-focus,#005fcc);outline-offset:-2px}
.cp-zone.cp-target{background:rgba(230,184,0,.45);animation:cp-target 1s ease-in-out 4}
@keyframes cp-target{50%{background:rgba(230,184,0,.12)}}
@media(prefers-reduced-motion:reduce){.cp-zone.cp-target{animation:none}}
.cp-pad-close:focus-visible{outline:2px solid var(--color-focus,#005fcc);outline-offset:2px}
.cp-readout{text-align:center;margin:0 0 .3rem}
.cp-joystick{position:absolute;touch-action:none;cursor:grab;user-select:none;-webkit-user-select:none}
.cp-joystick.held{cursor:grabbing}
.cp-joy-knob{position:absolute;left:50%;top:50%;width:34%;height:34%;margin:-17% 0 0 -17%;border-radius:50%;background:rgba(0,95,204,.28);border:2px solid rgba(0,95,204,.8);pointer-events:none}
.cp-status{min-height:1.6em;margin:.4rem 0 0;font-size:.95rem;color:var(--color-muted,#595959)}
</style>

<script>
import type { ControlDef, IndicatorDef } from '../../data/cockpit/types';
import type { Reading } from '../../data/cockpit/render.ts';
import { drumPositions, scaleAngle } from '../../data/cockpit/dial.ts';
import { formatReadout } from '../../data/cockpit/readout.ts';

/** Readout digits (kept in step with readoutDigits in render.ts). */
const digitsOf = (v: number, digits: number, tenths: boolean) => {
  const t = Math.round(Math.max(0, v) * (tenths ? 10 : 1)), whole = tenths ? Math.floor(t / 10) : t;
  return { whole: String(whole % 10 ** digits).padStart(digits, '0'), tenth: tenths ? String(t % 10) : '' };
};

interface Def { aircraft: string; panel: string; controls: ControlDef[]; indicators: IndicatorDef[]; readings: Record<string, Reading> }
const storeKey = (aircraft: string) => `oversweep:cockpit:${aircraft}`;
const load = (aircraft: string): Record<string, string> => {
  try { return JSON.parse(sessionStorage.getItem(storeKey(aircraft)) ?? '{}') ?? {}; } catch { return {}; }
};
const save = (aircraft: string, s: Record<string, string>) => {
  try { sessionStorage.setItem(storeKey(aircraft), JSON.stringify(s)); } catch { /* storage unavailable: state lasts for this page only */ }
};

// Centre each device ring on its switch as drawn (true geometry, not the outline's control points), and run its
// leader line from the ring out to the view's right edge, at the divider beside the card.
for (const g of document.querySelectorAll<SVGGElement>('[data-device-ring]')) {
  const fit = () => {
    const parts = g.dataset.deviceRing!.split(' ').flatMap(c => [...g.ownerSVGElement!.querySelectorAll<SVGGraphicsElement>(`[data-move="${c}"] > [data-pos]:not([display="none"])`)]);
    const [vx, vy, vw, vh] = g.dataset.view!.split(' ').map(Number);
    const boxes = parts.map(e => e.getBBox()).filter(b => b.width && b.x + b.width / 2 >= vx && b.x + b.width / 2 <= vx + vw && b.y + b.height / 2 >= vy && b.y + b.height / 2 <= vy + vh);
    if (!boxes.length) return;
    const x0 = Math.min(...boxes.map(b => b.x)), y0 = Math.min(...boxes.map(b => b.y)), x1 = Math.max(...boxes.map(b => b.x + b.width)), y1 = Math.max(...boxes.map(b => b.y + b.height));
    const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2, r = Math.max(x1 - x0, y1 - y0) / 2 + 4.5;
    const c = g.querySelector('circle')!;
    c.setAttribute('cx', cx.toFixed(2)); c.setAttribute('cy', cy.toFixed(2)); c.setAttribute('r', r.toFixed(2));
    // The leader runs from the ring, across the divider, to the switch on the card.
    const split = g.closest<HTMLElement>('.cp-split');
    const faces = [...(split?.querySelectorAll('.cp-zoom [data-move] > [data-pos]:not([display="none"])') ?? [])].map(e => e.getBoundingClientRect()).filter(b => b.width);
    if (!split || !faces.length) return;
    const s = split.getBoundingClientRect(), ring = c.getBoundingClientRect(), k = g.ownerSVGElement!.getScreenCTM()?.a ?? 1;
    let lead = split.querySelector<HTMLElement>('.cp-leader');
