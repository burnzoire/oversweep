---
import { termSense } from '../data/links';
// A module's terms list, rendered from the Terminology glossary so each
// definition is written once. An item is a glossary word, or { id, label, set }
// to show it under another label or pick one set's meaning (`usage` picks
// between two meanings in one set). An item the
// glossary cannot source yet gives its own { label, meaning } and stays unlinked.
// Every listed word links to its entry, even if the page's prose linked it
// earlier; the list is an index, not a mention.
type Item = string | { id: string; label?: string; set?: string; usage?: string } | { label: string; meaning: string };
interface Props { items: Item[] }
const rows = Astro.props.items.map((item) => {
  const [label, sense] = typeof item === 'string' ? [item, termSense(item)]
    : 'meaning' in item ? [item.label, { href: undefined, expansion: undefined, definition: item.meaning }]
    : [item.label ?? item.id, termSense(item.id, item.set, item.usage)];
  // An abbreviation's expansion leads its definition unless the label already spells it out.
  const lead = sense.expansion && !label.toLowerCase().includes(sense.expansion.toLowerCase()) ? `${sense.expansion}. ` : '';
  return { label, href: sense.href, definition: lead + sense.definition };
});
---
<dl class="jargon">
  {rows.map((row) => (
    <div><dt>{row.href ? <a class="term-list-link" href={row.href} set:html={row.label} /> : <Fragment set:html={row.label} />}</dt><dd>{row.definition}</dd></div>
  ))}
</dl>
