---
import Self from "./MenuCards.astro";
import EntryCard from "./EntryCard.astro";
import { manualEntries } from "../data/availability";
import { sitePath } from "../lib/paths";

const entryById = new Map(manualEntries.map((entry) => [entry.id, entry]));
import type { MenuNode } from "../data/manual-menu";

// A landing page mirrors the menu. Items with a page of their own are cards;
// a plain group (no page, only a heading in the menu) is a labelled row holding
// its own items, so groups never need pages. Unwritten items are grey.
interface Props { node: MenuNode; level?: 2 | 3 }
const { node, level = 2 } = Astro.props;
// A group's explanatory page is its "Overview" leaf; a group that has one shows as a card for it.
const overview = (n: MenuNode) => n.children?.find((c) => c.id.endsWith("overview") && c.href && !c.planned);
const isGroup = (n: MenuNode) => !n.href && !n.planned && (n.children?.length ?? 0) > 0 && !overview(n);
const target = (n: MenuNode) => (n.href && !n.planned ? n.href : overview(n)?.href);
const blurb = (n: MenuNode) => n.summary ?? overview(n)?.summary;
// Keep the menu's order: runs of cards share a grid, each group is its own row.
type Segment = { cards: MenuNode[] } | { group: MenuNode };
const segments = (node.children ?? []).reduce<Segment[]>((acc, c) => {
  if (isGroup(c)) return [...acc, { group: c }];
  const last = acc[acc.length - 1];
  if (last && "cards" in last) { last.cards.push(c); return acc; }
  return [...acc, { cards: [c] }];
}, []);
const Heading = (level === 2 ? "h2" : "h3") as "h2" | "h3";
---
{segments.map((seg) => "group" in seg ? (
  <section class="subject-group" aria-labelledby={`card-${seg.group.id}`}>
    <Heading id={`card-${seg.group.id}`}>{seg.group.title}</Heading>
    <Self node={seg.group} level={3} />
  </section>
) : (
  <div class="entry-grid menu-cards">
    {seg.cards.map((c) => entryById.get(c.id) && !c.planned ? (
      <EntryCard entry={entryById.get(c.id)!} headingLevel={(level + 1) as 3 | 4} compact />
    ) : (
      <article class:list={["entry-card", "compact", { "card-unwritten": c.planned }]}>
        <h3 class="entry-title">{target(c) ? <a href={sitePath(target(c)!)}>{c.title}</a> : <span>{c.title}</span>}</h3>
        {blurb(c) && <p class="entry-objective">{blurb(c)}</p>}
        {c.planned && <p class="entry-objective">Not written yet.</p>}
      </article>
    ))}
  </div>
))}
