---
// Card art: Emergency procedures, close up: a guarded emergency jettison button inside caution stripes.
---
<svg class="card-art" viewBox="0 0 320 180" role="img" aria-labelledby="art-jettisonbutton-t">
  <title id="art-jettisonbutton-t">An emergency jettison button inside a yellow and black caution-striped border.</title>
  <rect class="frame" x="0.5" y="0.5" width="319" height="179" />
  <defs><pattern id="art-jett-stripes" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect class="stripe-a" width="14" height="14" /><rect class="stripe-b" width="7" height="14" /></pattern></defs>
  <rect class="caution" x="100" y="22" width="120" height="136" rx="4" />
  <rect class="ship" x="114" y="36" width="92" height="108" rx="3" />
  <rect class="button-face" x="126" y="52" width="68" height="76" rx="8" />
  <text class="btn" x="160" y="86">EMER</text>
  <text class="btn" x="160" y="106">JETT</text>
</svg>
