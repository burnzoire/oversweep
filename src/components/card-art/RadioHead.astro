---
// Generic military UHF communications radio control head, stylised technical
// faceplate. The labels are tuning modes, not unrelated avionics functions.
---
<svg class="card-art" viewBox="0 0 320 180" role="img" aria-labelledby="art-radiohead-t">
  <title id="art-radiohead-t">Military UHF communications radio with a 251.000 MHz display, tuning knobs and preset controls.</title>
  <rect class="frame" x=".5" y=".5" width="319" height="179"/>
  <rect class="panel" x="37" y="32" width="246" height="116" rx="8"/>
  <g class="fastener"><circle cx="47" cy="42" r="3"/><circle cx="273" cy="42" r="3"/><circle cx="47" cy="138" r="3"/><circle cx="273" cy="138" r="3"/></g>
  <rect class="screen-dark" x="53" y="49" width="167" height="49" rx="4"/>
  <text class="lcd" x="136.5" y="83">251.000</text>
  <g class="knob" transform="translate(251 70)"><circle r="19"/><circle r="13"/><path d="M0 -13 V-6"/></g>
  <g class="knob" transform="translate(251 121)"><circle r="12"/><circle r="7"/><path d="M0 -8 V-4"/></g>
  <g class="control-buttons">
    <rect class="selected-button" x="53" y="111" width="30" height="23" rx="3"/>
    <rect x="87" y="111" width="30" height="23" rx="3"/>
    <rect x="121" y="111" width="30" height="23" rx="3"/>
    <rect x="155" y="111" width="30" height="23" rx="3"/>
    <rect x="189" y="111" width="30" height="23" rx="3"/>
  </g>
  <g class="tiny-label"><text x="68" y="126">PRE</text><text x="102" y="126">MAN</text><text x="136" y="126">GRD</text><text x="170" y="126">SQL</text><text x="204" y="126">TEST</text></g>
</svg>
