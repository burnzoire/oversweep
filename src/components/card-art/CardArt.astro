---
import CaseIiiMarshal from './CaseIiiMarshal.astro';
import BfmCircles from './BfmCircles.astro';
import RadioHead from './RadioHead.astro';
import FixedWingAoa from './FixedWingAoa.astro';
import RotorDisc from './RotorDisc.astro';
import RunwayPapi from './RunwayPapi.astro';
import TacanHsi from './TacanHsi.astro';
import AttitudeIndicator from './AttitudeIndicator.astro';
import ApproachPlan from './ApproachPlan.astro';
import IlsNeedles from './IlsNeedles.astro';
import RouteCard from './RouteCard.astro';
import TakeoffClimb from './TakeoffClimb.astro';
import TwoShipParade from './TwoShipParade.astro';
import HelicopterStagger from './HelicopterStagger.astro';
import FingerFour from './FingerFour.astro';
import ProbeDrogue from './ProbeDrogue.astro';
import DiveDelivery from './DiveDelivery.astro';
import CasRunIn from './CasRunIn.astro';
import PodView from './PodView.astro';
import MaskedHover from './MaskedHover.astro';
import Sa2Site from './Sa2Site.astro';
import AngledDeck from './AngledDeck.astro';
import CollisionCourse from './CollisionCourse.astro';
import RwrScope from './RwrScope.astro';
import Bullseye from './Bullseye.astro';
import JettisonButton from './JettisonButton.astro';
import Autorotation from './Autorotation.astro';
import HoldShort from './HoldShort.astro';

// Card illustrations for Manual and Training Library cards, keyed by the
// module or experience id the card is built from (Entry.id). Renders nothing
// for an entry without one. See docs/card-art.md for the drawing conventions.
const art: Record<string, typeof CaseIiiMarshal> = {
  'experience.case-iii-tomcat': CaseIiiMarshal,
  'module.bfm': BfmCircles,
  'module.radio-procedures': RadioHead,
  'module.principles-of-flight': FixedWingAoa,
  'module.rotor-wing': RotorDisc,
  'module.airfield-basics': RunwayPapi,
  'module.air-navigation': TacanHsi,
  'module.attitude-instrument-flying': AttitudeIndicator,
  'module.instrument-procedures': ApproachPlan,
  'experience.instrument-trainer': IlsNeedles,
  'module.sortie-planning': RouteCard,
  'module.weather-and-performance': TakeoffClimb,
  'module.two-ship-formation': TwoShipParade,
  'module.helicopter-formation': HelicopterStagger,
  'module.four-ship-formation': FingerFour,
  'module.aar-procedures': ProbeDrogue,
  'module.weapons-delivery': DiveDelivery,
  'module.close-air-support': CasRunIn,
  'module.precision-targeting': PodView,
  'module.rotary-wing-attack': MaskedHover,
  'module.sead-dead': Sa2Site,
  'module.ship-operations': AngledDeck,
  'module.bvr-intercepts': CollisionCourse,
  'module.radar-and-warning': RwrScope,
  'module.situational-awareness': Bullseye,
  'module.emergency-procedures': JettisonButton,
  'experience.autorotation': Autorotation,
  'experience.radio-trainer': HoldShort,
};
const Art = art[Astro.props.id as string];
---
{Art && <div class="entry-art"><Art /></div>}
