  <rect class="frame" x="0.5" y="0.5" width="319" height="179" />
  <path class="ln" d="M14 150 H306" />
  <path class="ln heavy" d="M40 30 L150 95" />
  <path class="ln dashed" d="M150 95 C178 112 200 104 222 72" />
