---
// Card art: one radio exchange, close up: the call, the controller's reply
// and the readback, as in the module's "One exchange, start to finish".
const jet = 'M0 -11 L2 -5 L2 -2 L9 3 L9 5 L2 3 L2 7 L4 10 L4 11 L0 10 L-4 11 L-4 10 L-2 7 L-2 3 L-9 5 L-9 3 L-2 -2 L-2 -5 Z';
---
<svg class="card-art" viewBox="0 0 320 180" role="img" aria-labelledby="art-radio-t">
  <title id="art-radio-t">One radio exchange between an aircraft and the control tower: the call, the reply and the readback.</title>
  <rect class="frame" x="0.5" y="0.5" width="319" height="179" />
  <path class="jet" d={jet} transform="translate(62 90) rotate(90) scale(1.5)" />
  <g class="tower">
    <path d="M240 58 L280 58 L274 78 L246 78 Z" />
    <path d="M252 78 L252 128 M268 78 L268 128 M238 128 L282 128 M260 58 L260 44" />
  </g>
  <path class="ln" d="M96 66 L220 66 m-9 -5 l9 5 l-9 5" />
  <path class="ln muted" d="M220 90 L96 90 m9 -5 l-9 5 l9 5" />
  <path class="ln" d="M96 114 L220 114 m-9 -5 l9 5 l-9 5" />
</svg>
