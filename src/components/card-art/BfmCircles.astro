  <title id="art-bfm-t">Plan view of two-circle flow: after the pass each aircraft turns on its own circle in the same direction, nose-to-tail.</title>
  <rect class="frame" x="0.5" y="0.5" width="319" height="179" />
  <circle class="ln dashed" cx="115" cy="90" r="45" />
  <circle class="ln" cx="205" cy="90" r="45" />
  <path class="ln" d="M115 45 l-9 -5 M115 45 l-9 5" />
  <path class="ln" d="M205 135 l9 -5 M205 135 l9 5" />
  <path class="jet" d={jet} transform="translate(165.7 68) rotate(29) scale(1.25)" />
  <path class="jet muted" d={jet} transform="translate(154.3 112) rotate(-151) scale(1.25)" />
</svg>
