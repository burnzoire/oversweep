---
// Card art (flat technical style, see docs/card-art.md): attitude indicator in a gentle right bank with the nose a few degrees up: sky and
// ground halves, horizon, pitch ladder, bank scale and the fixed aircraft symbol.
---
<svg class="card-art" viewBox="0 0 320 180" role="img" aria-labelledby="art-attitudeindicator-t">
  <title id="art-attitudeindicator-t">An attitude indicator in a gentle right bank with the nose slightly above the horizon.</title>
  <rect class="frame" x="0.5" y="0.5" width="319" height="179" />
  <rect class="panel" x="78" y="8" width="164" height="164" rx="10" /><g class="fastener"><circle cx="87" cy="17" r="3" /><circle cx="233" cy="17" r="3" /><circle cx="87" cy="163" r="3" /><circle cx="233" cy="163" r="3" /></g>
  <circle class="face" cx="160" cy="90" r="72" />
