  <path class="accent-fill" d="M118 88 H146 L153 96 L160 89 L167 96 L174 88 H202 V92 H176 L167 101 L160 94 L153 101 L144 92 H118 Z" />
  <circle class="accent-fill" cx="160" cy="90" r="2.6" />
</svg>
