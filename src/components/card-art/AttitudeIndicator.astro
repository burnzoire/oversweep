  <g clip-path="url(#art-ai-clip)"><g transform="rotate(-15 160 90)">
    <rect class="sky" x="80" y="10" width="160" height="88" />
    <rect class="earth" x="80" y="98" width="160" height="80" />
    <path class="line-w heavy" d="M80 98 H240" />
