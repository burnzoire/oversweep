  <rect class="frame" x="0.5" y="0.5" width="319" height="179" />
  <rect class="ship" x="0" y="22" width="320" height="34" />
  <path class="ln thin" d="M20 39 H44 M70 39 H94 M120 39 H144 M176 39 H200 M226 39 H250 M276 39 H300" />
  <path class="ln" d="M142 56 V180 M178 56 V180" />
  <path class="ln thin dashed" d="M142 66 H178 M142 72 H178" />
  <path class="ln thin" d="M142 80 H178 M142 86 H178" />
