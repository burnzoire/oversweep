---
import Self from "./MenuBranch.astro";
import { containsRoute, hasArticle, type MenuNode } from "../data/manual-menu";
import { assetPath, sitePath } from "../lib/paths";

// One level of the Manual menu. Siblings share the <details> name, so opening
// one closes the others in the browser, with no script.
interface Props { nodes: MenuNode[]; route: string; parent: string; depth?: number }
const { nodes, route, parent, depth = 0 } = Astro.props;
const link = (node: MenuNode) => (node.href && (node.children?.length || !node.planned) ? sitePath(node.href) : undefined);
---

<ul class="menu-tree" data-depth={depth}>
  {nodes.map((node) => {
    const url = link(node);
    const current = node.href === route;\n    const empty = !!node.children?.length && !hasArticle(node);
    const label = url
      ? <a href={url} aria-current={current ? "page" : undefined} class:list={{ current, unwritten: empty }}>{node.title}</a>
      : <span class:list={{ unwritten: node.planned || empty }}>{node.title}{node.planned && <span class="visually-hidden"> (not written yet)</span>}</span>;
    return node.children?.length || node.lazy ? (
      <li class:list={{ unwritten: node.planned }}>
        <details name={parent} open={containsRoute(node, route)} data-lazy={node.lazy ? assetPath(node.lazy) : undefined}>
          <summary>
            <span class="chev" aria-hidden="true"></span>
            {label}
          </summary>
          <Self nodes={node.children ?? []} route={route} parent={node.id} depth={depth + 1} />
        </details>
      </li>
    ) : (
      <li class:list={{ unwritten: node.planned }}>{label}</li>
    );
  })}
</ul>
