---
import EntryCard from "./EntryCard.astro";
import { manualEntries } from "../data/availability";
import { sitePath } from "../lib/paths";
import { cardMedia } from "../data/card-media";
import CardPhoto from "./card-photo/CardPhoto.astro";
import { hasArticle, type MenuNode } from "../data/manual-menu";

// The list on a group's landing page: one card per direct child, whether it is a
// group (its own landing page) or a leaf. Empty groups link; unwritten leaves do not.
interface Props { node: MenuNode; list?: boolean }
const { node, list = false } = Astro.props;
const entryById = new Map(manualEntries.map((entry) => [entry.id, entry]));
const children = node.children ?? [];
---
{list ? (
  <ul class="group-links">
    {children.map((child) => {
      const unwritten = child.children ? !hasArticle(child) : child.planned;
      return (
        <li class:list={{ unwritten }}>
          {child.href && (child.children || !child.planned)
            ? <a href={sitePath(child.href)}>{child.title}</a>
            : <>{child.title}<span class="visually-hidden"> (not written yet)</span></>}
        </li>
      );
    })}
  </ul>
) : (<div class="entry-grid">
  {children.map((c) => {
    const entry = !c.planned && entryById.get(c.id);
    const unwritten = c.children ? !hasArticle(c) : c.planned;
    return entry ? <EntryCard entry={entry} headingLevel={2} compact /> : (
      <article class:list={["entry-card", "compact", { "card-unwritten": unwritten }]}>
        <CardPhoto id={c.id} />
        <h2 class="entry-title">{c.href && (c.children || !c.planned) ? <a href={sitePath(c.href)}>{c.title}</a> : <span>{c.title}</span>}</h2>
        {(cardMedia[c.id]?.summary ?? c.summary) && <p class="entry-objective">{cardMedia[c.id]?.summary ?? c.summary}</p>}
        {(unwritten) && <p class="entry-objective">Not written yet.</p>}
      </article>
    );
  })}
</div>)}

<style>
  .group-links:empty { display: none; }
  .group-links li { margin-block: 0.35rem; }
  .group-links .unwritten, .group-links .unwritten a { color: var(--color-unavailable); }
</style>
