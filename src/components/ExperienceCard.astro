---
import { experienceRoute, type Experience } from '../data/experiences';
import { sitePath } from '../lib/paths';
interface Props { experience: Experience }
const { experience } = Astro.props;
---
<section class="status-panel" data-experience-id={experience.id} data-experience-revision={experience.revision}>
  <h2>{experience.title}</h2>
  <p><strong>{experience.maturity}</strong>{experience.publication !== 'published' && ' · Local review only'} · Revision {experience.revision}</p>
  <p>{experience.objective}</p>
  <p>{experience.applicability}</p>
  <a href={sitePath(experienceRoute(experience))}>Open the trainer and scope notes →</a>
</section>
