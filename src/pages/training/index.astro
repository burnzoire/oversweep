---
import EntryCard from "../../components/EntryCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { manualEntries } from "../../data/availability";
import { sitePath } from "../../lib/paths";

const exercises = manualEntries.filter((entry) => entry.trainer);
---

<SiteLayout title="Training Library" activeSection="training" isSectionIndex empty={exercises.length === 0}>
  {exercises.length > 0 ? (
    <>
      <p class="lead">Standalone exercises for practising what a Manual module teaches. Each opens in its own window; read its module first for the background.</p>
      {exercises.map((entry) => <EntryCard entry={entry} focus="trainer" showSubject />)}
    </>
  ) : (
    <p class="empty-note">No exercises are published yet. Start with the <a href={sitePath("manual/")}>Manual</a> instead.</p>
  )}
</SiteLayout>
