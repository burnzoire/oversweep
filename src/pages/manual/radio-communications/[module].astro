// page, [3] CNATRA P-1289 page. Supplementary FAA sources: [4] AIM paragraph,
// [5] Pilot/Controller Glossary term.
const pp = (n: number) => (page: string) => `[${n}, ${page.includes('–') || page.includes(',') ? 'pp.' : 'p.'} ${page}]`;
