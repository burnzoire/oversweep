  'Holding pattern', 'EFC', 'Penetration turn', 'Final approach fix', 'Stepdown fix', 'Visual descent point',
  'Minimum descent altitude', 'Decision altitude', 'Missed approach point', 'Touchdown zone elevation', 'Minimum safe altitude', 'ASR', 'PAR',
  'No-gyro approach', 'Diverse departure',
