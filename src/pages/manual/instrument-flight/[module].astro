---
import AttitudeFlying from './_AttitudeFlying.astro';
import InstrumentProcedures from './_InstrumentProcedures.astro';
import { includedModules } from '../../../data/modules';
// Instrument Flight has one page per module, each its own component kept
// beside this route so the SME review reads it (the underscore keeps Astro
// from routing it). This route emits only the modules the registry includes.
const pages = { 'attitude-instrument-flying': AttitudeFlying, 'instrument-procedures': InstrumentProcedures };
export function getStaticPaths() {
  return includedModules.filter((m) => m.subject === 'instrument-flight').map((m) => ({ params: { module: m.slug } }));
}
const { module } = Astro.params;
const Page = pages[module as keyof typeof pages];
if (!Page) throw new Error(`No Instrument Flight page for module ${module}`);
---
<Page />
