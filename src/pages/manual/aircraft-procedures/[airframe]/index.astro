---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import {airframes,visibleProcedures,procedureRoute} from '../../../../data/aircraft-procedures';
import {sitePath} from '../../../../lib/paths';
export function getStaticPaths(){return airframes.filter(a=>visibleProcedures.some(p=>p.airframe===a.slug)).map(a=>({params:{airframe:a.slug},props:{airframe:a}}))}
const {airframe}=Astro.props;
const guides=visibleProcedures.filter(p=>p.airframe===airframe.slug);
---
<SiteLayout title={airframe.title} activeSection="manual" activeSubject="aircraft-procedures"
 breadcrumbs={[{label:'Manual',href:sitePath('manual/')},{label:'Aircraft Procedures',href:sitePath('manual/aircraft-procedures/')},{label:airframe.title}]}>
  <p class="lead">Aircraft-specific cockpit procedures for the simulator, in the order you need to perform them.</p>
  <p class="status-panel">Public preview. Simulator validation is pending.</p>
  <ul class="subject-list">{guides.map(p=><li><a href={sitePath(procedureRoute(p))}>{p.slug === 'engine-start' ? 'Start engine exercise' : p.title}</a> — {p.objective}</li>)}</ul>
</SiteLayout>
