---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import CockpitPanel from '../../../../components/cockpit/CockpitPanel.astro';
import {visibleProcedures, procedureRoute, sourceUrl, type AircraftProcedure} from '../../../../data/aircraft-procedures';
import {cockpits, builtPanels, panelRoute} from '../../../../data/cockpit/f16c/index.ts';
import {sitePath} from '../../../../lib/paths';
import {includedRecords, recordRoute} from '../../../../data/encyclopedia';
import {termTarget, recordTarget, termMarkup} from '../../../../data/links';
export function getStaticPaths() {
  return visibleProcedures.map(p=>({params:{airframe:p.airframe,procedure:p.slug},props:{guide:p}}));
}
const {guide} = Astro.props as {guide:AircraftProcedure};
const steps = guide.steps;
const nextGuide = guide.next ? visibleProcedures.find(p => p.airframe === guide.airframe && p.slug === guide.next) : undefined;
// The procedure runs on the shared cockpit panels (Cockpit Familiarization), kept in their own scope.
const cockpit = cockpits.find(c => c.airframe === guide.airframe)!;
const built = new Map(builtPanels(cockpit).map(b => [b.panel.id, b]));
// A step can show a whole panel (`stick`) or just some of its switch cards (`stick:tms+dms`).
const used = [...new Set(steps.flatMap(s => s.panels))];
const baseOf = (entry: string) => entry.split(':')[0];
const cardsOf = (entry: string) => entry.includes(':') ? entry.split(':')[1].split('+') : undefined;
const usedPanels = [...new Set(used.map(baseOf))];
const missing = usedPanels.filter(id => !built.has(id));
if (missing.length) throw new Error(`${guide.id}: panels not built: ${missing.join(', ')}`);
const scope = guide.slug;
// Start state: every control's cold-and-dark position, then the procedure's own.
const initial: Record<string,string> = {};
for (const id of usedPanels) for (const c of built.get(id)!.spec.controls) initial[`${id}.${c.id}`] = c.initial;
Object.assign(initial, guide.initial ?? {});
const labels: Record<string,string> = {}, names: Record<string,string> = {}, orders: Record<string,string[]> = {};
for (const id of usedPanels) for (const c of built.get(id)!.spec.controls) {
  names[`${id}.${c.id}`] = c.name;
  orders[`${id}.${c.id}`] = c.positions.map(p => p.id);
  for (const p of c.positions) labels[`${id}.${c.id}.${p.id}`] = `${c.name} to ${p.label}`;
}
const config = {aircraft:`${cockpit.id}:${scope}`, initial, labels, names, orders, model: guide.model, lamps: usedPanels.flatMap(id => built.get(id)!.spec.indicators.filter(i => i.type === 'lamp').map(i => `${id}.${i.id}`)), steps: steps.map(s => ({id:s.id, panels:s.panels, do:s.do, also:s.also, type:s.type, confirm:s.confirm, turn:s.turn, ask:s.ask, hints:s.hints}))};
const recordLink = (l:{slug:string;anchor?:string}) => { const r = includedRecords.find(x => x.slug === l.slug); if (!r) throw new Error(`${guide.id}: no Encyclopedia record ${l.slug}`); return sitePath(recordRoute(r)) + (l.anchor ? '#' + l.anchor : ''); };
// `{{phrase|k}}` in a step's text becomes a button that rings hint k on the panels for a moment.
const esc = (t:string) => t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
// `[text](record:slug#anchor)` becomes a link to an Encyclopedia record (a reference table, say).
const rich = (t:string) => esc(t)
  .replace(/\{\{(.+?)\|(\d+)\}\}/g, (_m, text, k) => `<button type="button" class="hint-link" data-hint="${k}">${text}</button>`)
  .replace(/\[([^\]]+)\]\(record:([a-z0-9-]+)(?:#([a-z0-9-]+))?\)/g, (_m, text, slug, anchor) => {
    // A record named in passing gets the glossary-style link and preview; a link into a table goes straight there.
    const target = anchor ? undefined : recordTarget(slug);
    return target ? termMarkup(target, text) : `<a href="${recordLink({slug, anchor})}">${text}</a>`;
  })
  // `[text](procedure:slug)` links another procedure of the same aircraft.
  .replace(/\[([^\]]+)\]\(procedure:([a-z0-9-]+)\)/g, (_m, text, slug) => {
    const p = visibleProcedures.find(q => q.airframe === guide.airframe && q.slug === slug);
    if (!p) throw new Error(`${guide.id}: no procedure "${slug}"`);
    return `<a href="${sitePath(procedureRoute(p))}">${text}</a>`;
  })
  // `[word](term:slug)` (or `term:` alone, taking the word) links a glossary term, with its preview.
  .replace(/\[([^\]]+)\]\(term:([a-z0-9-]*)\)/g, (_m, text, slug) => {
    const target = termTarget(slug || text);
    if (!target) throw new Error(`${guide.id}: no glossary entry "${slug || text}"`);
    return termMarkup(target, text);
  });
---
<SiteLayout title={guide.title} activeSection="manual" activeSubject="aircraft-procedures"
 description={guide.description}>
  <section class="status-panel">
    <p><Fragment set:html={rich(guide.intro)} /></p>
  </section>
  <div class="procedure-workspace" data-procedure>
    <div class="procedure-guide">
      <p class="procedure-progress" role="status" aria-live="polite" data-progress>Review the steps below; JavaScript enables step navigation.</p>
      <ol class="procedure-steps">
        {steps.map((s,i)=><li class="procedure-step" data-step={i} data-step-id={s.id}>
          <div class="procedure-kicker">{s.section} · {String(i+1).padStart(2,'0')} / {steps.length}</div>
          <h2 tabindex="-1">{s.title}</h2>
          <p><strong>Control</strong> · {s.control}</p>
          <p class="procedure-action"><strong>Do</strong> · <Fragment set:html={rich(s.action)} /></p>
          <p><strong>Expect</strong> · <Fragment set:html={rich(s.expect)} /></p>
          {s.caution && <p class="procedure-warning"><strong>Note</strong> · <Fragment set:html={rich(s.caution)} /></p>}
          {s.links && <p class="procedure-panels">Encyclopedia: {s.links.map((l, k) => <>{k > 0 && ', '}<a href={recordLink(l)}>{l.label}</a></>)}</p>}
          {s.ask && <div class="procedure-ask" data-cross-check>
            <p><strong>{s.ask.question}</strong></p>
            {s.displayDescription && <details><summary>Display as text</summary><p>{s.displayDescription}</p></details>}
            <ul>{s.ask.options.map((o, k) => <li><button type="button" data-answer={k}>{o}</button></li>)}</ul>
          </div>}
          <p class="procedure-cite">Evidence: {s.evidence}</p>
          {s.panels.length > 0 && <p class="procedure-panels">Panels: {[...new Set(s.panels.map(baseOf))].map((id, k) => <>{k > 0 && ', '}<a href={sitePath(panelRoute(cockpit, id))}>{built.get(id)!.panel.title}</a></>)}</p>}
        </li>)}
      </ol>
      {guide.model === 'fcr-contact-reading' && <p class="procedure-feedback" role="status" aria-live="polite" data-feedback></p>}
      <h2 class="procedure-step" data-complete tabindex="-1" hidden><Fragment set:html={rich(guide.complete)} /></h2>
      {guide.summary && <section class="procedure-summary" aria-labelledby="procedure-summary-h"><h3 id="procedure-summary-h">What you learned</h3><ul>{guide.summary.map(l => <li><Fragment set:html={rich(l)} /></li>)}</ul></section>}
      {nextGuide && <p class="procedure-next">Next: <a href={sitePath(procedureRoute(nextGuide))}>{nextGuide.title.replace(/^F-16C — /, '')}</a>{guide.nextScenario ? ` (${guide.nextScenario}).` : ', from where this procedure ends.'}</p>}
      <div class="procedure-controls" hidden data-controls>
        <button type="button" data-prev>Previous</button>
        <button type="button" data-confirm hidden>Confirm indication</button>
        <button type="button" data-restart hidden>{guide.model === 'fcr-contact-reading' ? 'Restart exercise' : 'Restart procedure'}</button>
      </div>
    </div>
    <aside class="procedure-visual" aria-label={guide.model === 'fcr-contact-reading' ? 'Radar display' : 'Interactive cockpit panels'} data-visual>
      {guide.model !== 'fcr-contact-reading' && <p class="procedure-feedback" role="status" aria-live="polite" data-feedback></p>}
      <div class="cockpit-layout">
        {used.map(id => <div class="proc-panel" data-proc-panel={id} inert={guide.model === 'fcr-contact-reading'}>
          <h3>{built.get(baseOf(id))!.panel.title}</h3>
          <CockpitPanel cockpit={cockpit} spec={built.get(baseOf(id))!.spec} scope={scope} only={cardsOf(id)} />
        </div>)}
      </div>
      <div class="procedure-player" data-player hidden>
        <button type="button" data-play data-state="play" aria-label="Play"><svg viewBox="0 0 16 16" aria-hidden="true"><path class="i-play" d="M4 2.5v11l9-5.5z"/><path class="i-pause" d="M3.5 2.5h3v11h-3zM9.5 2.5h3v11h-3z"/><path class="i-replay" d="M8 2.5a5.5 5.5 0 1 1-5.2 3.7" fill="none" stroke="currentColor" stroke-width="1.8"/><path class="i-replay" d="M1.5 2.5v4.5h4.5z"/></svg></button>
        <input type="range" data-scrub aria-label="Time" value="0" />
        <span class="procedure-clock" data-clock aria-hidden="true"></span>
      </div>
    </aside>
  </div>
  <script type="application/json" data-procedure-config set:html={JSON.stringify(config)} />
  <h2>Sources</h2>
  <p>{guide.sources} <a href={sourceUrl}>Eagle Dynamics documentation</a>.</p>
</SiteLayout>
<script>
const root = document.querySelector<HTMLElement>('[data-procedure]');
const configEl = document.querySelector('[data-procedure-config]');
if (root && configEl) {
  const init = async () => {
    const config = JSON.parse(configEl.textContent!);
    if (config.model === 'tacan-navigation') (await import('../../../../scripts/procedure-tacan')).startTacanModel(root, config);
    else if (config.model === 'before-taxi' || config.model === 'before-takeoff') (await import('../../../../scripts/procedure-before-taxi')).startBeforeTaxiModel(root, config);
    else if (config.model === 'hts' || config.model === 'hts-targeting' || config.model === 'harm-shot' || config.model === 'maverick-pre' || config.model === 'maverick-handoff' || config.model === 'markpoints' || config.model === 'markpoint-manual' || config.model === 'markpoint-hud' || config.model === 'markpoint-fcr' || config.model === 'markpoint-tgp' || config.model === 'fcr-rws' || config.model === 'fcr-vsr' || config.model === 'fcr-bug' || config.model === 'fcr-tws' || config.model === 'fcr-two' || config.model === 'fcr-contact-reading' || config.model === 'aim120' || config.model === 'aim120-bore' || config.model === 'fcr-vol' || config.model === 'takeoff') (await import('../../../../scripts/procedure-hts')).startHtsModel(root, config);
    else if (config.model === 'steerpoint-entry') (await import('../../../../scripts/procedure-steerpoint')).startSteerpointModel(root, config);
    else (await import('../../../../scripts/procedure-engine-start')).startEngineModel(root, config);
  };
  if (document.readyState === 'loading') addEventListener('DOMContentLoaded', init); else setTimeout(init, 0);

  // Hint links: ring the named indications for a few seconds.
  let ringTimer: ReturnType<typeof setTimeout> | undefined;
  const clearRings = () => {
    clearTimeout(ringTimer);
    root.querySelectorAll('.hint-ring, .hud-hint-ring').forEach(r => r.remove());
  };
  root.addEventListener('click', e => {
    const target = e.target as Element;
    if (target.closest('[data-prev], [data-confirm], [data-restart]')) clearRings();
    const b = target.closest<HTMLButtonElement>('[data-hint]');
    const stepEl = b?.closest<HTMLElement>('[data-step]');
    if (!b || !stepEl) return;
    const config = JSON.parse(configEl.textContent!);
    const hint: string | undefined = config.steps[Number(stepEl.dataset.step)]?.hints?.[Number(b.dataset.hint)];
    if (!hint) return;
    clearRings();
    const rects = new Map<HTMLElement, DOMRect[]>();
    let first: HTMLElement | undefined;
    for (const target of hint.split(',')) {
      const [spotRef, spot] = target.split('#');
      const [ref, row] = spotRef.split('@');
      const [panel, idStep] = ref.split('.');
      // `id~1` / `id~-1`: only the half of a step switch that moves it that way (`1` = down or right).
      const [id, half] = idStep.split('~');
      // A HOTAS card shown alone is scoped (`stick:tms`); a hint names its panel (`stick.tms-ud`), so look in the card too.
      const box = root.querySelector<HTMLElement>(`[data-proc-panel="${panel}"]`) ?? [...root.querySelectorAll<HTMLElement>(`[data-proc-panel^="${panel}:"]`)].find(b => b.querySelector(`.cp-pad:not([hidden]) [data-pad-control="${id}"]`));
      // The panel's drawing, or, for a card shown alone, the card itself.
      const stage = box?.querySelector<HTMLElement>('.cp-stage:not([hidden])') ?? box?.querySelector<HTMLElement>('.cp-pad:not([hidden])');
      if (!stage) continue;
      // Find the symbol itself for a hint that follows the HUD's transforms.
      const anchor = stage.querySelector<SVGGraphicsElement>(`[data-hint-target="${id}"]`);
      if (anchor) {
        // A sibling inherits the symbol's motion and is clipped by the HUD glass.
        const { x, y, width, height } = anchor.getBBox();
        const ring = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        const pad = 2;
        ring.setAttribute('class', 'hud-hint-ring');
        ring.setAttribute('aria-hidden', 'true');
        ring.setAttribute('x', String(x - pad));
        ring.setAttribute('y', String(y - pad));
        ring.setAttribute('width', String(width + 2 * pad));
        ring.setAttribute('height', String(height + 2 * pad));
        ring.setAttribute('rx', '2');
        anchor.after(ring);
        first ??= stage;
        continue;
      }
      const els = [...stage.querySelectorAll<Element>(`[data-indicator="${id}"], button[data-control="${id}"], button[data-pad-hit="${id}"], button[data-pad-control="${id}"]`)];
      let boxes = (half === undefined ? els : els.filter(el => (el as HTMLElement).dataset.padStep === half)).map(el => el.getBoundingClientRect()).filter(r => r.width > 0);
      if (spot && els[0]) {
        // Part of a display: a box in the shown page's own units, mapped to the screen.
        const g = [...stage.querySelectorAll<SVGGraphicsElement>(`[data-page-of="${id}"]`)].find(p => p.getAttribute('display') !== 'none') ?? (els[0] as SVGGraphicsElement);
        const m = g.getScreenCTM(), [x0, y0, x1, y1] = spot.trim().split(/\s+/).map(Number);
        if (m) {
          const pts = [[x0, y0], [x1, y1]].map(([x, y]) => new DOMPoint(x, y).matrixTransform(m));
          boxes = [new DOMRect(Math.min(pts[0].x, pts[1].x), Math.min(pts[0].y, pts[1].y), Math.abs(pts[1].x - pts[0].x), Math.abs(pts[1].y - pts[0].y))];
        }
      } else if (row !== undefined && boxes[0]) {
        // A DED line: the display's inner area split into its five rows.
        const r = boxes[0], top = r.top + r.height * 0.1, h = (r.height * 0.8) / 5;
        boxes = [new DOMRect(r.left + r.width * 0.04, top + h * Number(row), r.width * 0.92, h)];
      }
      if (boxes.length) rects.set(stage, [...(rects.get(stage) ?? []), ...boxes]);
    }
    for (const [stage, boxes] of rects) {
      if (getComputedStyle(stage).position === 'static') stage.style.position = 'relative';
      const s = stage.getBoundingClientRect();
      const l = Math.min(...boxes.map(r => r.left)), t = Math.min(...boxes.map(r => r.top));
      const rr = Math.max(...boxes.map(r => r.right)), bb = Math.max(...boxes.map(r => r.bottom));
      const pad = 6, ring = document.createElement('div');
      ring.className = 'hint-ring'; ring.setAttribute('aria-hidden', 'true');
      Object.assign(ring.style, { left: `${l - s.left - pad}px`, top: `${t - s.top - pad}px`, width: `${rr - l + 2 * pad}px`, height: `${bb - t + 2 * pad}px` });
      stage.append(ring);
      first ??= ring;
    }
    first?.scrollIntoView({ block: 'nearest', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    ringTimer = setTimeout(clearRings, 4000);
  });
  addEventListener('cockpit:change', clearRings);

}
</script>
<style>
  [data-complete][hidden] ~ .procedure-next, [data-complete][hidden] ~ .procedure-summary { display: none; }
  .procedure-summary { margin-block: 0.75rem 1rem; max-width: 46rem; }
  .procedure-summary h3 { margin: 0 0 0.4rem; font-size: 1.0625rem; }
  .procedure-summary li { margin-block: 0.3rem; }
  .procedure-next { margin-block: 0.5rem 1rem; font-size: 1.0625rem; }
.procedure-workspace{display:grid;gap:1.5rem;margin-top:1.5rem;align-items:start}
.procedure-progress{font-weight:700}
.procedure-steps{padding:0;margin:0;list-style:none}
.procedure-step{max-width:none;border:1px solid var(--color-border);border-top:4px solid var(--color-outline);padding:1.25rem;margin:0}
.procedure-step[hidden],.procedure-controls[hidden]{display:none}
.procedure-step h2{margin:.25rem 0 .8rem}
.procedure-step p{margin:.65rem 0}
.procedure-kicker{font-size:.8rem;color:var(--color-muted);font-weight:700;letter-spacing:.06em;text-transform:uppercase}
.procedure-action{padding:.7rem;background:var(--color-surface)}
.procedure-warning{border-left:4px solid var(--color-warning);padding-left:.7rem}
.procedure-ask ul{list-style:none;padding:0;margin:.5rem 0}
.procedure-ask button{display:block;width:100%;text-align:left;min-height:2.75rem;padding:.5rem .75rem;margin:.35rem 0;border:1px solid var(--color-outline);background:var(--color-page);color:var(--color-text);cursor:pointer;font:inherit}
.procedure-ask button:disabled{opacity:.5;cursor:default}
:global(.hint-link){font:inherit;color:var(--color-link,#005fcc);background:none;border:0;padding:0;border-bottom:2px dotted #c99700;cursor:pointer}
:global(.hint-link):hover,:global(.hint-link):focus-visible{background:var(--color-hint-surface)}
.proc-panel :global(.hint-ring){position:absolute;pointer-events:none;border:3px solid #e6b800;border-radius:12px;box-shadow:0 0 0 2px rgba(255,255,255,.9),0 0 10px 2px rgba(230,184,0,.6);animation:hint-pulse 1s ease-in-out 4}
@keyframes hint-pulse{50%{opacity:.35}}
.proc-panel :global(.hud-hint-ring){pointer-events:none;fill:none;stroke:#e6b800;stroke-width:3px;vector-effect:non-scaling-stroke;filter:drop-shadow(0 0 3px #e6b800);animation:hint-pulse 1s ease-in-out 4}
@media(prefers-reduced-motion:reduce){.proc-panel :global(.hint-ring),.proc-panel :global(.hud-hint-ring){animation:none}}
.procedure-cite,.procedure-panels{font-size:.85rem;color:var(--color-muted)}
.procedure-controls{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:.75rem;margin-top:1rem}
.procedure-player{display:flex;align-items:center;gap:.75rem;margin-top:1rem;padding:.5rem .75rem;border:1px solid var(--color-outline)}
.procedure-player[hidden]{display:none}
.procedure-player button{flex:none;width:2.75rem;height:2.75rem;display:grid;place-items:center;border:1px solid var(--color-outline);background:var(--color-page);color:var(--color-text);cursor:pointer;padding:0}
.procedure-player svg{width:1.1rem;height:1.1rem;fill:currentColor}
.procedure-player [data-state] path{display:none}
.procedure-player [data-state="play"] .i-play,.procedure-player [data-state="pause"] .i-pause,.procedure-player [data-state="replay"] .i-replay{display:inline}
.procedure-player input{flex:1;min-width:0;accent-color:var(--color-text)}
.procedure-clock{flex:none;font-variant-numeric:tabular-nums;font-size:.9rem}
.procedure-controls button{min-height:2.75rem;padding:.45rem 1rem;border:1px solid var(--color-outline);background:var(--color-page);color:var(--color-text);cursor:pointer;font:inherit}
.procedure-controls button[data-confirm]{background:var(--color-accent);color:var(--color-ink);font-weight:700}
.procedure-controls button:focus-visible{outline:3px solid var(--color-focus);outline-offset:2px}
.procedure-controls button:disabled{opacity:.4;cursor:default}
.procedure-visual{position:relative}
.procedure-visual[hidden]{display:none}
.procedure-feedback{min-height:1.5em;margin:0 0 .5rem;font-weight:600}
.procedure-feedback.retry{color:var(--color-error)}
.cockpit-layout{display:flex;flex-wrap:wrap;gap:.75rem 1rem;align-items:flex-start}
/* Keep the HUD at its roll-step size above the stick button and indicator. */
.cockpit-layout:has(>[data-proc-panel="hud"].acting):has(>[data-proc-panel="stick:msl-step"]:not([hidden])):has(>[data-proc-panel="ar-nws-indicator"]:not([hidden])){
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(4.25rem,22%);
  column-gap:.65rem;
  & > [data-proc-panel="hud"]{grid-column:1 / -1;justify-self:start}
}
.proc-panel{flex:0 1 auto;min-width:0;max-width:100%}
.proc-panel[hidden]{display:none}
.proc-panel h3{margin:0 0 .25rem;font-size:.8rem;letter-spacing:.04em;text-transform:uppercase;color:var(--color-muted)}
.proc-panel.acting h3{color:var(--color-text)}
.proc-panel :global(.cockpit-panel){width:calc(var(--proc-h,40svh) * var(--ratio));max-width:100%}
.proc-panel.acting{--proc-h:54svh}
/* Lamp-only panels shown for reading (caution panel, eyebrows) are smaller, so they sit side by side. */
.proc-panel:is([data-proc-panel="caution"],[data-proc-panel="left-eyebrow"],[data-proc-panel="right-eyebrow"]):not(.acting){--proc-h:22svh}
.proc-panel :global(.cp-status){display:none}
.procedure-workspace.procedure-finished{grid-template-columns:minmax(0,1fr)}
@media(min-width:58rem){.procedure-workspace{grid-template-columns:minmax(0,24rem) minmax(0,1fr)}.procedure-visual{position:sticky;top:1rem}}
/* While the tall TEST panel is acting, the panels it lights (eyebrows, caution panel, EPU, ELEC) stack in a column beside it rather than below it. */
@media(min-width:58rem){.cockpit-layout:has(> [data-proc-panel="test"].acting){display:grid;grid-template-columns:auto auto;justify-content:start;align-items:start}.cockpit-layout > [data-proc-panel="test"].acting{grid-row:span 4}}
@media(max-width:57.99rem){
.procedure-step{padding:.55rem}
.procedure-step h2{font-size:1.15rem}
.procedure-step p{margin:.25rem 0}
.procedure-controls{margin-top:.4rem}
.procedure-workspace{gap:.45rem}
.proc-panel{--proc-h:26svh}
.proc-panel.acting{--proc-h:40svh}
/* Phones: size panels by area, not height, so tall panels (engine instruments) are not shrunk to a sliver. */
@supports (width: calc(1px * sqrt(2))){
.proc-panel{--proc-s:30svh}
.proc-panel.acting{--proc-s:46svh}
.proc-panel :global(.cockpit-panel){width:min(100%,calc(var(--proc-s) * sqrt(var(--ratio))))}
}
}
</style>
