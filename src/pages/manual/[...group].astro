---
import GroupCards from "../../components/GroupCards.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { groupPages, hasArticle, type MenuNode } from "../../data/manual-menu";
import { cockpitRoute, cockpits } from "../../data/cockpit/f16c/index.ts";

// A landing page for every group in the Manual menu: an intro and its children.
// The F-16C hub, the cockpit page and groups with a written article are their own pages and are left out here.
export function getStaticPaths() {
  const own = new Set(["manual/aircraft-procedures/f-16c/", ...cockpits.map((c) => cockpitRoute(c))]);
  return groupPages()
    .filter((node) => !own.has(node.href!) && !node.article)
    .map((node) => ({ params: { group: node.href!.replace(/^manual\//, "").replace(/\/$/, "") }, props: { node } }));
}

const { node } = Astro.props as { node: MenuNode };
const empty = !hasArticle(node);
---
<SiteLayout title={node.title} activeSection="manual" description={node.summary} empty={empty}>
  {node.summary && <p class="lead">{node.summary}</p>}
  {empty && <p class="muted">Content coming soon.</p>}
  <GroupCards node={node} list={empty || node.children?.length === 1} />
</SiteLayout>
