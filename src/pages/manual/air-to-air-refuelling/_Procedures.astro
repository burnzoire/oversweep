const core = [
 ['example', 'One refuelling, start to finish'], ['systems', 'Boom or probe and drogue'], ['rendezvous', 'Meeting the tanker'],
 ['join', 'Joining and the flow'], ['boom', 'A boom contact'], ['drogue', 'A drogue contact'], ['comms', 'Calls, lights and silent signals'],
