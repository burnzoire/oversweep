  'Standard briefing', 'METAR', 'SPECI', 'Ceiling', 'RVR', 'TAF', 'FM', 'TEMPO', 'PROB30', 'PIREP', 'Pressure altitude', 'Density altitude', 'Datum', 'Moment arm', 'Moment', 'Center of gravity',
 ]} />
