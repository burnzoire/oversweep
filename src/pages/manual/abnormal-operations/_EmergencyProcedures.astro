  const ft = (n: number) => `${Math.round(n).toLocaleString('en-US')} ft`;
  const update = () => {
   const r = glideCheck({ rule: rule.value, distanceNm: Number(dist.value), heightFt: Number(height.value) });
   const name = RULES[rule.value as keyof typeof RULES].label;
   dOut.textContent = `${dist.value} NM`; hOut.textContent = ft(Number(height.value));
   const verdict = r.target === 'high' ? `You reach high key with ${ft(r.marginFt)} to spare.`
    : r.target === 'low' ? `Not high key (${ft(-r.marginFt)} short), but you can still reach low key.`
    : 'You reach neither key: pick a nearer field, or plan a forced landing or ejection.';
   result.textContent = `${name}: high key needs ${ft(r.neededHighKey)}, low key ${ft(r.neededLowKey)}. ${verdict} From this height you could reach high key at a field up to ${r.reachHighKeyNm.toFixed(1)} NM away.`;
  };
  [rule, dist, height].forEach((el) => el.addEventListener('input', update));
  update();
  root.classList.add('ready');
 }
</script>
