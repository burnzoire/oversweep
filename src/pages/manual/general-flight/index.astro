---
import MenuCards from "../../../components/MenuCards.astro";
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { manualMenu } from "../../../data/manual-menu";
import { sitePath } from "../../../lib/paths";
const node = manualMenu.find((n) => n.id === "area-general-flight")!;
---
<SiteLayout title={node.title} activeSection="manual" description={node.summary}
  breadcrumbs={[{ label: "Manual", href: sitePath("manual/") }, { label: node.title }]}>
  <p class="lead">{node.summary}</p>
  <MenuCards node={node} />
</SiteLayout>
