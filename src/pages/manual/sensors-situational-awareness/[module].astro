---
import RadarAndWarning from './_RadarAndWarning.astro';
import SituationalAwareness from './_SituationalAwareness.astro';
import { includedModules } from '../../../data/modules';
// Sensors & Situational Awareness has one page per module, each its own
// component kept beside this route so the SME review reads it (the underscore
// keeps Astro from routing it). This route emits only the modules the registry
// includes in the build.
const pages = { 'radar-and-warning': RadarAndWarning, 'situational-awareness': SituationalAwareness };
export function getStaticPaths() {
  return includedModules.filter((m) => m.subject === 'sensors-situational-awareness').map((m) => ({ params: { module: m.slug } }));
}
const { module } = Astro.params;
const Page = pages[module as keyof typeof pages];
if (!Page) throw new Error(`No Sensors & Situational Awareness page for module ${module}`);
---
<Page />
