---
import MovedPage from "../../components/MovedPage.astro";
import { manualSubjects } from "../../data/catalogue";

// A subject is a group in the Manual menu, and only menu leaves are pages
// (issue #429), so the old subject address sends readers to the Manual.
export function getStaticPaths() {
  return manualSubjects.map((subject) => ({ params: { slug: subject.slug } }));
}
---
<MovedPage to="manual/" />
