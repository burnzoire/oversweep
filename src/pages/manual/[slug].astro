---
import EntryCard from "../../components/EntryCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { manualSubjects } from "../../data/catalogue";
import { subjectEntries, subjectGroups } from "../../data/availability";
import { sitePath } from "../../lib/paths";

export function getStaticPaths() {
  return manualSubjects.map((subject) => ({
    params: { slug: subject.slug },
    props: { subject },
  }));
}

const { subject } = Astro.props;
const entries = subjectEntries(subject.slug);
const groups = subjectGroups(subject.slug);
---

<SiteLayout
  title={subject.title}
  activeSection="manual"
  activeSubject={subject.slug}
  empty={entries.length === 0}
  breadcrumbs={[
    { label: "Manual", href: sitePath("manual/") },
    { label: subject.title },
  ]}
>
  {entries.length > 0
    ? groups.map((group) => group.title
      ? <section class="subject-group" aria-labelledby={`group-${group.title.toLowerCase().replace(/\W+/g, '-')}`}>
          <h2 id={`group-${group.title.toLowerCase().replace(/\W+/g, '-')}`}>{group.title}</h2>
          {group.entries.map((entry) => <EntryCard entry={entry} headingLevel={3} />)}
        </section>
      : group.entries.map((entry) => <EntryCard entry={entry} />))
    : <p class="empty-note">No {subject.title.toLowerCase()} modules are published yet. Subjects with modules are linked in the subject list, or see <a href={sitePath("manual/")}>everything in the Manual</a>.</p>}
</SiteLayout>
