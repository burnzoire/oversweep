---
import Bfm from './_Bfm.astro';
import BvrIntercepts from './_BvrIntercepts.astro';
import { includedModules } from '../../../data/modules';
// Air Combat has one page per module, each its own component kept beside this
// route so the SME review reads it (the underscore keeps Astro from routing
// it). This route emits only the modules the registry includes in the build.
const pages = { bfm: Bfm, 'bvr-intercepts': BvrIntercepts };
export function getStaticPaths() {
  return includedModules.filter((m) => m.subject === 'air-combat').map((m) => ({ params: { module: m.slug } }));
}
const { module } = Astro.params;
const Page = pages[module as keyof typeof pages];
if (!Page) throw new Error(`No Air Combat page for module ${module}`);
---
<Page />
