<script>
 import { s300Descent } from '../../../lessons/flight-fundamentals/autorotation-figures.mjs';
 const root = document.querySelector<HTMLElement>('[data-lesson="descent-curve"]');
 if (root) {
  const input = root.querySelector<HTMLInputElement>('input[name="speed"]')!;
  const out = root.querySelector('output')!;
  const result = root.querySelector('[data-result]')!;
  const marker = root.querySelector('[data-marker]')!;
  const [line, dot] = [marker.querySelector('line')!, marker.querySelector('circle')!];
  const dX = (mph: number) => 70 + mph * 6, dY = (fpm: number) => 350 - fpm * 0.128;
  const update = () => {
   const mph = Number(input.value), fpm = s300Descent(mph);
   out.textContent = `${mph} mph`;
   line.setAttribute('x1', String(dX(mph))); line.setAttribute('x2', String(dX(mph))); line.setAttribute('y2', String(dY(fpm)));
   dot.setAttribute('cx', String(dX(mph))); dot.setAttribute('cy', String(dY(fpm)));
   const ratio = (mph * 88 / fpm).toFixed(1);
   result.textContent = `${mph} mph (${Math.round(mph * 0.869)} knots): about ${Math.round(fpm / 10) * 10} feet per minute down, ${ratio} feet forward for each foot of height.`;
  };
  input.addEventListener('input', update);
  update();
  root.classList.add('ready');
 }
</script>
