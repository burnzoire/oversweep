 ['numbers', 'Runway numbers'], ['markings', 'Runway markings'], ['holding', 'Taxiways and holding positions'],
 ['signs', 'Airport signs'], ['lighting', 'Airfield lighting'], ['glidepath', 'Visual glide slope indicators'],
 ['wind', 'Wind and the runway in use'], ['pattern', 'The traffic pattern'], ['overhead', 'The overhead maneuver'],
