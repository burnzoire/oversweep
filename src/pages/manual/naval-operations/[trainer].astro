export function getStaticPaths() { return includedExperiences.some(e => e.slug === 'case-iii') ? [{ params: { trainer: 'case-iii' } }] : []; }
const trainerHref = sitePath(experienceFrame(caseIII));
const contents = [
  ['overview', 'What this guide covers'],
  ['at-a-glance', 'The exercise at a glance'],
  ['clearance', 'The trainer’s Marshal clearance'],
  ['tacan', 'Point-to-point TACAN navigation'],
  ['entry', 'Choosing a hold entry'],
  ['eat', 'Planning the hold to EAT'],
  ['penetration', 'The trainer’s descent'],
  ['final', 'The trainer’s final approach'],
