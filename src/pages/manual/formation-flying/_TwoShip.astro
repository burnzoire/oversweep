const mod = getModule('two-ship-formation');
// The first-pass path, then reference material for when it is needed.
const core = [
 ['example', 'One formation sortie, start to finish'], ['positions', 'Where the wingman flies'], ['parade', 'Parade: three checkpoints'],
 ['comms', 'Talking as a flight'], ['rendezvous', 'Breakup, rendezvous and underruns'], ['lost', 'Lost sight and blind'], ['recap', 'Key points'],
];
const reference = [
 ['lights', 'Lights at night'], ['maneuvers', 'Crossunders, lead changes and the break'], ['tactical', 'Tactical formation maneuvers'],
 ['sims', 'In the sim'], ['terms', 'Terms'], ['check', 'Check your understanding'], ['sources', 'Sources and applicability'],
];
// [1] VT-6 Formation Supplement, by printed page. [2] FAA AIM 4-3-23,
// supplementary. [3] VT-35 TACFORM handout and [4] VT-35 tiltrotor
// formation procedures brief, by section or slide title. [5] DCS F/A-18C
