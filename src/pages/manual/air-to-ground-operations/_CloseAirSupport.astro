// The first-pass path, then reference material for when it is needed.
const core = [
 ['example', 'One attack, start to finish'], ['what', 'What close air support is'], ['who', 'Who controls the attack'],
 ['control', 'Type of control and method of attack'], ['clearance', 'Clearance calls'], ['checkin', 'Check-in and game plan'],
 ['nineline', 'The 9-line'], ['readback', 'Readbacks'], ['correlation', 'Correlation'], ['attack', 'IN, cleared hot, abort and reattack'],
 ['recap', 'Key points'],
];
const reference = [
 ['marks', 'Marks, laser and infrared calls'], ['talkon', 'Talk-on technique'], ['fratricide', 'Preventing fratricide'],
 ['airframes', 'Fixed- and rotary-wing CAS across the services'], ['fiveline', 'The rotary-wing 5-line'], ['sims', 'In the sim'],
 ['terms', 'Terms'], ['check', 'Check your understanding'], ['sources', 'Sources and applicability'],
];
// [1] JP 3-09.3, Close Air Support (25 November 2014), cited by printed page.
