const contents = [
 ['overview', 'Purpose and learning objectives'], ['types', 'Types of delivery'], ['triangle', 'The bombing triangle and the sight'],
 ['tables', 'Bombing tables and the Z diagram'], ['pattern', 'Roll-in, tracking and recovery'], ['errors', 'Release parameters and errors'],
 ['corrections', 'Correcting in the dive'], ['sights', 'Computed and manual sights'], ['popup', 'The offset pop-up attack'],
 ['ordnance', 'Low and high drag, fuzes and fragmentation'], ['sims', 'In the sim'], ['terms', 'Terms'], ['check', 'Check your understanding'],
 ['sources', 'Sources and applicability'],
];
// Military sources first: [1] CNATRA P-1219 (T-45 Weapons FTI) printed page,
// [2] CNATRA P-1208 (T-45 Operational Navigation FTI), [3] CNATRA P-1217
// (Two-Plane Road Reconnaissance), [4] NAVEDTRA 14313. Secondary and sim:
// [5] Wikipedia, Toss bombing; [6] Heatblur F-14 manual; [7] Heatblur F-4 manual.
