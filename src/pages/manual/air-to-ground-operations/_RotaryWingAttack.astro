];
// [1] JP 3-09.3, Close Air Support (25 November 2014), by printed page.
// [2] JP 1-02, DoD Dictionary (as amended through 15 January 2016), by printed page.
// [3] FM 3-04, Army Aviation (6 April 2020), by printed page.
// [4] FM 3-04.126, Attack Reconnaissance Helicopter Operations (16 February 2007), by printed page.
// [5] DCS: AH-64D Flight Manual and [6] DCS: Black Shark 3 Flight Manual, sim crossover only.
const fm = (page: string) => `[3, ${/–|,| to /.test(page) ? 'pp.' : 'p.'} ${page}]`;
const arh = (page: string) => `[4, ${/–|,| to /.test(page) ? 'pp.' : 'p.'} ${page}]`;
