const core = [
 ['example', 'One package, start to finish'], ['what', 'What SEAD and DEAD are'], ['iads', 'The air defence you face'],
 ['avoid', 'Staying out of reach'], ['suppress', 'The suppression methods'], ['package', 'SEAD in a strike package'], ['recap', 'Key points'],
];
const reference = [
 ['arms', 'Anti-radiation missiles and decoys'], ['jamming', 'Jamming in more depth'], ['history', 'SEAD in combat'],
 ['sims', 'In the sim'], ['terms', 'Terms'], ['check', 'Check your understanding'], ['sources', 'Sources and applicability'],
];
// [1] JP 3-01, Countering Air and Missile Threats (23 March 2012), by printed page.
// [2] US Naval Academy, Fundamentals of Naval Weapons Systems, ch. 11, by section.
// [3] Wikipedia, Suppression of Enemy Air Defenses (secondary). [4] Wikipedia, Radar horizon (secondary).
// [5] DCS F-16C Viper guide and [6] Falcon BMS 4.38 Training Manual, sim crossover only.
const j = (page: string) => `[1, ${/to|,/.test(page) ? 'pp.' : 'p.'} ${page}]`;
const u = (sec: string) => `[2, ${sec}]`;
const wd = sitePath('manual/air-to-ground-operations/weapons-delivery/');
const cas = sitePath('manual/air-to-ground-operations/close-air-support/');
