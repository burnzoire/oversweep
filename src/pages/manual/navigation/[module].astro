export function getStaticPaths() { return includedModules.some(m => m.slug === 'air-navigation') ? [{ params: { module: 'air-navigation' } }] : []; }
const contents = [
 ['overview', 'Purpose and learning objectives'], ['hsi', 'Reading the HSI'], ['setup', 'Setting up a course'],
 ['tracking', 'Flying to and from a station'], ['intercepts', 'Intercepting a course'],
 ['dme', 'Using distance: ground speed and arcs'], ['p2p', 'Point to point'], ['waypoints', 'Waypoints, offsets and direct-to'],
 ['crosscheck', 'Cross-checking and degraded navigation'], ['background', 'Background'], ['earth', 'Position on the earth'],
 ['coords', 'Writing a position'], ['direction', 'Direction: true, magnetic and compass'], ['wind', 'Dead reckoning and the wind triangle'],
 ['navaids', 'Radio navigation aids'], ['fixes', 'Fixes'], ['gps', 'Satellite navigation'], ['ins', 'Inertial navigation'],
 ['terms', 'Terms'], ['check', 'Check your understanding'], ['sources', 'Sources and applicability'],
];
// Military sources first: [1] NAVEDTRA 14342A page, [2] CNATRA P-1204 page,
// [3] FM 3-25.26 page. Supplementary FAA sources: [4] AIM paragraph,
// [5] Pilot's Handbook (PHAK) page, [6] Instrument Flying Handbook page.
const pp = (n: number) => (page: string) => `[${n}, ${page.includes('–') || page.includes(',') ? 'pp.' : 'p.'} ${page}]`;
