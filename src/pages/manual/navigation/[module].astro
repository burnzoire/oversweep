   <label for="p-td">Fix DME <input id="p-td" name="td" type="number" min="0" max="80" step="1" value="21" inputmode="numeric" /></label>
   <label for="p-guess">Your course estimate <input id="p-guess" name="guess" type="number" min="0" max="359" step="1" inputmode="numeric" /></label>
  </div>
  <div class="buttons"><button type="button" data-check>Check estimate</button><button type="button" data-reveal>Reveal</button><button type="button" data-new>New problem</button></div>
  <div class="fig-scroll" role="region" aria-label="Figure 3, scrolls sideways on narrow screens" tabindex="0"><svg class="natops" viewBox="0 0 640 300" role="img" aria-label="Compass rose used as a plotting board with your fix, the target fix and the course between them"></svg></div>
