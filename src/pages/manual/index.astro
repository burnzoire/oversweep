---
import MenuCards from "../../components/MenuCards.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { manualMenu } from "../../data/manual-menu";

// The Manual landing page mirrors the menu: one card per sub-area. Each sub-area
// has its own page listing what is directly beneath it (issue #429).
---

<SiteLayout title="Manual" activeSection="manual" isSectionIndex
  description="Military flight procedures for flight sim pilots, taught from first principles with interactive figures, sources and knowledge checks: general flight, tactics and aircraft guides.">
  <p class="lead">The Manual has three parts: general flight skills that apply to any aircraft, tactics, and a guide for each aircraft type. Modules teach one topic from first principles, with interactive figures, sources and a short knowledge check.</p>
  <MenuCards node={{ id: "manual", title: "Manual", children: manualMenu }} />
</SiteLayout>
