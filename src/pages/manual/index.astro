---
import EntryCard from "../../components/EntryCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { manualSubjects } from "../../data/catalogue";
import { subjectEntries, subjectGroups } from "../../data/availability";
import { sitePath } from "../../lib/paths";

const available = manualSubjects.filter((s) => subjectEntries(s.slug).length > 0);
---

<SiteLayout title="Manual" activeSection="manual" isSectionIndex
  description="Military flight procedures taught from first principles, with interactive figures, sources and knowledge checks: navigation, instruments, formation, carrier ops, air combat and more.">
  <p class="lead">Each module teaches one topic from first principles, with interactive figures, sources and a short knowledge check. Every module states its review status. Subjects without modules yet are dimmed in the subject list.</p>
  {available.map((subject) => (
    <section class="subject-group" aria-labelledby={`subject-${subject.slug}`}>
      <h2 id={`subject-${subject.slug}`}><a href={sitePath(`manual/${subject.slug}/`)}>{subject.title}</a></h2>
      <div class="entry-grid">
        {subjectGroups(subject.slug).flatMap((g) => g.entries).map((entry) => <EntryCard entry={entry} headingLevel={3} compact />)}
      </div>
    </section>
  ))}
</SiteLayout>
