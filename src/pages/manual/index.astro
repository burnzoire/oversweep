---
import EntryCard from "../../components/EntryCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { manualEntries } from "../../data/availability";

// The Manual landing page explains the Manual and features a few articles. The
// menu holds the full list; only menu leaves are pages (issue #429).
const featured = ["module.principles-of-flight", "module.bvr-intercepts", "module.sead-dead", "procedure.dcs-f16c.engine-start", "procedure.dcs-f16c.hts"]
  .map((id) => manualEntries.find((entry) => entry.id === id))
  .filter((entry) => entry !== undefined);
---

<SiteLayout title="Manual" activeSection="manual" isSectionIndex
  description="Military flight procedures for flight sim pilots, taught from first principles with interactive figures, sources and knowledge checks: general flight, tactics and aircraft guides.">
  <p class="lead">Modules teach the flying, for any aircraft. Aircraft guides teach one aircraft, panel by panel. Pick from the menu, or start with one of these.</p>

  <section class="manual-featured" aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured</h2>
    <div class="entry-grid">
      {featured.map((entry) => <EntryCard entry={entry!} headingLevel={3} compact />)}
    </div>
  </section>
</SiteLayout>
