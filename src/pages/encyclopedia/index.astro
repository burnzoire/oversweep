---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { encyclopediaCategories } from "../../data/catalogue";
import { sitePath } from "../../lib/paths";
---

<SiteLayout title="Encyclopedia" activeSection="encyclopedia" isSectionIndex empty>
  <p class="empty-note">No encyclopedia records are published yet. Start with the <a href={sitePath("manual/")}>Manual</a> instead.</p>
  <section class="planned" aria-labelledby="planned-title">
    <h2 id="planned-title">Planned categories</h2>
    <ul class="planned-list">
      {encyclopediaCategories.map((category) => <li>{category.title}</li>)}
    </ul>
  </section>
</SiteLayout>
