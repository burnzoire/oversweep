---
import LinkedText from '../../../components/LinkedText.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Cited from '../../../components/encyclopedia/Cited.astro';
import PhotoFigure from '../../../components/encyclopedia/PhotoFigure.astro';
import { categoryRecords, sensorContent, sensorGroups, recordRoute, type EncyclopediaRecord } from '../../../data/encyclopedia';
import { categoryTitle } from '../../../data/availability';
import { sitePath } from '../../../lib/paths';
import '../../../styles/encyclopedia.css';

export function getStaticPaths() {
  return categoryRecords('radar-sensors').map((record) => ({ params: { record: record.slug }, props: { record } }));
}

const { record } = Astro.props as { record: EncyclopediaRecord };
const { frontmatter: data, Content } = sensorContent(record);
const category = categoryTitle(record.category);
const group = sensorGroups.find((g) => g.slug === data.group)!;
// The record nav lists the sensors of the same group, so it stays short.
const siblings = categoryRecords('radar-sensors').filter((r) => sensorContent(r).frontmatter.group === data.group);
const [leadPhoto, ...morePhotos] = data.photos;
const label = (r: EncyclopediaRecord) => sensorContent(r).frontmatter.short ?? r.title;
const plate: [string, string | undefined][] = [
  ['Type', data.type],
  ['Origin', data.origin],
  ['Manufacturer', data.manufacturer],
  ['In service', data.inService],
  ['Band', data.band],
  ['Weight', data.weight],
  ['Dimensions', data.dimensions],
  ['Sensors', data.sensors],
  ['Modes', data.modes],
  ['Laser', data.laser],
  ['Laser spot tracker', data.spotTracker],
  ['Range', data.range],
  ['What the crew sees', data.display],
];
// The status panel's caveat depends on what kind of sensor the record is.
const caveat = {
  'targeting-pod': 'Pods are upgraded in service, so weights, sensors and ranges change with the variant; the data plate names the variants its figures describe.',
  'fighter-radar': 'Published detection ranges depend on the target\'s radar cross-section, its aspect and altitude, the mode and the variant, so treat a quoted range as one data point, not a performance figure.',
  rwr: 'A warning receiver only knows the radars in its threat library, and its symbols and priorities are set by that library, so what one shows varies by aircraft, variant and software load.',
  'helicopter-sensor': 'Helicopter sights and radars are upgraded in service, so the sensors and figures change with the variant; the data plate names the variants its figures describe.',
  countermeasure: 'Dispensers and jammers are only as good as their programs and threat data, which are reprogrammed for each theatre, so their figures describe the hardware, not how well it works against a given threat.',
}[data.group];
---
<SiteLayout title={record.title} activeSection="encyclopedia"
  image={leadPhoto?.src} imageAlt={leadPhoto?.alt}
  description={`${record.title} (${record.designation}): ${record.summary}`}
  breadcrumbs={[{ label: 'Encyclopedia', href: sitePath('encyclopedia/') }, { label: category, href: sitePath('encyclopedia/radar-sensors/') }, { label: record.title }]}>
  <div class="ency ordnance sensors">
    <nav class="record-nav" aria-label={`${group.title} records`}>
      <ol>{siblings.map((r) => <li>{r.slug === record.slug ? <span aria-current="page">{label(r)}</span> : <a href={sitePath(recordRoute(r))}>{label(r)}</a>}</li>)}</ol>
    </nav>
    {leadPhoto && <PhotoFigure photo={leadPhoto} lead />}
    <section class="status-panel" data-record-id={record.id} data-record-revision={record.revision}>
      <p>Record revision {record.revision} · {record.summary}</p>
      <p>Real-world sensor as described in public sources. {caveat} The record describes the equipment; it is not a guide to employing it.</p>
    </section>

    <section class="data-plate" aria-labelledby="plate-title">
      <h2 id="plate-title">{data.name} · {record.designation}</h2>
      <dl>
        {plate.filter(([, text]) => text).map(([term, text]) => <div><dt>{term}</dt><dd><Cited text={text} /></dd></div>)}
        <div><dt>Carried by</dt><dd><ul>{data.carriers.map((c) => <li><Cited text={c} /></li>)}</ul></dd></div>
        {data.variants && <div><dt>Variants</dt><dd><ul>{data.variants.map((v) => <li><Cited text={v} /></li>)}</ul></dd></div>}
      </dl>
    </section>

    <div class="record-body"><LinkedText><Content /></LinkedText></div>
    {morePhotos.length > 0 && <div class="photo-grid">{morePhotos.map((photo) => <PhotoFigure photo={photo} />)}</div>}

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources</h2>
      <ol>
        {data.sources.map((s) => (
          <li id={`source-${s.n}`} value={s.n}><cite>{s.title}</cite>. {s.publisher}{s.date && `, ${s.date}`}. <a href={s.url}>{s.url}</a> (accessed {s.accessed}).{s.note && ` ${s.note}`}</li>
        ))}
      </ol>
      <p class="note">Wikipedia articles are secondary sources and can change; they are cited with the date they were read. FAS Military Analysis Network pages date from the late 1990s and describe the equipment as it was then.</p>
    </section>
  </div>
</SiteLayout>
