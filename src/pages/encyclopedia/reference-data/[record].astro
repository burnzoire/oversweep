---
import LinkedText from '../../../components/LinkedText.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import ReferenceTable from '../../../components/encyclopedia/ReferenceTable.astro';
import PhotoFigure from '../../../components/encyclopedia/PhotoFigure.astro';
import { categoryRecords, recordRoute, referenceContent, type EncyclopediaRecord } from '../../../data/encyclopedia';
import { categoryTitle } from '../../../data/availability';
import { sitePath } from '../../../lib/paths';
import '../../../styles/encyclopedia.css';

export function getStaticPaths() {
  return categoryRecords('reference-data').map((record) => ({ params: { record: record.slug }, props: { record } }));
}

const { record } = Astro.props as { record: EncyclopediaRecord };
const { frontmatter: data, Content } = referenceContent(record);
const category = categoryTitle(record.category);
const siblings = categoryRecords('reference-data');
---
<SiteLayout title={record.title} activeSection="encyclopedia"
  image={data.photo?.src} imageAlt={data.photo?.alt}
  description={`${record.title}: ${record.summary}`}
  breadcrumbs={[{ label: 'Encyclopedia', href: sitePath('encyclopedia/') }, { label: category, href: sitePath('encyclopedia/reference-data/') }, { label: record.title }]}>
  <div class="ency">
    {siblings.length > 1 && (
      <nav class="record-nav" aria-label={`${category} records`}>
        <ol>{siblings.map((r) => <li>{r.slug === record.slug ? <span aria-current="page">{referenceContent(r).frontmatter.short}</span> : <a href={sitePath(recordRoute(r))}>{referenceContent(r).frontmatter.short}</a>}</li>)}</ol>
      </nav>
    )}
    {data.photo && <PhotoFigure photo={data.photo} lead />}
    <section class="status-panel" data-record-id={record.id} data-record-revision={record.revision}>
      <h2>{record.maturity}</h2>
      <p>Record revision {record.revision} · {record.summary}</p>
      <p>Each table is kept here once and shown unchanged in the Manual modules that use it. Values are as the cited source prints them; the source's current edition takes precedence.</p>
    </section>

    <div class="record-body"><LinkedText><Content /></LinkedText></div>

    <h2 id="tables">Tables</h2>
    <ol class="ref-index">{data.tables.map((t) => <li><a href={`#table-${t.id}`}>{t.title}</a></li>)}</ol>
    {data.tables.map((t) => <ReferenceTable record={record.slug} table={t.id} onRecord />)}

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources</h2>
      <ol>
        {data.sources.map((s) => (
          <li id={`source-${s.n}`} value={s.n}><cite>{s.title}</cite>. {s.publisher}{s.date && `, ${s.date}`}. <a href={s.url}>{s.url}</a> (accessed {s.accessed}).{s.note && ` ${s.note}`}</li>
        ))}
      </ol>
    </section>
  </div>
</SiteLayout>
