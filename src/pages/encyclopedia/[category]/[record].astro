---
import LinkedText from '../../../components/LinkedText.astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import EnvelopeFigure from '../../../components/encyclopedia/EnvelopeFigure.astro';
import RwrFigure from '../../../components/encyclopedia/RwrFigure.astro';
import BatteryFigure from '../../../components/encyclopedia/BatteryFigure.astro';
import RecordPhoto from '../../../components/encyclopedia/RecordPhoto.astro';
import Cited from '../../../components/encyclopedia/Cited.astro';
import { categoryRecords, includedRecords, recordContent, recordRoute, type EncyclopediaRecord } from '../../../data/encyclopedia';
import { categoryTitle } from '../../../data/availability';
import { kmToNm, mToFt } from '../../../lib/envelope';
import { sitePath } from '../../../lib/paths';
import '../../../styles/encyclopedia.css';

export function getStaticPaths() {
  // Aircraft, ordnance, sensor, terminology, airfield and reference-data records have their own pages under src/pages/encyclopedia/.
  return includedRecords.filter((record) => !['aircraft', 'ordnance', 'radar-sensors', 'terminology', 'locations', 'reference-data'].includes(record.category)).map((record) => ({ params: { category: record.category, record: record.slug }, props: { record } }));
}

const { record } = Astro.props as { record: EncyclopediaRecord };
const { frontmatter: data, Content } = recordContent(record);
// Records are navigated and compared within their group (missiles, guns, radars).
const group = (r: EncyclopediaRecord) => recordContent(r).frontmatter.group;
const siblings = categoryRecords(record.category).filter((r) => group(r) === data.group);
const category = categoryTitle(record.category);
const cite = (ns: number[]) => ns.map((n) => `[${n}]`).join(' ');
const sourceFor = (pattern: RegExp) => data.sources.find((s) => pattern.test(s.url));
const rwrSource = sourceFor(/heatblur/);
const label = (r: EncyclopediaRecord) => r.title.split(' ')[0].replace(/^SA-/, '');
const items = siblings.flatMap((r) => { const envelope = recordContent(r).frontmatter.envelope; return envelope ? [{ slug: r.slug, label: label(r), name: r.title, envelope }] : []; });
const e = data.envelope;
const c = data.coverage;
const gun = data.group === 'aaa';
const nm = (km: number) => { const v = kmToNm(km); return v < 50 ? v.toFixed(1) : v.toFixed(0); };
const ft = (m: number) => { const f = mToFt(m); const step = f < 1000 ? 10 : 100; return Math.round(f / step) * step; };
const n = (v: number) => v.toLocaleString('en-GB');
const span = (lo: string | null, hi: string | null) => lo === null ? `up to ${hi}; minimum not given` : hi === null ? `from ${lo}; maximum not given` : `${lo}–${hi}`;
const distance = (km: number) => `${n(km)} km (${nm(km)} NM)`;
const height = (m: number) => `${n(m)} m (${n(ft(m))} ft)`;
const range = e && span(e.minRangeKm === null ? null : distance(e.minRangeKm), distance(e.maxRangeKm));
const alt = e && span(e.minAltM === null ? null : height(e.minAltM), e.maxAltM === null ? null : height(e.maxAltM));
// Figures are numbered in the order they appear, since not every record has every figure.
const fig = { envelope: e ? 1 : 0, rwr: e ? 2 : 1, battery: e ? 3 : 2 };
---
<SiteLayout title={record.title} activeSection="encyclopedia"
  image={data.photo?.src} imageAlt={data.photo?.alt}
  description={`${record.title} (${record.designation}): ${record.summary}`}
  breadcrumbs={[{ label: 'Encyclopedia', href: sitePath('encyclopedia/') }, { label: category, href: sitePath(`encyclopedia/${record.category}/`) }, { label: record.title }]}>
  <div class="ency">
    <nav class="record-nav" aria-label={`${category} records`}>
      <ol>{siblings.map((r) => <li>{r.slug === record.slug ? <span aria-current="page">{r.title.split(' ')[0]}</span> : <a href={sitePath(recordRoute(r))}>{r.title.split(' ')[0]}</a>}</li>)}</ol>
    </nav>
    <section class="status-panel" data-record-id={record.id} data-record-revision={record.revision}>
      <h2>{record.maturity}</h2>
      <p>Record revision {record.revision} · {record.summary}</p>
      <p>Real-world system as described in public sources. Figures vary between variants and sources, so differences are shown beside the number they affect. Simulator implementations may differ.</p>
    </section>

    <section class="data-plate" aria-labelledby="plate-title">
      <h2 id="plate-title">{data.nato} · {data.designation}</h2>
      <dl>
        <div><dt>Role</dt><dd><Cited text={data.role} /></dd></div>
        <div><dt>In service</dt><dd><Cited text={data.inService} /></dd></div>
        {data.guidance && <div><dt>{gun ? 'Fire control' : 'Guidance'}</dt><dd><Cited text={data.guidance} /></dd></div>}
        {e && <div><dt>{e.labels?.range ?? (gun ? 'Effective range' : 'Range')}</dt><dd>{range} <Cited text={cite(e.cite)} /></dd></div>}
        {e && <div><dt>{e.labels?.altitude ?? (gun ? 'Effective altitude' : 'Altitude')}</dt><dd>{alt} <Cited text={cite(e.cite)} /></dd></div>}
        {c && <div><dt>Detection range</dt><dd>Up to {distance(c.rangeKm)} <Cited text={cite(c.cite)} /></dd></div>}
        {c && <div><dt>Coverage ceiling</dt><dd>{c.altM === null ? 'Not given' : height(c.altM)} <Cited text={cite(c.cite)} /></dd></div>}
        <div><dt>Mobility and deployment</dt><dd><Cited text={data.mobility} /></dd></div>
        <div><dt>Radars</dt><dd>{data.radars.length ? <><ul>{data.radars.map((r) => <li><strong>{r.name}{r.nato && ` “${r.nato}”`}</strong>{r.band && ` (${r.band} band)`}: {r.role}</li>)}</ul>{data.radarsCite && <span>Sources: <Cited text={cite(data.radarsCite)} /></span>}</> : gun ? 'None: aimed optically' : 'None: infrared-guided'}</dd></div>
        <div><dt>RWR symbol</dt><dd>{data.rwr.length ? data.rwr.map((s) => <span><span class="symbol">{s.symbol}</span>{s.emitter} </span>) : 'None'}{rwrSource && data.rwr.length > 0 && <> <Cited text={`[${rwrSource.n}]`} /></>}</dd></div>
      </dl>
    </section>

    {data.photo && <RecordPhoto photo={data.photo} />}

    {e && (
      <EnvelopeFigure items={items} highlight={record.slug} from={gun ? 'gun' : 'launcher'} title={`Figure ${fig.envelope} — ${data.nato} engagement limits (side view)`}>
        {gun
          ? <p class="fig-caption"><Cited text={e.basis} /> The shaded region combines the published {(e.labels?.range ?? 'effective range').toLowerCase()}, treated as slant range from the gun, with the published {(e.labels?.altitude ?? 'effective altitude').toLowerCase()}. {e.labels ? 'These are not effective limits: a hit is far less likely near their edge, and the chance of one' : 'A gun\'s shells fly further than this, but beyond it the chance of a hit falls away, and it'} changes with target speed, crossing angle and how the gun is aimed. Dashed edges mark limits the cited sources do not give. Other guns in this section are drawn faintly for comparison. Each scale prints its vertical exaggeration.</p>
          : <p class="fig-caption"><Cited text={e.basis} /> The shaded region combines the published minimum and maximum range, treated as slant range from the launcher, with the minimum and maximum altitude. Real launch zones are smaller and change with target speed, aspect and altitude. Dashed edges mark limits the cited sources do not give. Other SAMs in this section are drawn faintly for comparison, labelled by SA number. Each scale prints its vertical exaggeration.</p>}
      </EnvelopeFigure>
    )}

    <div class="record-body"><LinkedText><Content /></LinkedText></div>

    <RwrFigure n={fig.rwr} symbols={data.rwr} name={data.nato} cite={rwrSource ? `[${rwrSource.n}]` : ''}>
      <Fragment slot="none"><Cited text={data.rwrNote} /></Fragment>
    </RwrFigure>

    {data.battery && <BatteryFigure n={fig.battery} battery={data.battery} name={data.nato} cite={cite(data.battery.cite)} />}

    <section class="sources" aria-labelledby="sources-title">
      <h2 id="sources-title">Sources</h2>
      <ol>
        {data.sources.map((s) => (
          <li id={`source-${s.n}`} value={s.n}><cite>{s.title}</cite>. {s.publisher}{s.date && `, ${s.date}`}. <a href={s.url}>{s.url}</a> (accessed {s.accessed}).{s.note && ` ${s.note}`}</li>
        ))}
      </ol>
      <p class="note">Wikipedia articles are secondary sources and can change; they are cited with the date they were read. The Heatblur manual describes the DCS F-14's AN/ALR-67, not every aircraft's radar warning receiver.</p>
    </section>
  </div>
</SiteLayout>
