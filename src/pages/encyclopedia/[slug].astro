---
import SiteLayout from "../../layouts/SiteLayout.astro";
import RecordCard from "../../components/encyclopedia/RecordCard.astro";
import FilterBar from "../../components/encyclopedia/FilterBar.astro";
import EnvelopeFigure from "../../components/encyclopedia/EnvelopeFigure.astro";
import Glossary from "../../components/encyclopedia/Glossary.astro";
import { encyclopediaCategories } from "../../data/catalogue";
import { sectionHasContent } from "../../data/availability";
import { ilsLines, navaidLines, runwayLines, towerLines, towerNote } from "../../data/map-airfield-text";
import { airfieldCatalogue, aircraftContent, mapAirfieldAnchor, simAirfields, aircraftEra, aircraftEras, aircraftGroups, categoryRecords, ordnanceContent, ordnanceGroups, recordContent, threatGroups, sensorContent, sensorGroups, recordRoute } from "../../data/encyclopedia";
import { sitePath } from "../../lib/paths";
import { aircraftFacets, aircraftFilter, buildFacets, filterAttributes, ordnanceFacets, ordnanceFilter, searchText, sensorFacets, sensorFilter, threatFacets, threatFilter, type FilterItem } from "../../data/record-facets";
import { airfieldRoles, branches, currentUse, nations, searchTerms, sims, useLabels } from "../../data/airfield-model.mjs";
import "../../styles/encyclopedia.css";

export function getStaticPaths() {
  return encyclopediaCategories.filter((category) => category.slug !== "carriers").map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const records = categoryRecords(category.slug).map((record) => ({ record, data: recordContent(record).frontmatter }));
// Threat systems are listed by group: missiles and guns each get an envelope
// comparison and a quick-reference table; radars get a coverage table.
const threats = category.slug === "threat-systems"
  ? threatGroups.map((group) => ({ group, records: records.filter(({ data }) => (data.group ?? "sam") === group.slug).map((x) => ({ ...x, filter: threatFilter(x.record, x.data) })) })).filter(({ records }) => records.length > 0)
  : [];
const envelopeCaption: Record<string, string> = {
  sam: "Each region combines a system's published minimum and maximum range, treated as slant range from the launcher, with its minimum and maximum altitude, using the figures and sources on its record page. Labels are SA numbers. Real launch zones are smaller and change with target speed, aspect and altitude. Dashed edges mark limits the sources do not give; where the sources give no ceiling, as for the SA-9, only the range is drawn. Each scale prints its vertical exaggeration.",
  "sam-western": "Each region combines a system's published minimum and maximum range, treated as slant range from the launcher, with its minimum and maximum altitude, using the figures and sources on its record page; the record says which missile the figures describe. Real launch zones are smaller and change with target speed, aspect and altitude. Dashed edges mark limits the sources do not give. Each scale prints its vertical exaggeration.",
  "sam-chinese": "Each region combines a system's published maximum range, treated as slant range from the launcher, with its altitude limits where the sources give them, using the figures and sources on its record page. Dashed edges mark limits the sources do not give; where they give no ceiling, only the range is drawn. Real launch zones are smaller and change with target speed, aspect and altitude. Each scale prints its vertical exaggeration.",
  aaa: "Each region combines a gun's published effective range, treated as slant range from the gun, with its effective altitude, using the figures and sources on its record page. Shells fly further than this, but beyond it the chance of a hit falls away. Where a source gives no effective figure, the record's own label says what is drawn instead, as the table below shows. Dashed edges mark limits the sources do not give. Each scale prints its vertical exaggeration.",
};
const origin: Record<string, string> = { sam: "Soviet and Russian", "sam-western": "Western", "sam-chinese": "Chinese" };
const label = (title: string, short?: string) => short ?? title.split(" ")[0].replace(/^SA-/, "");
// Citation numbers belong to each record's own source list, so the table drops them.
const plain = (text: string) => text.replace(/\s*\[\d+\]/g, "");
const km = (value: number) => `${Number(value.toFixed(1)).toLocaleString("en-GB")} km`;
// Aircraft are listed by group (jets, propeller aircraft, helicopters), newest era first.
const eraOrder = (era: string) => aircraftEras.findIndex((e) => e.slug === era);
const aircraftRecords = category.slug === "aircraft"
  ? categoryRecords("aircraft").map((record) => {
    const era = aircraftEra(record);
    const data = aircraftContent(record).frontmatter;
    return { record, era, data, filter: aircraftFilter(record, era, data) };
  })
  : [];
const aircraft = aircraftGroups
  .map((group) => ({ group, records: aircraftRecords.filter(({ data }) => data.group === group.slug).sort((a, b) => eraOrder(a.era) - eraOrder(b.era)) }))
  .filter(({ records }) => records.length > 0);
// Table rows filter with their cards but are not counted.
const row = (filter: FilterItem) => filterAttributes({ ...filter, count: undefined });
const n = (value: number) => value.toLocaleString("en-GB");
// Ordnance is listed by group (bombs, cluster bombs, rockets and so on).
const ordnanceRecords = category.slug === "ordnance"
  ? categoryRecords("ordnance").map((record) => {
    const data = ordnanceContent(record).frontmatter;
    return { record, data, filter: ordnanceFilter(record, data) };
  })
  : [];
const ordnance = ordnanceGroups
  .map((group) => ({ group, records: ordnanceRecords.filter(({ data }) => data.group === group.slug) }))
  .filter(({ records }) => records.length > 0);
// Sensors are listed by group, like ordnance.
const sensors = category.slug === "radar-sensors"
  ? sensorGroups
    .map((group) => ({ group, records: categoryRecords("radar-sensors").map((record) => {
      const data = sensorContent(record).frontmatter;
      return { record, data, filter: sensorFilter(record, data) };
    }).filter(({ data }) => data.group === group.slug) }))
    .filter(({ records }) => records.length > 0)
  : [];
const facets = {
  aircraft: aircraftFacets(aircraftRecords.map((x) => x.filter)),
  ordnance: ordnanceFacets(ordnanceRecords.map((x) => x.filter)),
  sensors: sensorFacets(sensors.flatMap((g) => g.records.map((x) => x.filter))),
  threats: threatFacets(threats.flatMap((g) => g.records.map((x) => x.filter))),
};
// Airfields are one index, searchable and filtered by country, theatre, sim
// map and service. Theatres list their sim maps under each one.
const airfieldData = category.slug === "locations" ? airfieldCatalogue() : undefined;
const byTitle = <T extends { record: { title: string } }>(list: T[]) => [...list].sort((a, b) => a.record.title.localeCompare(b.record.title, "en"));
const airfieldIndex = airfieldData ? byTitle(airfieldData.airfields).map((entry) => {
  const { record, data } = entry;
  const represented = entry.maps.filter((x) => x.coverage.status === "represented");
  const services = [...new Set((data.operators ?? []).filter((o) => !o.to).map((o) => o.branch))];
  return {
    ...entry,
    represented,
    services,
    use: currentUse(data.operators ?? []),
    aliases: (data.names ?? []).map((x) => x.name),
    filter: {
      count: "records",
      search: searchText([searchTerms(record.slug, data, represented.flatMap((x) => x.coverage.inSimName ?? []))]),
      values: {
        country: [data.country],
        theatre: entry.theatres.map((x) => x.record.slug),
        map: represented.map((x) => x.record.slug),
        service: services,
      },
    } as FilterItem,
  };
}) : [];
// Every airfield on every sim map, with or without a record yet.
const simIndex = category.slug === "locations" && airfieldData ? simAirfields().map((x) => {
  const indexed = airfieldIndex.find((a) => a.record === x.record?.record);
  return {
    ...x,
    filter: {
      search: searchText([indexed?.filter.search, ...x.names]),
      values: {
        country: indexed?.filter.values.country ?? [],
        theatre: x.theatres.map((t) => t.record.slug),
        map: [...new Set(x.maps.map((m) => m.map.record.slug))],
        service: indexed?.filter.values.service ?? [],
      },
    } as FilterItem,
  };
}) : [];
// Location facets count every airfield once: the records, then the sim-map airfields without one.
const locationFacets = airfieldData ? buildFacets([...airfieldIndex, ...simIndex.filter((x) => !x.record)].map((a) => a.filter), [
  { key: "country", label: "Country or territory", any: "Any", labels: Object.fromEntries(Object.entries(nations).map(([k, v]) => [k, v.name])) },
  { key: "theatre", label: "Theatre", any: "Any", order: byTitle(airfieldData.theatres).map((x) => ({ slug: x.record.slug, title: x.record.title })) },
  { key: "map", label: "Sim map", any: "Any, or none checked", order: airfieldData.maps.map((x) => ({ slug: x.record.slug, title: x.data.name })) },
  { key: "service", label: "Service", any: "Any", order: Object.entries(branches).map(([k, v]) => ({ slug: k, title: v })) },
]) : [];
const ft = (feet: number) => `${n(feet)} ft (${n(Math.round(feet * 0.3048))} m)`;
const weight = (kg: number) => `${n(kg)} kg (${n(Math.round(kg * 2.20462))} lb)`;
---

<SiteLayout
  title={category.title}
  activeSection="encyclopedia"
  empty={records.length === 0}
  breadcrumbs={[
    { label: "Encyclopedia", href: sectionHasContent.encyclopedia ? sitePath("encyclopedia/") : undefined },
    { label: category.title },
  ]}
>
  {records.length === 0 ? (
    <p class="empty-note">No {category.title.toLowerCase()} records are published yet. {sectionHasContent.encyclopedia
      ? <>Categories with records are linked from the <a href={sitePath("encyclopedia/")}>Encyclopedia</a>.</>
      : <>Start with the <a href={sitePath("manual/")}>Manual</a> instead.</>}</p>
  ) : (
    <div class="ency">
      {category.slug === "threat-systems" && (
        <p class="lead">Ground-based air defences a pilot may face: surface-to-air missile systems from the SA-1 to the SA-19, the anti-aircraft guns that defend troops and targets at low level, and the early-warning radars that find aircraft at long range and cue missiles and fighters onto them. Most are Soviet systems first fielded between the 1950s and the 1990s and still met, in upgraded versions, in conflicts and simulators; the western guns are here because they appear in simulators and in many air forces. Each record gives the system's radars, guidance or fire control, published engagement limits or radar coverage, and what it shows on a radar warning receiver, with sources.</p>
      )}
      {category.slug === "aircraft" ? (
        <>
          <p class="lead">Military aircraft from the Second World War to today: fighters, attack aircraft, trainers, a transport and helicopters. The Second World War aircraft are here for their history; use the filters to show only the aircraft you need. Each record gives the aircraft's role, the variant its figures describe, performance, armament and service history, with sources.</p>
          <FilterBar id="aircraft" label="Find an aircraft" search={{ label: "Aircraft name or designation", placeholder: "e.g. Hornet, F-16 or MiG" }} facets={facets.aircraft} nouns={{ records: "aircraft" }} />
          {aircraft.map(({ group, records }) => (
            <div class="aircraft-group" data-filter-group>
              <h2>{group.title}</h2>
              <div class="entry-grid record-grid">
                {records.map(({ record, data, filter }) => <RecordCard record={record} photo={data.photos[0]} filter={filter} />)}
              </div>
            </div>
          ))}
          <h2>Quick reference</h2>
          <div class="table-scroll" role="region" aria-label="Aircraft quick reference table, scrolls sideways on narrow screens" tabindex="0">
            <table>
              <thead><tr><th scope="col">Aircraft</th><th scope="col">Role</th><th scope="col">First flight</th><th scope="col">Max speed</th><th scope="col">Ceiling</th></tr></thead>
              {aircraft.map(({ group, records }) => (
                <tbody data-filter-group>
                  <tr><th scope="rowgroup" colspan="5">{group.title}</th></tr>
                  {records.map(({ record, data, filter }) => (
                    <tr {...row(filter)}>
                      <th scope="row"><a href={sitePath(recordRoute(record))}>{record.title}</a><br /><span class="entry-kicker">{record.designation}</span></th>
                      <td>{plain(data.role)}</td>
                      <td>{data.quick.firstFlight}</td>
                      <td>{data.quick.maxSpeedKt === null ? "not given" : `${n(data.quick.maxSpeedKt)} kt`}</td>
                      <td>{data.quick.ceilingFt === null ? "not given" : `${n(data.quick.ceilingFt)} ft`}</td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
          <p class="note">Speeds are true airspeed at the altitude given on each record, for the variant named there; each record cites its sources and notes other published figures.</p>
        </>
      ) : category.slug === "ordnance" ? (
        <>
          <p class="lead">Weapons carried by military aircraft of every service. So far it covers air-to-air missiles and aircraft guns from the 1950s to today; guided air-to-ground weapons, from laser-guided bombs and GPS kits to anti-radiation, anti-ship and anti-tank missiles; and unguided weapons: the US Mark 80 general-purpose bombs and their Soviet counterparts, cluster bombs, fire and practice bombs, and air-to-ground rockets from the Second World War on. Each record gives the weapon's weight, warhead or ammunition, guidance or fuzing, and which aircraft carry it, with sources. Published air-to-air missile ranges are best cases, and each air-to-air record says what its figure depends on.</p>
          <FilterBar id="ordnance" label="Find a weapon" search={{ label: "Weapon name or designation", placeholder: "e.g. Sidewinder, GBU-12 or Kh-29" }} facets={facets.ordnance} nouns={{ records: "weapons" }} />
          {ordnance.map(({ group, records }) => (
            <div class="aircraft-group" data-filter-group>
              <h2>{group.title}</h2>
              <div class="entry-grid record-grid">
                {records.map(({ record, data, filter }) => <RecordCard record={record} photo={data.photos[0]} filter={filter} />)}
              </div>
            </div>
          ))}
          <h2>Quick reference</h2>
          <div class="table-scroll" role="region" aria-label="Ordnance quick reference table, scrolls sideways on narrow screens" tabindex="0">
            <table>
              <thead><tr><th scope="col">Weapon</th><th scope="col">Type</th><th scope="col">Weight</th><th scope="col">Entered service</th></tr></thead>
              {ordnance.map(({ group, records }) => (
                <tbody data-filter-group>
                  <tr><th scope="rowgroup" colspan="4">{group.title}</th></tr>
                  {records.map(({ record, data, filter }) => (
                    <tr {...row(filter)}>
                      <th scope="row"><a href={sitePath(recordRoute(record))}>{record.title}</a><br /><span class="entry-kicker">{record.designation}</span></th>
                      <td>{plain(data.type)}</td>
                      <td>{data.quick.weightKg === null ? "not given" : weight(data.quick.weightKg)}</td>
                      <td>{data.quick.introduced ?? "not given"}</td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
          <p class="note">Weights are for the variant named on each record, rounded; a rocket's weight is one complete round, and a gun's is the gun alone unless its record says otherwise. Each record cites its sources and notes other published figures.</p>
        </>
      ) : category.slug === "radar-sensors" ? (
        <>
          <p class="lead">Sensors carried by military aircraft: the fighter radars that find and track targets, the <a href={sitePath("encyclopedia/terminology/sensors/#radar-warning-receiver")}>radar warning receivers</a> that tell a crew who is looking at them, and the targeting pods and helicopter sights that find, track and laser-mark targets for guided weapons, and the dispensers and jamming pods that protect the aircraft. Each record gives what the sensor is, which aircraft carry it, what the crew sees and where it came from, with sources.</p>
          <FilterBar id="sensors" label="Find a sensor" search={{ label: "Sensor name or designation", placeholder: "e.g. APG-68, Sniper or SPO-15" }} facets={facets.sensors} nouns={{ records: "sensors" }} />
          {sensors.map(({ group, records }) => (
            <div class="aircraft-group" data-filter-group>
              <h2>{group.title}</h2>
              <div class="entry-grid record-grid">
                {records.map(({ record, data, filter }) => <RecordCard record={record} photo={data.photos[0]} filter={filter} />)}
              </div>
            </div>
          ))}
          <h2>Quick reference</h2>
          <div class="table-scroll" role="region" aria-label="Sensor quick reference table, scrolls sideways on narrow screens" tabindex="0">
            <table>
              <thead><tr><th scope="col">Sensor</th><th scope="col">Type</th><th scope="col">Band, or whether it lases</th><th scope="col">Entered service</th></tr></thead>
              {sensors.map(({ group, records }) => (
                <tbody data-filter-group>
                  <tr><th scope="rowgroup" colspan="4">{group.title}</th></tr>
                  {records.map(({ record, data, filter }) => (
                    <tr {...row(filter)}>
                      <th scope="row"><a href={sitePath(recordRoute(record))}>{record.title}</a><br /><span class="entry-kicker">{record.designation}</span></th>
                      <td>{plain(data.type)}</td>
                      <td>{group.slug === "targeting-pod" || data.quick.designates ? (data.quick.designates ? "Lases targets" : "No laser; it only tracks a spot") : data.quick.band ?? (data.band ? plain(data.band) : "not given")}</td>
                      <td>{data.quick.introduced ?? "not given"}</td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
          <p class="note">Each record cites its sources. Radars, receivers and pods are upgraded in service, so a record's figures are for the variant it names.</p>
        </>
      ) : category.slug === "locations" && airfieldData ? (
        <>
          <p class="lead">Theatres, simulator maps and airfields. Browse a region or find an airfield below. An airfield with no map listed has not been checked yet.</p>
          <nav class="theatre-jump" aria-label="Browse locations"><ul><li><a href="#browse-theatres">Theatres</a></li><li><a href="#airfield-index">Find a location</a></li><li><a href="#sim-airfields">Every represented airfield</a></li></ul></nav>
          <section aria-labelledby="browse-theatres">
            <h2 id="browse-theatres">Browse theatres</h2>
            <p>Explore a region, then choose a simulator map for its setting and airfields.</p>
            <div class="entry-grid record-grid">
              {byTitle(airfieldData.theatres).map((x) => (
                <RecordCard record={x.record} photo={x.data.photos[0]}>
                  <p class="card-list"><strong>{x.maps.length} {x.maps.length === 1 ? "map" : "maps"} represented</strong></p>
                  {x.maps.length > 0 && <ul class="card-list">{x.maps.map((m) => <li><a href={sitePath(recordRoute(m.record))}>{m.data.name}</a> <span class="cell-note">{sims[m.data.sim]}</span></li>)}</ul>}
                </RecordCard>
              ))}
            </div>
          </section>
          <h2 id="airfield-index">Find a location</h2>
          <FilterBar id="airfield" label="Find a location" search={{ label: "Location name, former name or identifier", placeholder: "e.g. Isely, KLSV or Batumi" }} facets={locationFacets} nouns={{ records: "airfield records", rows: "airfields on the sim maps" }} />

          <section data-filter-group>
          <h2>Airfields</h2>
          <div class="entry-grid record-grid airfield-index">
            {airfieldIndex.map((a) => (
              <RecordCard record={a.record} photo={a.data.photos[0]} filter={a.filter}>
                <dl class="card-facts">
                  <div><dt>Where</dt><dd>{nations[a.data.country].name}</dd></div>
                  {a.aliases.length > 0 && <div><dt>Also</dt><dd>{a.aliases.join(" · ")}</dd></div>}
                  <div><dt>Use</dt><dd>{useLabels[a.use]}</dd></div>
                  <div><dt>Roles</dt><dd>{a.data.roles.length ? a.data.roles.map((r) => airfieldRoles[r]).join(", ") : "None"}</dd></div>
                  <div><dt>Represented in</dt><dd>{a.represented.length ? a.represented.map((x, i) => <>{i > 0 && ", "}<a href={sitePath(recordRoute(x.record))}>{x.data.name}</a></>)
                    : a.maps.some((x) => x.coverage.status === "absent") ? <>No map checked so far; not on {a.maps.filter((x) => x.coverage.status === "absent").map((x, i) => <>{i > 0 && ", "}<a href={sitePath(recordRoute(x.record))}>{x.data.name}</a></>)}</>
                    : "No map checked yet"}</dd></div>
                </dl>
              </RecordCard>
            ))}
          </div>
          </section>
          <section data-filter-group>
          <h2 id="sim-airfields">Every represented airfield</h2>
          <p>Every airfield with a runway on each DCS World map, with its runways, tower frequencies, navaids and ILS as the game has them. An airfield on more than one map gets a line for each map. {simIndex.filter((x) => x.record).length} of {simIndex.length} have a full record so far; more are being added theatre by theatre, the major military bases first.</p>
          <div class="table-scroll" role="region" aria-label="Every represented airfield, scrolls sideways on narrow screens" tabindex="0">
            <table class="airfield-table sim-airfield-table">
              <thead><tr><th scope="col">Airfield</th><th scope="col">Map and name in the sim</th><th scope="col">Elevation</th><th scope="col">Runways (magnetic)</th><th scope="col">Tower (MHz)</th><th scope="col">TACAN, VOR and NDB</th><th scope="col">ILS</th></tr></thead>
              <tbody>
                {simIndex.flatMap((x) => x.maps.map((m, i) => (
                  <tr class={i === 0 ? "sim-airfield" : "sim-airfield-more"} {...filterAttributes({ ...x.filter, count: i === 0 ? "rows" : undefined })}>
                    {i === 0 && <th scope="row" rowspan={x.maps.length}>{x.record ? <a href={sitePath(recordRoute(x.record.record))}>{x.name}</a> : x.name}<span class="cell-note">{x.theatres.map((t) => t.record.title).join(", ")}{!x.record && " · record not written yet"}</span></th>}
                    <td><a href={`${sitePath(recordRoute(m.map.record))}#${mapAirfieldAnchor(m.name)}`}>{m.map.data.name}</a>{m.name !== x.name && <span class="cell-note">as {m.name}</span>}</td>
                    <td>{m.field.elevationFt === undefined ? "—" : `${n(m.field.elevationFt)} ft`}</td>
                    <td>{runwayLines(m.field).map((t) => <span class="cell-line">{t}</span>)}</td>
                    <td>{towerLines(m.field).length ? <>{towerLines(m.field).map((t) => <span class="cell-line">{t}</span>)}{towerNote(m.field) && <span class="cell-note">{towerNote(m.field)}</span>}{m.field.radioSource && <span class="cell-note">from pydcs</span>}</> : "—"}</td>
                    <td>{m.source.beacons ? (navaidLines(m.field).length ? navaidLines(m.field).map((t) => <span class="cell-line">{t}</span>) : "—") : "not in this data"}</td>
                    <td>{m.source.beacons ? (ilsLines(m.field).length ? ilsLines(m.field).map((t) => <span class="cell-line">{t}</span>) : "—") : "not in this data"}</td>
                  </tr>
                )))}
              </tbody>
            </table>
          </div>
          <p class="note">Source: each map's game data, cited on its map page: <a href="https://github.com/YoloWingPixie/dcs-world-schema">dcs-world-schema</a>, extracted by running DCS World, with <a href="https://github.com/pydcs/dcs">pydcs</a> for The Channel and for tower radios the extraction lacks. These are the game's values, not the real airfield's: runway headings are magnetic as the game computes them. The game gives TACAN channels no X or Y band; where a beacon's listed frequency settles it, the band is shown, and * marks an assumed X. A dash means the game gives none. Not for real-world navigation.</p>
          </section>

        </>
      ) : category.slug === "threat-systems" ? (
        <>
          <FilterBar id="threats" label="Find a threat system" search={{ label: "System name, NATO name or designation", placeholder: "e.g. SA-6, Gainful or Patriot" }} facets={facets.threats} nouns={{ records: "systems" }} />
          {threats.map(({ group, records }) => (
            <div class="aircraft-group" data-filter-group>
              <h2>{group.title}</h2>
              <div class="entry-grid record-grid">
                {records.map(({ record, data, filter }) => <RecordCard record={record} photo={data.photo} filter={filter} />)}
              </div>
            </div>
          ))}
          {threats.map(({ group, records }, i) => {
            const withEnvelopes = records.filter(({ data }) => data.envelope);
            const figure = threats.slice(0, i).filter((t) => t.records.some(({ data }) => data.envelope)).length + 1;
            return group.slug === "ewr" ? (
              <>
                <h2>Compare the early-warning radars</h2>
                <div class="table-scroll" role="region" aria-label="Early-warning radar table, scrolls sideways on narrow screens" tabindex="0">
                  <table>
                    <thead><tr><th scope="col">Radar</th><th scope="col">In service</th><th scope="col">Detection range</th><th scope="col">Coverage ceiling</th><th scope="col">RWR symbol (DCS F-14)</th></tr></thead>
                    <tbody>
                      {records.map(({ record, data }) => (
                        <tr>
                          <th scope="row"><a href={sitePath(recordRoute(record))}>{record.title}</a><br /><span class="entry-kicker">{record.designation}</span></th>
                          <td>{plain(data.inService)}</td>
                          <td>{data.coverage ? km(data.coverage.rangeKm) : "not given"}</td>
                          <td>{data.coverage?.altM ? km(data.coverage.altM / 1000) : "not given"}</td>
                          <td>{data.rwr.length ? data.rwr.map((s) => s.symbol).join(", ") : "none"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="note">Detection ranges are the best case each source gives; a radar sees a low or small aircraft much closer than that, and nothing below its horizon. Each record cites its sources.</p>
              </>
            ) : withEnvelopes.length > 0 && (
              <>
                <h2>{group.slug === "aaa" ? "Compare the guns" : `Compare the ${origin[group.slug]} missile envelopes`}</h2>
                <EnvelopeFigure title={`Figure ${figure} — ${group.slug === "aaa" ? "Published effective range and altitude of the guns" : `Published engagement limits of the ${origin[group.slug]} missile systems`} (side view)`} defaultScale={group.slug === "aaa" ? "point" : undefined} from={group.slug === "aaa" ? "gun" : "launcher"} items={withEnvelopes.map(({ record, data }) => ({ slug: record.slug, label: label(record.title, data.short), name: record.title, envelope: data.envelope! }))}>
                  <p class="fig-caption">{envelopeCaption[group.slug]}</p>
                </EnvelopeFigure>
                <div class="table-scroll" role="region" aria-label={`${group.title} quick reference table, scrolls sideways on narrow screens`} tabindex="0">
                  <table>
                    <thead><tr><th scope="col">System</th><th scope="col">{group.slug === "aaa" ? "Fire control" : "Guidance"}</th><th scope="col">{group.slug === "aaa" ? "Effective range" : "Max range"}</th><th scope="col">{group.slug === "aaa" ? "Effective altitude" : "Ceiling"}</th><th scope="col">RWR symbol (DCS F-14)</th></tr></thead>
                    <tbody>
                      {withEnvelopes.map(({ record, data }) => (
                        <tr>
                          <th scope="row"><a href={sitePath(recordRoute(record))}>{record.title}</a><br /><span class="entry-kicker">{record.designation}</span></th>
                          <td>{plain(data.guidance ?? "")}</td>
                          <td>{km(data.envelope!.maxRangeKm)}{data.envelope!.labels && <><br /><span class="entry-kicker">{data.envelope!.labels.range.toLowerCase()}</span></>}</td>
                          <td>{data.envelope!.maxAltM === null ? "not given" : km(data.envelope!.maxAltM / 1000)}{data.envelope!.labels && data.envelope!.maxAltM !== null && <><br /><span class="entry-kicker">{data.envelope!.labels.altitude.toLowerCase()}</span></>}</td>
                          <td>{data.rwr.length ? data.rwr.map((s) => s.symbol).join(", ") : "none"}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="note">Figures are the variant drawn in Figure {figure}; each record cites its sources and lists the other published figures.</p>
              </>
            );
          })}
        </>
      ) : category.slug === "terminology" ? (
        <Glossary />
      ) : (
        <>
          <h2>Records</h2>
          <div class="entry-grid record-grid">
            {records.map(({ record }) => <RecordCard record={record} />)}
          </div>
        </>
      )}
    </div>
  )}
</SiteLayout>

<script>import "../../scripts/record-filter.mjs";</script>
