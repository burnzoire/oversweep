---
import SiteLayout from "../../layouts/SiteLayout.astro";
import RecordCard from "../../components/encyclopedia/RecordCard.astro";
import EnvelopeFigure from "../../components/encyclopedia/EnvelopeFigure.astro";
import DeliveryFigure from "../../components/encyclopedia/DeliveryFigure.astro";
import Cited from "../../components/encyclopedia/Cited.astro";
import Glossary from "../../components/encyclopedia/Glossary.astro";
import { encyclopediaCategories } from "../../data/catalogue";
import { sectionHasContent } from "../../data/availability";
import { ilsLines, navaidLines, runwayLines, towerLines, towerNote } from "../../data/map-airfield-text";
import { airfieldCatalogue, aircraftContent, mapAirfieldAnchor, simAirfields, aircraftEra, aircraftEras, aircraftGroups, categoryRecords, ordnanceContent, ordnanceGroups, recordContent, recordRoute, type Source } from "../../data/encyclopedia";
import { sitePath } from "../../lib/paths";
import { airfieldRoles, branches, currentUse, nations, searchTerms, sims, useLabels } from "../../data/airfield-model.mjs";
import "../../styles/encyclopedia.css";

export function getStaticPaths() {
  return encyclopediaCategories.filter((category) => category.slug !== "carriers").map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const records = categoryRecords(category.slug).map((record) => ({ record, data: recordContent(record).frontmatter }));
const withEnvelopes = records.filter(({ data }) => data.envelope);
const label = (title: string) => title.split(" ")[0].replace(/^SA-/, "");
// Citation numbers belong to each record's own source list, so the table drops them.
const plain = (text: string) => text.replace(/\s*\[\d+\]/g, "");
const km = (value: number) => `${Number(value.toFixed(1)).toLocaleString("en-GB")} km`;
// Aircraft are listed by group (jets, propeller aircraft, helicopters), newest era first.
const eraOrder = (era: string) => aircraftEras.findIndex((e) => e.slug === era);
const aircraftRecords = category.slug === "aircraft"
  ? categoryRecords("aircraft").map((record) => ({ record, era: aircraftEra(record), data: aircraftContent(record).frontmatter }))
  : [];
const aircraft = aircraftGroups
  .map((group) => ({ group, records: aircraftRecords.filter(({ data }) => data.group === group.slug).sort((a, b) => eraOrder(a.era) - eraOrder(b.era)) }))
  .filter(({ records }) => records.length > 0);
const eraCounts = aircraftEras.map((era) => ({ era, count: aircraftRecords.filter((r) => r.era === era.slug).length })).filter(({ count }) => count > 0);
const n = (value: number) => value.toLocaleString("en-GB");
// Ordnance is listed by group (bombs, cluster bombs, rockets and so on).
const ordnanceRecords = category.slug === "ordnance"
  ? categoryRecords("ordnance").map((record) => ({ record, data: ordnanceContent(record).frontmatter }))
  : [];
const ordnance = ordnanceGroups
  .map((group) => ({ group, records: ordnanceRecords.filter(({ data }) => data.group === group.slug) }))
  .filter(({ records }) => records.length > 0);
// Airfields are one index, searchable and filtered by country, theatre, sim
// map and service. Theatres list their sim maps under each one.
const airfieldData = category.slug === "locations" ? airfieldCatalogue() : undefined;
const byTitle = <T extends { record: { title: string } }>(list: T[]) => [...list].sort((a, b) => a.record.title.localeCompare(b.record.title, "en"));
const airfieldIndex = airfieldData ? byTitle(airfieldData.airfields).map((entry) => {
  const { record, data } = entry;
  const represented = entry.maps.filter((x) => x.coverage.status === "represented");
  const services = [...new Set((data.operators ?? []).filter((o) => !o.to).map((o) => o.branch))];
  return {
    ...entry,
    represented,
    services,
    use: currentUse(data.operators ?? []),
    aliases: (data.names ?? []).map((x) => x.name),
    filter: {
      search: searchTerms(record.slug, data, represented.flatMap((x) => x.coverage.inSimName ?? [])),
      country: data.country,
      theatres: entry.theatres.map((x) => x.record.slug).join(" "),
      maps: represented.map((x) => x.record.slug).join(" "),
      services: services.join(" "),
    },
  };
}) : [];
// Every airfield on every sim map, with or without a record yet.
const simIndex = category.slug === "locations" && airfieldData ? simAirfields().map((x) => {
  const indexed = airfieldIndex.find((a) => a.record === x.record?.record);
  return {
    ...x,
    filter: {
      search: [indexed?.filter.search, ...x.names].filter(Boolean).join(" | ").toLowerCase(),
      country: indexed?.filter.country ?? "",
      theatres: x.theatres.map((t) => t.record.slug).join(" "),
      maps: [...new Set(x.maps.map((m) => m.map.record.slug))].join(" "),
      services: indexed?.filter.services ?? "",
    },
  };
}) : [];
const usedNations = [...new Set(airfieldIndex.map((a) => a.data.country))].sort((a, b) => nations[a].name.localeCompare(nations[b].name));
const usedServices = Object.keys(branches).filter((b) => airfieldIndex.some((a) => a.services.includes(b as keyof typeof branches))) as (keyof typeof branches)[];
const mapName = (x: { data: { name: string } }) => x.data.name;
const ft = (feet: number) => `${n(feet)} ft (${n(Math.round(feet * 0.3048))} m)`;
const weight = (kg: number) => `${n(kg)} kg (${n(Math.round(kg * 2.20462))} lb)`;
// Sources for the delivery figure on the ordnance page; records cite their own.
const deliverySources: Source[] = [
  { n: 1, title: "Aviation Ordnanceman, NAVEDTRA 14313, chapter 1: Bombs, fuzes and associated components", publisher: "US Navy, Naval Education and Training Professional Development and Technology Center (copy hosted by Integrated Publishing)", url: "https://navyaviation.tpub.com/14313/css/Bsu-85-B-Air-Inflatable-Retarder-36.htm", accessed: "2026-10-26", note: "Printed page 1-26: Snakeye retarded, unretarded and in-flight selection modes." },
  { n: 2, title: "Toss bombing", publisher: "Wikipedia (secondary source)", url: "https://en.wikipedia.org/wiki/Toss_bombing", accessed: "2026-10-26" },
  { n: 3, title: "Dive bomber", publisher: "Wikipedia (secondary source)", url: "https://en.wikipedia.org/wiki/Dive_bomber", accessed: "2026-10-26" },
  { n: 4, title: "Unguided bomb", publisher: "Wikipedia (secondary source)", url: "https://en.wikipedia.org/wiki/Unguided_bomb", accessed: "2026-10-26" },
];
---

<SiteLayout
  title={category.title}
  activeSection="encyclopedia"
  empty={records.length === 0}
  breadcrumbs={[
    { label: "Encyclopedia", href: sectionHasContent.encyclopedia ? sitePath("encyclopedia/") : undefined },
    { label: category.title },
  ]}
>
  {records.length === 0 ? (
    <p class="empty-note">No {category.title.toLowerCase()} records are published yet. {sectionHasContent.encyclopedia
      ? <>Categories with records are linked from the <a href={sitePath("encyclopedia/")}>Encyclopedia</a>.</>
      : <>Start with the <a href={sitePath("manual/")}>Manual</a> instead.</>}</p>
  ) : (
    <div class="ency">
      {category.slug === "threat-systems" && (
        <p class="lead">Surface-to-air missile systems a pilot may face, from the SA-1 to the SA-19: Soviet systems first fielded between the 1950s and the 1990s, many still met, in upgraded versions, in conflicts and simulators. Each record gives the system's radars, guidance, published engagement limits and what it shows on a radar warning receiver, with sources.</p>
      )}
      {category.slug === "aircraft" ? (
        <>
          <p class="lead">Military aircraft from the Second World War to today: fighters, attack aircraft, trainers, a transport and helicopters. The Second World War aircraft are here for their history; use the era buttons to show only the aircraft you need. Each record gives the aircraft's role, the variant its figures describe, performance, armament and service history, with sources.</p>
          <div class="buttons era-filter" role="group" aria-label="Show aircraft by era" hidden>
            <button type="button" data-era-filter="all" aria-pressed="true">All ({aircraftRecords.length})</button>
            {eraCounts.map(({ era, count }) => <button type="button" data-era-filter={era.slug} aria-pressed="false">{era.title} ({count})</button>)}
          </div>
          {aircraft.map(({ group, records }) => (
            <div class="aircraft-group">
              <h2>{group.title}</h2>
              <div class="entry-grid record-grid">
                {records.map(({ record, era, data }) => <RecordCard record={record} photo={data.photos[0]} era={era} />)}
              </div>
            </div>
          ))}
          <h2>Quick reference</h2>
          <div class="table-scroll" role="region" aria-label="Aircraft quick reference table, scrolls sideways on narrow screens" tabindex="0">
            <table>
              <thead><tr><th scope="col">Aircraft</th><th scope="col">Role</th><th scope="col">First flight</th><th scope="col">Max speed</th><th scope="col">Ceiling</th></tr></thead>
              {aircraft.map(({ group, records }) => (
                <tbody class="aircraft-group">
                  <tr><th scope="rowgroup" colspan="5">{group.title}</th></tr>
                  {records.map(({ record, era, data }) => (
                    <tr data-era={era}>
                      <th scope="row"><a href={sitePath(recordRoute(record))}>{record.title}</a><br /><span class="entry-kicker">{record.designation}</span></th>
                      <td>{plain(data.role)}</td>
                      <td>{data.quick.firstFlight}</td>
                      <td>{data.quick.maxSpeedKt === null ? "not given" : `${n(data.quick.maxSpeedKt)} kt`}</td>
                      <td>{data.quick.ceilingFt === null ? "not given" : `${n(data.quick.ceilingFt)} ft`}</td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
          <p class="note">Speeds are true airspeed at the altitude given on each record, for the variant named there; each record cites its sources and notes other published figures.</p>
        </>
      ) : category.slug === "ordnance" ? (
        <>
          <p class="lead">Weapons carried by military aircraft of every service. So far it covers air-to-air missiles and aircraft guns from the 1950s to today; guided air-to-ground weapons, from laser-guided bombs and GPS kits to anti-radiation, anti-ship and anti-tank missiles; and unguided weapons: the US Mark 80 general-purpose bombs and their Soviet counterparts, cluster bombs, fire and practice bombs, and air-to-ground rockets from the Second World War on. Each record gives the weapon's weight, warhead or ammunition, guidance or fuzing, and which aircraft carry it, with sources. Published air-to-air missile ranges are best cases, and each air-to-air record says what its figure depends on.</p>
          {ordnance.map(({ group, records }) => (
            <div class="aircraft-group">
              <h2>{group.title}</h2>
              <div class="entry-grid record-grid">
                {records.map(({ record, data }) => <RecordCard record={record} photo={data.photos[0]} />)}
              </div>
            </div>
          ))}
          <h2>How unguided weapons are delivered</h2>
          <DeliveryFigure title="Figure 1 — Delivery profiles (side view)">
            <p class="fig-caption">An unguided bomb follows a ballistic path from the moment it leaves the aircraft, so where and how it is released decides where it lands. <Cited text="[4]" /> In a <strong>level</strong> release the bomb leaves at the aircraft's own speed and carries on forward as it falls, so at low level the bomb and the aircraft arrive over the target together. <Cited text="[1]" /> In a <strong>dive</strong> the aircraft points at the target, which shortens and straightens the bomb's fall and makes aiming over the nose easier; the aircraft must then pull out. <Cited text="[3]" /> In a <strong>loft</strong> or toss the aircraft approaches low, pulls up and releases in the climb, typically between 20° and 75° above the horizon, so the bomb is thrown forward and the aircraft need not overfly the target. <Cited text="[2]" /> A <strong>retarded</strong> bomb opens fins, a parachute or a ballute after release; the drag slows it so that an aircraft bombing from low level is clear of the blast and fragments when the bomb arrives. <Cited text="[1] [4]" /></p>
          </DeliveryFigure>
          <h2>Quick reference</h2>
          <div class="table-scroll" role="region" aria-label="Ordnance quick reference table, scrolls sideways on narrow screens" tabindex="0">
            <table>
              <thead><tr><th scope="col">Weapon</th><th scope="col">Type</th><th scope="col">Weight</th><th scope="col">Entered service</th></tr></thead>
              {ordnance.map(({ group, records }) => (
                <tbody>
                  <tr><th scope="rowgroup" colspan="4">{group.title}</th></tr>
                  {records.map(({ record, data }) => (
                    <tr>
                      <th scope="row"><a href={sitePath(recordRoute(record))}>{record.title}</a><br /><span class="entry-kicker">{record.designation}</span></th>
                      <td>{plain(data.type)}</td>
                      <td>{data.quick.weightKg === null ? "not given" : weight(data.quick.weightKg)}</td>
                      <td>{data.quick.introduced ?? "not given"}</td>
                    </tr>
                  ))}
                </tbody>
              ))}
            </table>
          </div>
          <p class="note">Weights are for the variant named on each record, rounded; a rocket's weight is one complete round, and a gun's is the gun alone unless its record says otherwise. Each record cites its sources and notes other published figures.</p>
          <section class="sources" aria-labelledby="sources-title">
            <h2 id="sources-title">Sources for Figure 1</h2>
            <ol>
              {deliverySources.map((s) => (
                <li id={`source-${s.n}`} value={s.n}><cite>{s.title}</cite>. {s.publisher}. <a href={s.url}>{s.url}</a> (accessed {s.accessed}).{s.note && ` ${s.note}`}</li>
              ))}
            </ol>
          </section>
        </>
      ) : category.slug === "locations" && airfieldData ? (
        <>
          <p class="lead">Theatres, simulator maps and airfields. Browse a region or find an airfield below. An airfield with no map listed has not been checked yet.</p>
          <nav class="theatre-jump" aria-label="Browse locations"><ul><li><a href="#browse-theatres">Theatres</a></li><li><a href="#airfield-index">Find a location</a></li><li><a href="#sim-airfields">Every represented airfield</a></li></ul></nav>
          <section aria-labelledby="browse-theatres">
            <h2 id="browse-theatres">Browse theatres</h2>
            <p>Explore a region, then choose a simulator map for its setting and airfields.</p>
            <div class="entry-grid record-grid">
              {byTitle(airfieldData.theatres).map((x) => (
                <RecordCard record={x.record} photo={x.data.photos[0]}>
                  <p class="card-list"><strong>{x.maps.length} {x.maps.length === 1 ? "map" : "maps"} represented</strong></p>
                  {x.maps.length > 0 && <ul class="card-list">{x.maps.map((m) => <li><a href={sitePath(recordRoute(m.record))}>{m.data.name}</a> <span class="cell-note">{sims[m.data.sim]}</span></li>)}</ul>}
                </RecordCard>
              ))}
            </div>
          </section>
          <h2 id="airfield-index">Find a location</h2>
          <form class="airfield-filter" role="search" aria-label="Find a location" hidden>
            <div class="filter-field filter-search">
              <label for="airfield-q">Location name, former name or identifier</label>
              <input id="airfield-q" name="q" type="search" autocomplete="off" placeholder="e.g. Isely, KLSV or Batumi" />
            </div>
            <div class="filter-field">
              <label for="airfield-country">Country or territory (airfields)</label>
              <select id="airfield-country" name="country">
                <option value="">Any</option>
                {usedNations.map((c) => <option value={c}>{nations[c].name}</option>)}
              </select>
            </div>
            <div class="filter-field">
              <label for="airfield-theatre">Theatre</label>
              <select id="airfield-theatre" name="theatre">
                <option value="">Any</option>
                {byTitle(airfieldData.theatres).map((x) => <option value={x.record.slug}>{x.record.title}</option>)}
              </select>
            </div>
            <div class="filter-field">
              <label for="airfield-map">Sim map</label>
              <select id="airfield-map" name="map">
                <option value="">Any, or none checked</option>
                {airfieldData.maps.map((x) => <option value={x.record.slug}>{mapName(x)}</option>)}
              </select>
            </div>
            <div class="filter-field">
              <label for="airfield-service">Service (airfields)</label>
              <select id="airfield-service" name="service">
                <option value="">Any</option>
                {usedServices.map((b) => <option value={b}>{branches[b]}</option>)}
              </select>
            </div>
            <p class="filter-count" aria-live="polite"></p>
            <p class="filter-empty" hidden>No location matches. Clear a filter or try another name.</p>
          </form>

          <section data-location-group>
          <h2>Airfields</h2>
          <div class="entry-grid record-grid airfield-index">
            {airfieldIndex.map((a) => (
              <RecordCard record={a.record} photo={a.data.photos[0]} filter={{ ...a.filter, airfield: "", location: "", kind: "airfield" }}>
                <dl class="card-facts">
                  <div><dt>Where</dt><dd>{nations[a.data.country].name}</dd></div>
                  {a.aliases.length > 0 && <div><dt>Also</dt><dd>{a.aliases.join(" · ")}</dd></div>}
                  <div><dt>Use</dt><dd>{useLabels[a.use]}</dd></div>
                  <div><dt>Roles</dt><dd>{a.data.roles.length ? a.data.roles.map((r) => airfieldRoles[r]).join(", ") : "None"}</dd></div>
                  <div><dt>Represented in</dt><dd>{a.represented.length ? a.represented.map((x, i) => <>{i > 0 && ", "}<a href={sitePath(recordRoute(x.record))}>{x.data.name}</a></>)
                    : a.maps.some((x) => x.coverage.status === "absent") ? <>No map checked so far; not on {a.maps.filter((x) => x.coverage.status === "absent").map((x, i) => <>{i > 0 && ", "}<a href={sitePath(recordRoute(x.record))}>{x.data.name}</a></>)}</>
                    : "No map checked yet"}</dd></div>
                </dl>
              </RecordCard>
            ))}
          </div>
          </section>
          <section data-location-group>
          <h2 id="sim-airfields">Every represented airfield</h2>
          <p>Every airfield with a runway on each DCS World map, with its runways, tower frequencies, navaids and ILS as the game has them. An airfield on more than one map gets a line for each map. {simIndex.filter((x) => x.record).length} of {simIndex.length} have a full record so far; more are being added theatre by theatre, the major military bases first.</p>
          <div class="table-scroll" role="region" aria-label="Every represented airfield, scrolls sideways on narrow screens" tabindex="0">
            <table class="airfield-table sim-airfield-table">
              <thead><tr><th scope="col">Airfield</th><th scope="col">Map and name in the sim</th><th scope="col">Elevation</th><th scope="col">Runways (magnetic)</th><th scope="col">Tower (MHz)</th><th scope="col">TACAN, VOR and NDB</th><th scope="col">ILS</th></tr></thead>
              <tbody>
                {simIndex.flatMap((x) => x.maps.map((m, i) => (
                  <tr class={i === 0 ? "sim-airfield" : "sim-airfield-more"} data-airfield {...Object.fromEntries(Object.entries(x.filter).map(([k, v]) => [`data-${k}`, v]))}>
                    {i === 0 && <th scope="row" rowspan={x.maps.length}>{x.record ? <a href={sitePath(recordRoute(x.record.record))}>{x.name}</a> : x.name}<span class="cell-note">{x.theatres.map((t) => t.record.title).join(", ")}{!x.record && " · record not written yet"}</span></th>}
                    <td><a href={`${sitePath(recordRoute(m.map.record))}#${mapAirfieldAnchor(m.name)}`}>{m.map.data.name}</a>{m.name !== x.name && <span class="cell-note">as {m.name}</span>}</td>
                    <td>{m.field.elevationFt === undefined ? "—" : `${n(m.field.elevationFt)} ft`}</td>
                    <td>{runwayLines(m.field).map((t) => <span class="cell-line">{t}</span>)}</td>
                    <td>{towerLines(m.field).length ? <>{towerLines(m.field).map((t) => <span class="cell-line">{t}</span>)}{towerNote(m.field) && <span class="cell-note">{towerNote(m.field)}</span>}{m.field.radioSource && <span class="cell-note">from pydcs</span>}</> : "—"}</td>
                    <td>{m.source.beacons ? (navaidLines(m.field).length ? navaidLines(m.field).map((t) => <span class="cell-line">{t}</span>) : "—") : "not in this data"}</td>
                    <td>{m.source.beacons ? (ilsLines(m.field).length ? ilsLines(m.field).map((t) => <span class="cell-line">{t}</span>) : "—") : "not in this data"}</td>
                  </tr>
                )))}
              </tbody>
            </table>
          </div>
          <p class="note">Source: each map's game data, cited on its map page: <a href="https://github.com/YoloWingPixie/dcs-world-schema">dcs-world-schema</a>, extracted by running DCS World, with <a href="https://github.com/pydcs/dcs">pydcs</a> for The Channel and for tower radios the extraction lacks. These are the game's values, not the real airfield's: runway headings are magnetic as the game computes them. The game gives TACAN channels no X or Y band; where a beacon's listed frequency settles it, the band is shown, and * marks an assumed X. A dash means the game gives none. Not for real-world navigation.</p>
          </section>

        </>
      ) : category.slug === "terminology" ? (
        <Glossary />
      ) : (
        <>
          <h2>Records</h2>
          <div class="entry-grid record-grid">
            {records.map(({ record }) => <RecordCard record={record} />)}
          </div>
        </>
      )}
      {withEnvelopes.length > 0 && (
        <>
          <h2>Compare the envelopes</h2>
          <EnvelopeFigure title="Figure 1 — Published engagement limits (side view)" items={withEnvelopes.map(({ record, data }) => ({ slug: record.slug, label: label(record.title), name: record.title, envelope: data.envelope }))}>
            <p class="fig-caption">Each region combines a system's published minimum and maximum range, treated as slant range from the launcher, with its minimum and maximum altitude, using the figures and sources on its record page. Labels are SA numbers. Real launch zones are smaller and change with target speed, aspect and altitude. Dashed edges mark limits the sources do not give; the SA-9's sources give no ceiling, so only its range is drawn. Each scale prints its vertical exaggeration.</p>
          </EnvelopeFigure>
          <h2>Quick reference</h2>
          <div class="table-scroll" role="region" aria-label="Quick reference table, scrolls sideways on narrow screens" tabindex="0">
            <table>
              <thead><tr><th scope="col">System</th><th scope="col">Guidance</th><th scope="col">Max range</th><th scope="col">Ceiling</th><th scope="col">RWR symbol (DCS F-14)</th></tr></thead>
              <tbody>
                {withEnvelopes.map(({ record, data }) => (
                  <tr>
                    <th scope="row"><a href={sitePath(recordRoute(record))}>{record.title}</a><br /><span class="entry-kicker">{record.designation}</span></th>
                    <td>{plain(data.guidance)}</td>
                    <td>{km(data.envelope.maxRangeKm)}</td>
                    <td>{data.envelope.maxAltM === null ? "not given" : km(data.envelope.maxAltM / 1000)}</td>
                    <td>{data.rwr.length ? data.rwr.map((s) => s.symbol).join(", ") : "none"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note">Ranges and ceilings are the variant drawn in Figure 1; each record cites its sources and lists the other published figures.</p>
        </>
      )}
    </div>
  )}
</SiteLayout>

<script>import "../../scripts/era-filter.mjs";</script>
<script>import "../../scripts/airfield-filter.mjs";</script>
