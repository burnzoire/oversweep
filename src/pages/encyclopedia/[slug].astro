---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { encyclopediaCategories } from "../../data/catalogue";
import { sitePath } from "../../lib/paths";

export function getStaticPaths() {
  return encyclopediaCategories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
---

<SiteLayout
  title={category.title}
  activeSection="encyclopedia"
  empty
  breadcrumbs={[
    { label: "Encyclopedia" },
    { label: category.title },
  ]}
>
  <p class="empty-note">No {category.title.toLowerCase()} records are published yet. Start with the <a href={sitePath("manual/")}>Manual</a> instead.</p>
</SiteLayout>
