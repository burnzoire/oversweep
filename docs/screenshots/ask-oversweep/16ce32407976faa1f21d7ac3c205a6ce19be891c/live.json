    {
      "conversation": "comparison",
      "question": "Compare the engines of the F-14 and F-16.",
      "requestedIds": [
        "/encyclopedia/aircraft/mig-15/"
      ],
      "topic": [
        "/encyclopedia/locations/sochi/",
        "/encyclopedia/locations/kutaisi/"
      ],
      "status": 200,
      "revision": "16ce32407976faa1f21d7ac3c205a6ce19be891c",
      "reply": {
        "answer": "The F-14 Tomcat uses two afterburning turbofans, specifically two Pratt & Whitney TF30-P-414A (20,900 lb each) for the F-14A, or two General Electric F110-GE-400 (27,000 lb each) for the F-14B/D. In contrast, the F-16 Fighting Falcon is a single-engine aircraft using either a General Electric F110-GE-129 (29,500 lbf) on the Block 50 or a Pratt & Whitney F100-PW-229 on the Block 52.",
