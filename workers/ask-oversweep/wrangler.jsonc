{
  "name": "ask-oversweep",
  "main": "index.mjs",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/ask-corpus.txt",
        "**/ask-search.txt"
      ],
      "fallthrough": true
    }
  ]
}
