{
  "name": "oversweep",
  "version": "0.1.0",
  "description": "A subject-centric, NATOPS-inspired aviation reference.",
  "scripts": {
    "test": "vitest run",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit && vitest run && npm run build && npm run verify:publication",
    "verify:publication": "node scripts/check_publication.mjs",
    "test:browser": "playwright test"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "astro": "7.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
