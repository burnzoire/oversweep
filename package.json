{
  "name": "oversweep",
  "version": "0.1.0",
  "description": "A subject-centric, NATOPS-inspired aviation reference.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "npm run test:case-iii && astro check && tsc --noEmit && npm run build && node scripts/check_site.mjs && node scripts/check_case_iii_site.mjs",
    "test:case-iii": "node tests/case-iii/model.cjs && node tests/case-iii/sortie.cjs",
    "check:review": "astro build --base /oversweep && node scripts/check_case_iii_site.mjs --review --base=/oversweep"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
